<div>
  <!-- Flash messages -->
  <div class="w-100">
    <% if notice %>
      <h6 class="alert alert-success m-4 text-center"><%= notice %></h6>
    <% end %>
  </div>
  <div class="w-100 d-flex justify-content-center">
    <div class="w-100" style="max-width: 700px;">
      <%= yield %>
    </div>
  </div>
</div>
