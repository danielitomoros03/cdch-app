<%= form_with(model: @announcement) do |form| %>
  <% if @announcement.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(@announcement.errors.count, "error") %> prohibited this announcement from being saved:</h2>

      <ul>
        <% @announcement.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mt-3">
    <%= form.label :content, "Contenido del anuncio" %>
    <%= form.text_area :content, class: "form-control" %>
  </div>

  <div class="form-check form-switch mt-3">
    <%= form.check_box :is_active, class: "form-check-input", type: "checkbox", id: "flexSwitchCheckChecked", style: "transform: scale(1.3);" %>
    <%= form.label :is_active, class: "form-check-label ms-2", for: "flexSwitchCheckChecked" %>
  </div>

  <div class="mt-1">
    <%= form.submit "Guardar anuncio", class: "btn btn-primary my-3" %>
  </div>
<% end %>
