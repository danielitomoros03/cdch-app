<div class="text-center">
  <!-- Flash messages -->
  <div>
    <% if notice %>
      <h6 class="alert alert-success col-md m-5 px-md-0 text-center"><%= notice %></h6>
    <% end %>
  </div>

  <% content_for :title, "CDCH - Anuncios" %>
  <p>
    <h1>Anuncios <%= link_to "Crear anuncio", new_announcement_path, class: "btn btn-primary" %></h1>
  </p>
  <div class="container">
    <div id="announcements">
      <table class="table table-striped table-hover table-bordered">
        <thead>
          <tr>
            <th scope="col">ID</th>
            <th scope="col">Contenido</th>
            <th scope="col">Está activo</th>
            <th scope="col">Acciones</th>
          </tr>
        </thead>
        <% @announcements.each do |announcement| %>
          <%= render announcement %>
        <% end %>
    </div>
  </div>
</div>
