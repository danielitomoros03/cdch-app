<div class="text-center">
  <!-- Flash messages -->
  <div>
    <% if notice %>
      <h6 class="alert alert-success col-md m-5 px-md-0 text-center"><%= notice %></h6>
    <% end %>
  </div>

  <% content_for :title, "Detalle del anuncio" %>
  <p>
    <h1>Anuncios <%= @announcement.id %></h1>
  </p>
  <div class="container">

  <table class="table table-striped table-hover table-bordered">
    <thead>
      <tr>
        <th scope="col">ID</th>
        <th scope="col">Contenido</th>
        <th scope="col">Está activo</th>
        <th scope="col">Acciones</th>
      </tr>
    </thead>
    <tbody>
      <div id="announcements">
        <%= render @announcement %>
      </div>
    </tbody>
  </table>

  <div class="container-fluid">
    <%= link_to "Editar anuncio", edit_announcement_path(@announcement), class: "btn btn-primary m-2" %> 
    <%= link_to "Volver", announcements_path, class: "btn btn-dark m-2" %> 
    <%= button_to "Eliminar anuncio", @announcement, method: :delete, class: "btn btn-danger m-2", form: { data: { turbo_confirm: '¿Estás seguro que deseas eliminar esta acta del directorio?' } } %>
  </div>
</div>
</div>
