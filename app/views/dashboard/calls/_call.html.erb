<div id="<%= dom_id call %>">
  <tbody>
    <tr>
      <th scope="row"> <%= call.id %> </th>
      <td> <%= call.title %> </td>
      <td> <%= call.short_description %> </td>
      <td> <%= call.large_description %> </td>
      <td> <%= call.kind %> </td>
      <td> <%= call.active %> </td>
      <td> <%= call.start_date %> </td>
      <td> <%= call.end_date %> </td>
      <td> 
        <a class="btn btn-info" href="/calls/<%= call.id %>" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Monstar el detalle de la Convocatoria"><i class="fa-solid fa-circle-info"></i></a>
        <a class="btn btn-warning" href="/calls/<%= call.id %>/edit" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Editar Convocatoria"><i class="fa-solid fa-pen"></i></a>
      </td>
    </tr>
  </tbody>
</div>

