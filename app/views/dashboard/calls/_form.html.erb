<%= form_with(model: call) do |form| %>
  <% if call.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(call.errors.count, "error") %> prohibited this call from being saved:</h2>

      <ul>
        <% call.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mt-3">
    <%= form.label :title, style: "display: block" %>
    <%= form.text_field :title, class: "form-control" %>
  </div>

  <div class="mt-3">
    <%= form.label :short_description, style: "display: block" %>
    <%= form.text_field :short_description, class: "form-control" %>
  </div>

  <div class="mt-3">
    <div class="row">
      <div class="col-md-6">
        <%= form.label :start_date, class: "form-label" %>
        <%= form.date_field :start_date, class: "form-control" %>
      </div>
      <div class="col-md-6">
        <%= form.label :end_date, class: "form-label" %>
        <%= form.date_field :end_date, class: "form-control" %>
      </div>
    </div>
  </div>

  <div class="mt-3">
    <%= form.label :kind, style: "display: block" %>
    <%= form.select :kind, options_for_select(Call.kinds.keys.map { |k| [k.humanize, k] }, form.object.kind), { include_blank: "Seleccione un tipo..." }, { class: "form-select" } %>
  </div>

  <div class="field mt-3">
    <%= form.label :large_description %>
    <%= form.rich_text_area :large_description, class: "form-control trix-auto-height" %>
  </div>

  <div class="form-check form-switch mt-3">
    <%= form.check_box :active, class: "form-check-input", type: "checkbox", id: "flexSwitchCheckChecked", style: "transform: scale(1.3);" %>
    <%= form.label :active, class: "form-check-label ms-2", for: "flexSwitchCheckChecked" %>
  </div>

  <div class="pt-3">
    <%= form.submit "Crear convocatoria", class: "btn btn-primary" %>
  </div>
<% end %>
