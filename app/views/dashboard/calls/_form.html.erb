<%= form_with(model: @call, url: dashboard_calls_path, scope: :call) do |form| %>
  <% if call.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(call.errors.count, "error") %> prohibited this call from being saved:</h2>

      <ul>
        <% call.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title, style: "display: block" %>
    <%= form.text_field :title, class: "form-control" %>
  </div>

  <div>
    <%= form.label :short_description, style: "display: block" %>
    <%= form.text_field :short_description, class: "form-control" %>
  </div>

  <div class="mt-3" style: "display: block">
    <%= form.label :start_date %>
    <%= form.date_field :start_date %>
  
    <%= form.label :end_date %>
    <%= form.date_field :end_date %>
  </div>

  <div>
    <%= form.label :type, style: "display: block" %>
    <%= form.select :type, options_for_select(Dashboard::Call.types.keys.map { |k| [k.humanize, k] }, form.object.type), { include_blank: "Seleccione un tipo..." }, { class: "form-select" } %>
  </div>


  <div class="form-check form-switch p-3">
    <%= form.label :active, class: "form-check-label", for:"flexSwitchCheckChecked", style: "display: block" %>
    <%= form.check_box :active, class: "form-check-input", type: "checkbox", id: "flexSwitchCheckChecked" %>
  </div>

  <div class="pt-3">
    <%= form.submit %>
  </div>
<% end %>
