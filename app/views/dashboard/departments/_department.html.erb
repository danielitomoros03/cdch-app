<div id="<%= dom_id department %>">
  <tbody>
    <tr>
      <% if can? :read, department %>
        <th scope="row"> <%= department.id %> </th>
        <td> <%= department.name %> </td>
        <td> <%= department.acronym %> </td>
        <td> <%= department.code.presence || "—" %> </td>
        <td> <%= department.parent&.acronym || "—" %> </td>
        <td> <%= department.public_visible? ? "Sí" : "No" %> </td>
        <td> <%= department.organize %> </td>
        <td> <%= department.description %> </td>
        <td> 
        <% if department.logoDepartment.attached? %>
          <%= image_tag department.logoDepartment, class: "department-logo-small" %>
        <% else %>
          <span class="text-muted">Sin logo</span>
        <% end %>
        </td>
        <td> 
          <%= link_to department_path(department), class: 'btn btn-info', title: 'Mostrar', data: { bs_toggle: 'tooltip' } do %>
            <i class="fa-solid fa-circle-info"></i>
          <% end %>
          <% if can? :update, department %>
            <%= link_to edit_department_path(department), class: 'btn btn-warning', title: 'Editar', data: { bs_toggle: 'tooltip' } do %>
              <i class="fa-solid fa-pen"></i>
            <% end %>
          <% end %>
        </td>
      <% end %>
    </tr>
  </tbody>
</div>
