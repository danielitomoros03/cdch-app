<div id="<%= dom_id department %>">
  <tbody>
    <tr>
      <th scope="row"> <%= department.id %> </th>
      <td> <%= department.name %> </td>
      <td> <%= department.acronym %> </td>
      <td> <%= department.descriptionDepartment %> </td>
      <td> 
        <a class="btn btn-info" href="/departments/<%= department.id %>" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Monstar el detalle de la Convocatoria"><i class="fa-solid fa-circle-info"></i></a>
        <a class="btn btn-warning" href="/departments/<%= department.id %>/edit" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Editar Convocatoria"><i class="fa-solid fa-pen"></i></a>
      </td>
    </tr>
  </tbody>
</div>
