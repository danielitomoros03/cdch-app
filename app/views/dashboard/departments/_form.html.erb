<%= form_with(model: department) do |form| %>
  <% if department.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(department.errors.count, "error") %> prohibited this department from being saved:</h2>

      <ul>
        <% department.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mt-3">
    <%= form.label :acronym, style: "display: block" %>
    <%= form.text_field :acronym, class: "form-control" %>
  </div>
  
  <div class="mt-3">
    <%= form.label :name, "Nombre del Departamento" %>
    <%= form.text_field :name, class: "form-control" %>
  </div>
  
  <div class="mt-3">
    <%= form.label :official_name, "Nombre oficial (clasificador estructural)" %>
    <%= form.text_field :official_name, class: "form-control" %>
  </div>

  <div class="mt-3">
    <%= form.label :code, "Código de unidad ejecutora" %>
    <%= form.text_field :code, class: "form-control", inputmode: "numeric", maxlength: 10, placeholder: "2700000000" %>
    <small class="form-text text-muted">10 dígitos. Vacío si la unidad no está en el clasificador.</small>
  </div>

  <div class="mt-3">
    <%= form.label :parent_id, "Unidad superior" %>
    <%= form.collection_select :parent_id, Department.where.not(id: department.id).order(:organize), :id, :name, { include_blank: "Ninguna" }, class: "form-control" %>
  </div>

  <div class="mt-3 form-check">
    <%= form.check_box :public_visible, class: "form-check-input" %>
    <%= form.label :public_visible, "Visible en el sitio público", class: "form-check-label" %>
  </div>

  <div class="mt-3">
    <%= form.label :organize, "Número de Orden del Departamento" %>
    <%= form.number_field :organize, min: 0, class: "form-control" %>
    <small class="form-text text-muted">Define el orden en el sitio público y en el panel</small>
  </div>

  <div class="mt-3">
    <%= form.label :logoDepartment, "Logo del Departamento" %>
    <%= form.file_field :logoDepartment, class: "form-control", accept: "image/*" %>
    <small class="form-text text-muted">Formatos permitidos: JPG o PNG. Tamaño recomendado: 300x300px</small>
  </div>


  <div class="field mt-3">
    <%= form.label :description, "Descripción del Departamento" %>
    <%= form.rich_text_area :description, class: "form-control trix-auto-height" %>
  </div>

  <div>
    <%= form.submit "Guardar Departamento", class: "btn btn-primary mt-3" %>
  </div>
<% end %>
