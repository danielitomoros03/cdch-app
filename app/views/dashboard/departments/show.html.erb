<div class="text-center">
  <!-- Flash messages -->
  <div>
    <% if notice %>
      <h6 class="alert alert-success col-md m-5 px-md-0 text-center"><%= notice %></h6>
    <% end %>
  </div>

  <% content_for :title, "#{@department.acronym}" %>
  <p>
    <h1>Departamento <%= @department.id %></h1>
  </p>
  <div class="container">

  <table class="table table-striped table-hover table-bordered">
    <thead>
      <tr>
        <th scope="col">ID</th>
        <th scope="col">Nombre</th>
        <th scope="col">Acrónimo</th>
        <th scope="col">Código</th>
        <th scope="col">Unidad superior</th>
        <th scope="col">Pública</th>
        <th scope="col">N° de Orden</th>
        <th scope="col">Descripción</th>
        <th scope="col">Logo</th>
        <th scope="col">Acciones</th>
      </tr>
    </thead>
    <tbody>
      <div id="departments">
        <%= render @department %>
      </div>
    </tbody>
  </table>

  <div class="container-fluid">
    <%= link_to "Editar", edit_department_path(@department), class: "btn btn-primary" %>
    <%= link_to "Volver", departments_path, class: "btn btn-dark" %> 
  </div>
</div>
</div>
