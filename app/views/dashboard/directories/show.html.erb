<%= render "/layouts/navbar" %>
<div class="container-fluid">
  <div class="row">
    <!-- Sidebar para pantallas grandes -->
    <div class="col-lg-2 d-none d-lg-block">
      <%= render "/layouts/sidebar" %>
    </div>

    <!-- Contenido principal -->
    <div class="col-md mt-3 ms-auto col-lg-10 px-md-0 text-center">
      <!-- Flash messages -->
      <div>
        <% if notice %>
          <h6 class="alert alert-success col-md m-5 px-md-0 text-center"><%= notice %></h6>
        <% end %>
      </div>

      <% content_for :title, "Showing Directory" %>
      <p>
        <h1>Directorio <%= @directory.id %></h1>
      </p>
      <div class="container">

      <table class="table table-striped table-hover table-bordered">
        <thead>
          <tr>
            <th scope="col">ID</th>
            <th scope="col">Day</th>
            <th scope="col">Title</th>
          </tr>
        </thead>
        <tbody>
          <div id="directories">
            <%= render @directory %>
          </div>
        </tbody>
      </table>

      <div class="container-fluid">
        <%= link_to "Edit this directory", edit_directory_path(@directory), class: "btn btn-primary" %> |
        <%= link_to "Back to directories", directories_path, class: "btn btn-dark" %> |
        <%= button_to "Eliminar convocatoria", @directory, method: :delete, class: "btn btn-danger", form: { data: { turbo_confirm: '¿Estás seguro que deseas eliminar este directorio?' } } %>
      </div>
    </div>
  </div>
</div>


<!-- Offcanvas Sidebar para pantallas pequeñas -->
<div class="offcanvas offcanvas-start bg-light" tabindex="-1" id="offcanvasSidebar" aria-labelledby="offcanvasSidebarLabel">
  <div class="offcanvas-header bg-dark text-white">
    <h5 class="offcanvas-title" id="offcanvasSidebarLabel"><strong>UCV - La casa que vence la sombra</strong></h5>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Close"></button>
  </div>
  <div class="offcanvas-body">
    <%= render "/layouts/sidebar" %>
  </div>
</div>
