<%= form_with(model: event) do |form| %>
  <% if event.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(event.errors.count, "error") %> prohibited this event from being saved:</h2>

      <ul>
        <% event.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mt-3">
    <%= form.label :title, style: "display: block" %>
    <%= form.text_field :title, class: "form-control" %>
  </div>

  <div class="form-check form-switch mt-3">
    <%= form.check_box :show_in, class: "form-check-input", type: "checkbox", id: "flexSwitchCheckChecked", style: "transform: scale(1.3);" %>
    <%= form.label :show_in, class: "form-check-label ms-2", for: "flexSwitchCheckChecked" %>
  </div>

  <div class="form-check form-switch mt-3">
    <%= form.check_box :active, class: "form-check-input", type: "checkbox", id: "flexSwitchCheckChecked", style: "transform: scale(1.3);" %>
    <%= form.label :active, class: "form-check-label ms-2", for: "flexSwitchCheckChecked" %>
  </div>

  <div class="mt-3">
    <%= form.label :description, style: "display: block" %>
    <%= form.text_field :description, class: "form-control" %>
  </div>

  <div class="mt-3">
    <%= form.label :kind, style: "display: block" %>
    <%= form.select :kind, options_for_select(Event.kinds.keys.map { |k| [k.humanize, k] }, form.object.kind), { include_blank: "Seleccione un tipo..." }, { class: "form-select" } %>
  </div>

  <div class="mt-3">
    <%= form.label :day, style: "display: block" %>
    <%= form.date_field :day, class: "form-control" %>
  </div>

  <div class="mt-3">
    <%= form.label :start_time, style: "display: block" %>
    <%= form.time_field :start_time, class: "form-control" %>
  </div>

  <div class="mt-3">
    <%= form.label :end_time, style: "display: block" %>
    <%= form.time_field :end_time, class: "form-control" %>
  </div>

  <div class="mt-3">
    <%= form.label :location, style: "display: block" %>
    <%= form.text_field :location, class: "form-control" %>
  </div>

  <div class="field mt-3">
    <%= form.label :content, style: "display: block" %>
    <%= form.rich_text_area :content, class: "form-control trix-auto-height" %>
  </div>

  <div class="field mt-3">
    <%= form.label :image, style: "display: block" %>
    <%= form.file_field :image, class: "form-control" %>
  </div>

  <div class="mt-3">
    <%= form.submit "Guardar Evento", class: "btn btn-primary" %>
  </div>
<% end %>
