<div class="text-center">
  <!-- Flash messages -->
  <div>
    <% if notice %>
      <h6 class="alert alert-success col-md m-5 px-md-0 text-center"><%= notice %></h6>
    <% end %>
  </div>

  <% content_for :title, "CDCH - Eventos" %>
  <p>
    <h1>Eventos y Noticias <%= link_to "Crear un Evento/Noticia", new_event_path, class: "btn btn-primary" %></h1>
  </p>
  <div class="container">
    <div id="events">
      <table class="table table-striped table-hover table-bordered">
        <thead>
          <tr>
            <th scope="col">N°</th>
            <th scope="col">Título</th>
            <th scope="col">Descripción</th>
            <th scope="col">Contenido</th>
            <th scope="col">Tipo</th>
            <th scope="col">Activo</th>
            <th scope="col">En Cabecera</th>
            <th scope="col">Inicio</th>
            <th scope="col">Final</th>
            <th scope="col">Fecha</th>
            <th scope="col">Ubicación</th>
            <th scope="col">Imagen</th>
            <th scope="col">Acciones</th>
          </tr>
        </thead>
        <tbody>
          <% @events.each do |event| %>
            <%= render event %>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
