<div class="text-center">
  <!-- Flash messages -->
  <div>
    <% if notice %>
      <h6 class="alert alert-success col-md m-5 px-md-0 text-center"><%= notice %></h6>
    <% end %>
  </div>

  <% content_for :title, "Evento/Noticia #{@event.id}" %>
  <p>
    <h1>Evento/Noticia <%= @event.id %></h1>
  </p>
  <div class="container">

  <table class="table table-striped table-hover table-bordered">
    <thead>
      <tr>
        <th scope="col">N°</th>
        <th scope="col">Título</th>
        <th scope="col">Descripción</th>
        <th scope="col">Contenido</th>
        <th scope="col">Tipo</th>
        <th scope="col">Activo</th>
        <th scope="col">Importante</th>
        <th scope="col">Inicio</th>
        <th scope="col">Final</th>
        <th scope="col">Fecha</th>
        <th scope="col">Ubicación</th>
        <th scope="col">Imagen</th>
        <th scope="col">Acciones</th>
      </tr>
    </thead>
    <tbody>
      <%= render @event %>
    </tbody>
  </table>

  <div class="d-flex justify-content-center my-4">
    <%= link_to "Editar", edit_event_path(@event), class: "btn btn-primary m-2" %>
    <%= link_to "Regresar", events_path, class: "btn btn-dark m-2" %>
    <%= button_to "Eliminar evento", @event, method: :delete, class: "btn btn-danger m-2", form: { data: { turbo_confirm: '¿Estás seguro que deseas eliminar este evento?' } } %>
  </div>
</div>
</div>
