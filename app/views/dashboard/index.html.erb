<%= render "/layouts/navbar" %>
<div class="container-fluid">
  <div class="row">
    <!-- Sidebar para pantallas grandes -->
    <div class="col-lg-2 d-none d-lg-block">
      <%= render "/layouts/sidebar" %>
    </div>

    <!-- Contenido principal -->
    <div class="col-md ms-auto col-lg-10 px-md-0 text-center">
      <!-- Flash messages -->
      <div>
        <% if notice %>
          <h6 class="alert alert-success col-md m-5 px-md-0 text-center"><%= notice %></h6>
        <% end %>
      </div>
      <h2>Bienvenido, Usuario</h2>
      <br>
      <h4>¿Qué desea hacer hoy?</h4>

      <h1>
        <div class="container">
          <div class="text-capitalize fs-6 fst-normal">
            <h3>Links</h3>
          </div>
        </div>
      </h1>
    </div>
  </div>
</div>

<!-- Offcanvas Sidebar para pantallas pequeñas -->
<div class="offcanvas offcanvas-start bg-light" tabindex="-1" id="offcanvasSidebar" aria-labelledby="offcanvasSidebarLabel">
  <div class="offcanvas-header">
    <h5 class="offcanvas-title" id="offcanvasSidebarLabel">Menú</h5>
    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
  </div>
  <div class="offcanvas-body">
    <%= render "/layouts/sidebar" %>
  </div>
</div>


