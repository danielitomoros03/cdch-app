<% content_for :title, "Editar Autoridad" %>

<%= render layout: "dashboard/dashboard_form" do %>
  <h1>Editar Autoridad</h1>
  <%= render "form", institution_leadership: @institution_leadership %>
  <div class="mt-3">
    <%= link_to "Ver", institution_leadership_path(@institution_leadership), class: "btn btn-info" %>
    <%= link_to "Volver", institution_leaderships_path, class: "btn btn-secondary" %>
  </div>
<% end %>
