<div class="text-center">
  <div>
    <% if notice %>
      <h6 class="alert alert-success col-md m-5 px-md-0 text-center"><%= notice %></h6>
    <% end %>
  </div>

  <% content_for :title, "Autoridades del CDCH" %>
  <% if can? :create, InstitutionLeadership %>
    <h1>
      Autoridades
      <%= link_to "Crear Autoridad", new_institution_leadership_path, class: "btn btn-primary" %>
    </h1>
  <% else %>
    <h1>Autoridades</h1>
  <% end %>

  <div class="container">
    <div id="institution_leaderships">
      <table class="table table-striped table-hover table-bordered">
        <thead>
          <tr>
            <th scope="col">ID</th>
            <th scope="col">Cargo</th>
            <th scope="col">Nombre</th>
            <th scope="col">Institución</th>
            <th scope="col">Período</th>
            <th scope="col">Estado</th>
            <th scope="col">Acciones</th>
          </tr>
        </thead>
        <% @institution_leaderships.each do |institution_leadership| %>
          <%= render institution_leadership %>
        <% end %>
      </table>
    </div>
  </div>
</div>
