<div class="text-center">
  <div>
    <% if notice %>
      <h6 class="alert alert-success col-md m-5 px-md-0 text-center"><%= notice %></h6>
    <% end %>
  </div>

  <% content_for :title, "Autoridad #{@institution_leadership.id}" %>
  <h1>Autoridad <%= @institution_leadership.id %></h1>

  <div class="container">
    <table class="table table-striped table-hover table-bordered">
      <thead>
        <tr>
          <th scope="col">ID</th>
          <th scope="col">Cargo</th>
          <th scope="col">Nombre</th>
          <th scope="col">Institución</th>
          <th scope="col">Período</th>
          <th scope="col">Estado</th>
          <th scope="col">Acciones</th>
        </tr>
      </thead>
      <%= render @institution_leadership %>
    </table>

    <div class="row justify-content-center mt-4">
      <% if @institution_leadership.photo.attached? %>
        <div class="col-md-4 mb-3">
          <%= image_tag @institution_leadership.photo, class: "img-fluid rounded shadow-sm", alt: @institution_leadership.full_name %>
        </div>
      <% end %>

      <% if @institution_leadership.bio.body.present? %>
        <div class="col-md-8 text-start">
          <div class="card">
            <div class="card-header">
              <h5 class="mb-0">Reseña</h5>
            </div>
            <div class="card-body">
              <%= @institution_leadership.bio %>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <div class="container-fluid mt-4">
      <% if can? :edit, @institution_leadership %>
        <%= link_to "Editar", edit_institution_leadership_path(@institution_leadership), class: "btn btn-primary m-2" %>
      <% end %>
      <% if can? :read, InstitutionLeadership %>
        <%= link_to "Ver Autoridades", institution_leaderships_path, class: "btn btn-dark m-2" %>
      <% end %>
      <% if can? :destroy, @institution_leadership %>
        <%= button_to "Eliminar", @institution_leadership, method: :delete, class: "btn btn-danger m-2", form: { data: { turbo_confirm: '¿Estás seguro que deseas eliminar este registro?' } } %>
      <% end %>
    </div>
  </div>
</div>
