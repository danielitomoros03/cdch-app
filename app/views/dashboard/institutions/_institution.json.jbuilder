json.extract! institution, :id, :address, :name, :primary_phone, :secondary_phone, :primary_email, :secondary_email, :business_hours, :mission, :vission, :twitter_url, :facebook_url, :instagram_url, :threads_url, :acronym, :description, :linkedin_url, :director_name, :director_email, :founded_year, :created_at, :updated_at
json.url institution_url(institution, format: :json)
