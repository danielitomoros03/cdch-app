<% content_for :title, "Editar Información Institucional" %>
<%= render layout: "dashboard/dashboard_form" do %>
  <h1>Editar Información Institucional</h1>
  <%= render "form", institution: @institution %>
  <div class="mt-3">
    <%= link_to 'Ver', dashboard_institution_path(@institution), class: "btn btn-info" %>
    <%= link_to 'Volver', dashboard_institutions_path, class: "btn btn-secondary" %>
  </div>
<% end %>
