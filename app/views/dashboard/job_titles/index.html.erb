<div class="text-center">
  <div>
    <% if notice %>
      <h6 class="alert alert-success col-md m-5 px-md-0 text-center"><%= notice %></h6>
    <% end %>
  </div>

  <% content_for :title, "Cargos" %>
  <p>
    <h1>Cargos <%= link_to "Crear Cargo", new_job_title_path, class: "btn btn-primary" %></h1>
  </p>
  <div class="container">
    <div id="users">
      <table class="table table-striped table-hover table-bordered">
        <thead>
          <tr>
            <th scope="col">ID</th>
            <th scope="col">Nombre</th>
            <th scope="col">Rol</th>
            <th scope="col">Acciones</th>
          </tr>
        </thead>
        <% @job_titles.each do |job_title| %>
          <%= render job_title %>
        <% end %>
    </div>
  </div>
</div>
