<div class="text-center">
  <div>
    <% if notice %>
      <h6 class="alert alert-success col-md m-5 px-md-0 text-center"><%= notice %></h6>
    <% end %>
  </div>

  <% content_for :title, "Cargo #{@job_title.name}" %>
  <p>
    <h1>Cargo <%= @job_title.name %></h1>
  </p>
  <div class="container">

  <table class="table table-striped table-hover table-bordered">
    <thead>
      <tr>
        <th scope="col">ID</th>
        <th scope="col">Name</th>
        <th scope="col">Rol</th>
      </tr>
    </thead>
    <tbody>
      <div id="job_titles">
        <%= render @job_title %>
      </div>
    </tbody>
  </table>

  <div class="container-fluid">
    <%= link_to "Edit this job title", edit_job_title_path(@job_title), class: "btn btn-primary" %> |
    <%= link_to "Back to job titles", job_titles_path, class: "btn btn-dark" %> |
    <%= button_to "Eliminar cargo", @job_title, method: :delete, class: "btn btn-danger", form: { data: { turbo_confirm: '¿Estás seguro que deseas eliminar este cargo?' } } %>
  </div>
</div>
</div>
