<div class="container-fluid">
  <div class="row">
    <%= render "/layouts/header" %> <!-- Header -->
    <%= render "/layouts/sidebar" %> <!-- Sidebar para pantallas grandes -->
    <!-- Contenido principal -->
    <div class="col-md mt-3 ms-auto col-lg-10 px-md-0 text-center">
      <!-- Flash messages -->
      <div>
        <% if notice %>
          <h6 class="alert alert-success col-md m-5 px-md-0 text-center"><%= notice %></h6>
        <% end %>
      </div>

      <% content_for :title, "CDCH - Actas" %>
      <p>
        <h1>Actas del Directorio <%= link_to "Crear Acta", new_minute_path, class: "btn btn-primary ps-2" %></h1>
      </p>
      <div class="container">
        <div id="minutes">
          <table class="table table-striped table-hover table-bordered">
            <thead>
              <tr>
                <th scope="col">ID</th>
                <th scope="col">Título</th>
                <th scope="col">Day</th>
                <th scope="col">Contenido</th>
                <th scope="col">Archivo adjunto</th>
                <th scope="col">Acciones</th>
              </tr>
            </thead>
            <% @minutes.each do |minute| %>
              <%= render minute %>
            <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- mobile offcanvas provided by navbar -->
