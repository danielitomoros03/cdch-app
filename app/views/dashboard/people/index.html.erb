<% content_for :title, "CDCH - Docentes e investigadores" %>
<% turbo_exempts_page_from_cache # al volver atrás, los filtros y la página de resultados se piden de nuevo %>

<div class="dashboard-page-header">
  <div>
    <h1 class="dashboard-page-header__title">Docentes e investigadores</h1>
    <p class="dashboard-page-header__subtitle">Uso interno: nómina docente UCV 2026 y sistema de proyectos del CDCH (1985–2019).</p>
  </div>
</div>

<%= form_with url: people_path, method: :get, class: "filter-bar",
      data: { controller: "auto-submit", turbo_frame: "people_results", turbo_action: "advance" } do |f| %>
  <div class="filter-bar__field filter-bar__field--switch">
    <span class="form-label d-block" id="history-label">Historia en el CDCH</span>
    <div class="form-check form-switch filter-switch">
      <%= f.check_box :history, { checked: @filters[:history] == "1", class: "form-check-input", role: "switch",
            aria: { describedby: "history-label" }, data: { action: "auto-submit#submit" } }, "1", nil %>
      <%= f.label :history, "Solo con historia", class: "form-check-label" %>
    </div>
  </div>
  <div class="filter-bar__field filter-bar__field--wide">
    <%= f.label :q, "Nombre o cédula", class: "form-label" %>
    <div class="input-group input-group-sm">
      <span class="input-group-text"><i class="fas fa-search" aria-hidden="true"></i></span>
      <%= f.search_field :q, value: @filters[:q], class: "form-control", autocomplete: "off", placeholder: "Ej.: Pérez",
            data: { action: "input->auto-submit#debounced" } %>
    </div>
  </div>
  <div class="filter-bar__field">
    <%= f.label :situation, "Situación", class: "form-label" %>
    <%= f.select :situation, Person::SITUATIONS.invert, { include_blank: "Todas", selected: @filters[:situation] },
          class: "form-select form-select-sm", data: { action: "auto-submit#submit" } %>
  </div>
  <div class="filter-bar__field filter-bar__field--wide">
    <%= f.label :faculty, "Facultad o dependencia", class: "form-label" %>
    <%= f.select :faculty, @faculties.map { |faculty| [ faculty.name, faculty.code ] }, { include_blank: "Todas", selected: @filters[:faculty] },
          class: "form-select form-select-sm", data: { action: "auto-submit#submit" } %>
  </div>
  <div class="filter-bar__field filter-bar__field--narrow">
    <%= f.label :since, "Proyecto desde", class: "form-label" %>
    <%= f.number_field :since, value: @filters[:since], min: 1985, max: Date.current.year, placeholder: "Año",
          class: "form-control form-control-sm", data: { action: "input->auto-submit#debounced" } %>
  </div>
  <div class="filter-bar__actions">
    <noscript><%= f.submit "Filtrar", name: nil, class: "btn btn-primary btn-sm" %></noscript>
    <%= link_to "Limpiar", people_path, class: "btn btn-outline-secondary btn-sm" %>
    <%# Envía el mismo formulario a la versión .xlsx: siempre exporta los filtros que se ven. %>
    <%= f.button type: "submit", name: nil, formaction: people_path(format: :xlsx), class: "btn btn-outline-success btn-sm",
          data: { turbo: false }, title: "Descarga el listado con los filtros aplicados" do %>
      <i class="fas fa-file-excel me-1" aria-hidden="true"></i> Exportar a Excel
    <% end %>
  </div>
<% end %>

<%= turbo_frame_tag "people_results", class: "results-frame", data: { turbo_action: "advance", controller: "frame-history" } do %>
  <p class="results-count"><%= number_with_delimiter(@total, delimiter: ".") %> personas</p>

  <div class="table-responsive data-table">
    <table class="table table-hover table-sm align-middle mb-0">
      <thead>
        <tr>
          <th scope="col">Nombre</th>
          <th scope="col">Cédula</th>
          <th scope="col">Situación</th>
          <th scope="col">Facultad o dependencia</th>
          <th scope="col">Categoría</th>
          <th scope="col" class="text-end" title="Etapas como responsable">Resp.</th>
          <th scope="col" class="text-end" title="Etapas como coinvestigador">Coinv.</th>
        </tr>
      </thead>
      <tbody>
        <% @people.each do |person| %>
          <% appointment = @appointments[person.id]&.max_by { |a| a.hired_on || Date.new(1900) } %>
          <tr>
            <td><%= link_to person.display_name, person_path(person), data: { turbo_frame: "_top" } %></td>
            <td class="text-nowrap"><%= person.id_number %></td>
            <td><%= situation_badge(person) %></td>
            <td><%= faculty_label(appointment&.dependency_code || person.legacy_faculty_code, @faculty_names) %></td>
            <td><%= appointment&.category || person.legacy_category || "—" %></td>
            <td class="text-end"><%= @stage_counts[person.id] || 0 %></td>
            <td class="text-end"><%= @co_counts[person.id] || 0 %></td>
          </tr>
        <% end %>
        <% if @people.empty? %>
          <tr><td colspan="7" class="text-center text-muted py-4">No hay personas con esos filtros.</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="d-flex justify-content-center mt-3">
    <%= dashboard_pagination @people %>
  </div>
<% end %>
