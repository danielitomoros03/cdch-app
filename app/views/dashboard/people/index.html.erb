<div class="container-fluid">
  <div class="row">
    <%= render "/layouts/header" %> <!-- Header -->
    <%= render "/layouts/sidebar" %> <!-- Sidebar para pantallas grandes -->

    <!-- Contenido principal -->
    <div class="col-md mt-3 ms-auto col-lg-10 px-md-3">
      <% content_for :title, "CDCH - Docentes e investigadores" %>
      <h1 class="text-center">Docentes e investigadores</h1>
      <p class="text-center text-muted small">Uso interno: nómina docente UCV 2026 y sistema de proyectos del CDCH (1985–2019).</p>

      <%= form_with url: people_path, method: :get, class: "row g-2 align-items-end mb-3", data: { turbo_frame: "_top" } do |f| %>
        <div class="col-md-2">
          <%= f.label :q, "Nombre o cédula", class: "form-label small mb-0" %>
          <%= f.search_field :q, value: @filters[:q], class: "form-control form-control-sm" %>
        </div>
        <div class="col-md-2">
          <%= f.label :situation, "Situación", class: "form-label small mb-0" %>
          <%= f.select :situation, Person::SITUATIONS.invert, { include_blank: "Todas", selected: @filters[:situation] }, class: "form-select form-select-sm" %>
        </div>
        <div class="col-md-3">
          <%= f.label :faculty, "Facultad o dependencia", class: "form-label small mb-0" %>
          <%= f.select :faculty, @faculties.map { |faculty| [ faculty.name, faculty.code ] }, { include_blank: "Todas", selected: @filters[:faculty] }, class: "form-select form-select-sm" %>
        </div>
        <div class="col-md-1">
          <%= f.label :since, "Proyecto desde", class: "form-label small mb-0" %>
          <%= f.number_field :since, value: @filters[:since], min: 1985, max: Date.current.year, placeholder: "Año", class: "form-control form-control-sm" %>
        </div>
        <div class="col-md-2">
          <div class="form-check">
            <%= f.check_box :history, { checked: @filters[:history] == "1", class: "form-check-input" }, "1", nil %>
            <%= f.label :history, "Con historia en el CDCH", class: "form-check-label small" %>
          </div>
        </div>
        <div class="col-md-2 d-flex gap-1">
          <%= f.submit "Filtrar", name: nil, class: "btn btn-primary btn-sm" %>
          <%= link_to "Limpiar", people_path, class: "btn btn-outline-secondary btn-sm" %>
        </div>
      <% end %>

      <p class="fw-bold"><%= number_with_delimiter(@total, delimiter: ".") %> personas</p>

      <div class="table-responsive">
        <table class="table table-striped table-hover table-bordered table-sm align-middle">
          <thead>
            <tr>
              <th scope="col">Nombre</th>
              <th scope="col">Cédula</th>
              <th scope="col">Situación</th>
              <th scope="col">Facultad o dependencia</th>
              <th scope="col">Categoría</th>
              <th scope="col" title="Etapas como responsable">Resp.</th>
              <th scope="col" title="Etapas como coinvestigador">Coinv.</th>
            </tr>
          </thead>
          <tbody>
            <% @people.each do |person| %>
              <% appointment = @appointments[person.id]&.max_by { |a| a.hired_on || Date.new(1900) } %>
              <tr>
                <td><%= link_to person.full_name, person_path(person) %></td>
                <td><%= person.id_number %></td>
                <td><%= situation_badge(person) %></td>
                <td><%= faculty_label(appointment&.dependency_code || person.legacy_faculty_code, @faculty_names) %></td>
                <td><%= appointment&.category || person.legacy_category || "—" %></td>
                <td class="text-end"><%= @stage_counts[person.id] || 0 %></td>
                <td class="text-end"><%= @co_counts[person.id] || 0 %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="d-flex justify-content-center">
        <%= will_paginate @people, renderer: BootstrapPagination::Rails, previous_label: "Anterior", next_label: "Siguiente" %>
      </div>
    </div>
  </div>
</div>

<%= render "offcanvas" %>
