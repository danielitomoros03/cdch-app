<% content_for :title, "CDCH - #{@person.display_name}" %>

<div class="dashboard-page-header">
  <div>
    <h1 class="dashboard-page-header__title"><%= @person.display_name %></h1>
    <p class="dashboard-page-header__subtitle">
      C.I. <%= [ @person.nationality, @person.id_number ].compact.join("-") %> ·
      <%= situation_badge(@person) %> ·
      <%= faculty_label(@person.faculty_code, @faculty_names) %>
    </p>
  </div>
  <%= link_to people_path, class: "btn btn-outline-secondary btn-sm" do %>
    <i class="fas fa-arrow-left me-1" aria-hidden="true"></i> Volver al listado
  <% end %>
</div>

<div class="stat-tiles">
  <% tiles = [ [ "Etapas como responsable", @led_stages.size ], [ "Etapas como coinvestigador", @co_stages.size ], [ "Ayudas institucionales", @aids.size ], [ "Becas", @scholarships.size ] ] %>
  <% tiles << [ "Arbitrajes", @reviews.size ] if @reviews %>
  <% tiles.each do |label, value| %>
    <div class="stat-tile">
      <div class="stat-tile__label"><%= label %></div>
      <div class="stat-tile__value"><%= value %></div>
    </div>
  <% end %>
</div>

<section class="panel">
  <h2 class="panel__title">Cargos en la UCV</h2>
  <% if @appointments.any? %>
    <div class="table-responsive data-table">
      <table class="table table-sm align-middle mb-0">
        <thead><tr><th>Nómina</th><th>Dependencia</th><th>Unidad ejecutora</th><th>Categoría</th><th>Dedicación</th><th>Ingreso</th><th>Jubilación</th></tr></thead>
        <tbody>
          <% @appointments.each do |appointment| %>
            <tr>
              <td><%= appointment.payroll_type %></td>
              <td><%= appointment.dependency %></td>
              <td><%= appointment.ucv_unit_name || appointment.ucv_unit_code || "—" %></td>
              <td><%= appointment.category %></td>
              <td><%= appointment.dedication %></td>
              <td class="text-nowrap"><%= legacy_date(appointment.hired_on) %></td>
              <td class="text-nowrap"><%= legacy_date(appointment.retired_on) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="panel__empty">No aparece en la nómina docente 2026.
      <% if @person.legacy_category || @person.legacy_condition %>
        Sistema heredado: <%= [ @person.legacy_condition, @person.legacy_category, @person.legacy_dedication ].compact.join(" · ") %>.
      <% end %>
    </p>
  <% end %>

  <% if @contacts.any? || @ppi_levels.any? || @person.orcid.present? || @person.research_lines.present? %>
    <div class="row g-4 mt-1">
      <% if @contacts.any? || @person.orcid.present? || @person.research_lines.present? %>
        <div class="col-md-8">
          <h3 class="panel__subtitle">Contacto <span class="fw-normal">· los del sistema heredado pueden estar desactualizados</span></h3>
          <dl class="detail-list">
            <% @contacts.each do |contact| %>
              <dt><%= { "email" => "Correo", "phone" => "Teléfono", "address" => "Dirección" }[contact.kind] %></dt>
              <dd>
                <%= contact.value %>
                <% if contact.source == PersonContact::TEACHER_SOURCE %>
                  <span class="badge text-bg-success ms-1" title="Lo escribió el docente en Mi espacio">del docente</span>
                <% end %>
              </dd>
            <% end %>
            <% if @person.orcid.present? %>
              <dt>ORCID</dt><dd><%= link_to @person.orcid, "https://orcid.org/#{@person.orcid}", target: "_blank", rel: "noopener" %></dd>
            <% end %>
            <% if @person.research_lines.present? %>
              <dt>Líneas de investigación</dt><dd><%= multiline(@person.research_lines) %></dd>
            <% end %>
          </dl>
        </div>
      <% end %>
      <% if @ppi_levels.any? %>
        <div class="col-md-4">
          <h3 class="panel__subtitle">PPI (2005)</h3>
          <ul class="list-unstyled small mb-0">
            <% @ppi_levels.each do |ppi| %>
              <li><%= ppi.level %><%= " · #{ppi.committee}" if ppi.committee.present? %></li>
            <% end %>
          </ul>
        </div>
      <% end %>
    </div>
  <% end %>
</section>

<section class="panel">
  <ul class="nav nav-underline panel__tabs" role="tablist">
    <% tabs = [ [ "led", "Proyectos como responsable", @led_stages.size ], [ "co", "Como coinvestigador", @co_stages.size ], [ "aids", "Ayudas institucionales", @aids.size ], [ "scholarships", "Becas", @scholarships.size ] ] %>
    <% tabs << [ "reviews", "Arbitrajes", @reviews.size ] if @reviews %>
    <% tabs.each_with_index do |(key, label, count), index| %>
      <li class="nav-item" role="presentation">
        <button class="nav-link <%= "active" if index.zero? %>" id="tab-<%= key %>" data-bs-toggle="tab" data-bs-target="#pane-<%= key %>"
                type="button" role="tab" aria-controls="pane-<%= key %>" aria-selected="<%= index.zero? %>">
          <%= label %> <span class="badge rounded-pill text-bg-light"><%= count %></span>
        </button>
      </li>
    <% end %>
  </ul>

  <div class="tab-content">
    <div class="tab-pane fade show active" id="pane-led" role="tabpanel" aria-labelledby="tab-led" tabindex="0">
      <%= render "stages", stages: @led_stages, empty: "Sin etapas como responsable." %>
    </div>

    <div class="tab-pane fade" id="pane-co" role="tabpanel" aria-labelledby="tab-co" tabindex="0">
      <% if @co_stages.any? %>
        <div class="table-responsive data-table">
          <table class="table table-sm align-middle mb-0">
            <thead><tr><th>Código</th><th>Etapa</th><th>Título</th><th>Responsable</th><th>Solicitud</th></tr></thead>
            <tbody>
              <% @co_stages.each do |co| %>
                <% stage = co.project_stage %>
                <tr>
                  <td class="text-nowrap"><%= stage ? link_to(stage.research_project.code, research_project_path(stage.research_project)) : co.project_code %></td>
                  <td><%= co.stage_number %></td>
                  <td><%= stage&.title || "(etapa no encontrada en el sistema heredado)" %></td>
                  <td><%= stage&.lead_person ? link_to(stage.lead_person.display_name, person_path(stage.lead_person)) : "—" %></td>
                  <td class="text-nowrap"><%= legacy_date(stage&.requested_on) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="panel__empty">Sin participaciones como coinvestigador.</p>
      <% end %>
    </div>

    <div class="tab-pane fade" id="pane-aids" role="tabpanel" aria-labelledby="tab-aids" tabindex="0">
      <% if @aids.any? %>
        <div class="table-responsive data-table">
          <table class="table table-sm align-middle mb-0">
            <thead><tr><th>Código</th><th>Tipo</th><th>Descripción</th><th>Estado</th><th>Solicitud</th><th class="text-end">Aprobado</th></tr></thead>
            <tbody>
              <% @aids.each do |aid| %>
                <tr>
                  <td class="text-nowrap"><%= aid.code %></td>
                  <td><%= aid.aid_type_code %></td>
                  <td><%= aid.description %></td>
                  <td><%= aid.legacy_status&.name %></td>
                  <td class="text-nowrap"><%= legacy_date(aid.requested_on) %></td>
                  <td class="text-end"><%= legacy_amount(aid.amount_approved, aid.currency) %> <%= flagged_amount_badge(aid) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="panel__empty">Sin ayudas institucionales.</p>
      <% end %>
    </div>

    <div class="tab-pane fade" id="pane-scholarships" role="tabpanel" aria-labelledby="tab-scholarships" tabindex="0">
      <% if @scholarships.any? %>
        <div class="table-responsive data-table">
          <table class="table table-sm align-middle mb-0">
            <thead><tr><th>Programa</th><th>Nivel</th><th>Especialidad</th><th>Institución</th><th>Inicio</th><th>Fin</th><th>Estado</th></tr></thead>
            <tbody>
              <% @scholarships.each do |scholarship| %>
                <tr>
                  <td><%= scholarship.program %></td>
                  <td><%= scholarship.level %></td>
                  <td><%= scholarship.specialty %></td>
                  <td><%= [ scholarship.institution, scholarship.country ].compact_blank.join(", ") %></td>
                  <td class="text-nowrap"><%= legacy_date(scholarship.starts_on) %></td>
                  <td class="text-nowrap"><%= legacy_date(scholarship.ends_on) %></td>
                  <td><%= scholarship.status || "—" %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="panel__empty">Sin becas registradas.</p>
      <% end %>
    </div>

    <% if @reviews %>
      <div class="tab-pane fade" id="pane-reviews" role="tabpanel" aria-labelledby="tab-reviews" tabindex="0">
        <p class="small text-muted mb-2"><%= confidential_badge %> Proyectos que se le enviaron a arbitrar (sistema heredado, 1989–2012).</p>
        <% if @reviews.any? %>
          <div class="table-responsive data-table">
            <table class="table table-sm align-middle mb-0">
              <thead><tr><th>Código</th><th>Etapa</th><th>Título</th><th>Oficio</th><th>Respuesta</th><th>Resultado</th><th>Ratificado</th><th>Observaciones</th></tr></thead>
              <tbody>
                <% @reviews.each do |review| %>
                  <% stage = review.project_stage %>
                  <tr>
                    <td class="text-nowrap"><%= stage ? link_to(stage.research_project.code, research_project_path(stage.research_project)) : review.legacy_code %></td>
                    <td><%= review.stage_number %></td>
                    <td><%= stage&.title || "—" %></td>
                    <td class="text-nowrap"><%= legacy_date(review.sent_on) %></td>
                    <td class="text-nowrap"><%= legacy_date(review.answered_on) %></td>
                    <td><%= peer_review_outcome_badge(review) %></td>
                    <td><%= yes_no(review.ratified) %></td>
                    <td class="small text-muted"><%= multiline(review.notes) %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <p class="panel__empty">Sin arbitrajes registrados.</p>
        <% end %>
      </div>
    <% end %>
  </div>
</section>

<p class="small text-muted">Fuentes: <%= @person.sources.to_s.split(",").map(&:strip).join(", ") %></p>
