<div class="container-fluid">
  <div class="row">
    <%= render "/layouts/header" %> <!-- Header -->
    <%= render "/layouts/sidebar" %> <!-- Sidebar para pantallas grandes -->

    <!-- Contenido principal -->
    <div class="col-md mt-3 ms-auto col-lg-10 px-md-3">
      <% content_for :title, "CDCH - #{@person.full_name}" %>
      <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
        <div>
          <h1 class="h3 mb-1"><%= @person.full_name %></h1>
          <div class="text-muted">
            C.I. <%= [ @person.nationality, @person.id_number ].compact.join("-") %> ·
            <%= situation_badge(@person) %>
            · <%= faculty_label(@person.faculty_code, @faculty_names) %>
          </div>
        </div>
        <%= link_to "Volver al listado", people_path, class: "btn btn-outline-secondary btn-sm" %>
      </div>

      <div class="row g-3 mb-4">
        <% [ [ "Etapas como responsable", @led_stages.size ], [ "Etapas como coinvestigador", @co_stages.size ], [ "Ayudas institucionales", @aids.size ], [ "Becas", @scholarships.size ] ].each do |label, value| %>
          <div class="col-6 col-md-3">
            <div class="card shadow-sm h-100"><div class="card-body py-2">
              <div class="small text-muted"><%= label %></div>
              <div class="fs-4 fw-bold"><%= value %></div>
            </div></div>
          </div>
        <% end %>
      </div>

      <h2 class="h5">Cargos en la UCV</h2>
      <% if @appointments.any? %>
        <table class="table table-sm table-bordered">
          <thead><tr><th>Nómina</th><th>Dependencia</th><th>Unidad ejecutora</th><th>Categoría</th><th>Dedicación</th><th>Ingreso</th><th>Jubilación</th></tr></thead>
          <tbody>
            <% @appointments.each do |appointment| %>
              <tr>
                <td><%= appointment.payroll_type %></td>
                <td><%= appointment.dependency %></td>
                <td><%= appointment.ucv_unit_name || appointment.ucv_unit_code || "—" %></td>
                <td><%= appointment.category %></td>
                <td><%= appointment.dedication %></td>
                <td><%= legacy_date(appointment.hired_on) %></td>
                <td><%= legacy_date(appointment.retired_on) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="text-muted">No aparece en la nómina docente 2026.
          <% if @person.legacy_category || @person.legacy_condition %>
            Sistema heredado: <%= [ @person.legacy_condition, @person.legacy_category, @person.legacy_dedication ].compact.join(" · ") %>.
          <% end %>
        </p>
      <% end %>

      <% if @contacts.any? || @ppi_levels.any? %>
        <div class="row">
          <% if @contacts.any? %>
            <div class="col-md-8">
              <h2 class="h5">Contacto <small class="text-muted fw-normal">(datos del sistema heredado; pueden estar desactualizados)</small></h2>
              <ul class="list-unstyled small">
                <% @contacts.each do |contact| %>
                  <li><strong><%= { "email" => "Correo", "phone" => "Teléfono", "address" => "Dirección" }[contact.kind] %>:</strong> <%= contact.value %></li>
                <% end %>
              </ul>
            </div>
          <% end %>
          <% if @ppi_levels.any? %>
            <div class="col-md-4">
              <h2 class="h5">PPI (2005)</h2>
              <ul class="list-unstyled small">
                <% @ppi_levels.each do |ppi| %>
                  <li>Nivel <%= ppi.level %><%= " · #{ppi.committee}" if ppi.committee.present? %></li>
                <% end %>
              </ul>
            </div>
          <% end %>
        </div>
      <% end %>

      <h2 class="h5 mt-3">Proyectos como responsable</h2>
      <%= render "stages", stages: @led_stages, empty: "Sin etapas como responsable." %>

      <h2 class="h5 mt-3">Proyectos como coinvestigador</h2>
      <% if @co_stages.any? %>
        <table class="table table-sm table-bordered">
          <thead><tr><th>Código</th><th>Etapa</th><th>Título</th><th>Responsable</th><th>Solicitud</th></tr></thead>
          <tbody>
            <% @co_stages.each do |co| %>
              <% stage = co.project_stage %>
              <tr>
                <td><%= stage ? link_to(stage.research_project.code, research_project_path(stage.research_project)) : co.project_code %></td>
                <td><%= co.stage_number %></td>
                <td><%= stage&.title || "(etapa no encontrada en el sistema heredado)" %></td>
                <td><%= stage&.lead_person ? link_to(stage.lead_person.full_name, person_path(stage.lead_person)) : "—" %></td>
                <td><%= legacy_date(stage&.requested_on) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="text-muted">Sin participaciones como coinvestigador.</p>
      <% end %>

      <h2 class="h5 mt-3">Ayudas institucionales</h2>
      <% if @aids.any? %>
        <table class="table table-sm table-bordered">
          <thead><tr><th>Código</th><th>Tipo</th><th>Descripción</th><th>Estado</th><th>Solicitud</th><th class="text-end">Aprobado</th></tr></thead>
          <tbody>
            <% @aids.each do |aid| %>
              <tr>
                <td><%= aid.code %></td>
                <td><%= aid.aid_type_code %></td>
                <td><%= aid.description %></td>
                <td><%= aid.legacy_status&.name %></td>
                <td><%= legacy_date(aid.requested_on) %></td>
                <td class="text-end"><%= legacy_amount(aid.amount_approved, aid.currency) %> <%= flagged_amount_badge(aid) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="text-muted">Sin ayudas institucionales.</p>
      <% end %>

      <h2 class="h5 mt-3">Becas</h2>
      <% if @scholarships.any? %>
        <table class="table table-sm table-bordered">
          <thead><tr><th>Programa</th><th>Nivel</th><th>Especialidad</th><th>Institución</th><th>Inicio</th><th>Fin</th><th>Estado</th></tr></thead>
          <tbody>
            <% @scholarships.each do |scholarship| %>
              <tr>
                <td><%= scholarship.program %></td>
                <td><%= scholarship.level %></td>
                <td><%= scholarship.specialty %></td>
                <td><%= [ scholarship.institution, scholarship.country ].compact_blank.join(", ") %></td>
                <td><%= legacy_date(scholarship.starts_on) %></td>
                <td><%= legacy_date(scholarship.ends_on) %></td>
                <td><%= scholarship.status || "—" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="text-muted">Sin becas registradas.</p>
      <% end %>

      <p class="small text-muted mt-4">Fuentes: <%= @person.sources %></p>
    </div>
  </div>
</div>

<%= render "offcanvas" %>
