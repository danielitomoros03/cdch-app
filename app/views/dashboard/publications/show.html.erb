<div class="container-fluid">
  <div class="row">
    <%= render "/layouts/header" %> <!-- Header -->
    <%= render "/layouts/sidebar" %> <!-- Sidebar para pantallas grandes -->

    <!-- Contenido principal -->
    <div class="col-md mt-3 ms-auto col-lg-10 px-md-0 text-center">
      <!-- Flash messages -->
      <div>
        <% if notice %>
          <h6 class="alert alert-success col-md m-5 px-md-0 text-center"><%= notice %></h6>
        <% end %>
      </div>

      <% content_for :title, "Showing publication" %>
      <p>
        <h1>Publicación <%= @publication.id %></h1>
      </p>
      <div class="container">

      <table class="table table-striped table-hover table-bordered">
        <thead>
          <tr>
            <th scope="col">ID</th>
            <th scope="col">Title</th>
            <th scope="col">Acciones</th>
          </tr>
        </thead>
        <tbody>
          <div id="publications">
            <%= render @publication %>
          </div>
        </tbody>
      </table>

      <div class="container-fluid">
        <%= link_to "Edit this publication", edit_publication_path(@publication), class: "btn btn-primary" %> |
        <%= link_to "Back to publications", publications_path, class: "btn btn-dark" %> |
        <%= button_to "Eliminar convocatoria", @publication, method: :delete, class: "btn btn-danger", form: { data: { turbo_confirm: '¿Estás seguro que deseas eliminar esta convocatoria?' } } %>
      </div>
    </div>
  </div>
</div>


<!-- mobile offcanvas provided by navbar -->