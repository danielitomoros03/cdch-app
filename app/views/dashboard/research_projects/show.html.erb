<div>
  <% content_for :title, "CDCH - Proyecto #{@research_project.code}" %>
  <div class="dashboard-page-header">
    <div>
      <h1 class="dashboard-page-header__title"><%= @research_project.title %></h1>
      <div class="dashboard-page-header__subtitle">
        <%= @research_project.code %><%= " (antes #{@research_project.legacy_code})" if @research_project.legacy_code.present? %>
        · <%= @research_project.project_type&.name || @research_project.project_type_code %>
        · <%= faculty_label(@research_project.faculty_code, @faculty_names) %>
        <% if @research_project.lead_person %>
          · Responsable: <%= link_to @research_project.lead_person.display_name, person_path(@research_project.lead_person) %>
        <% end %>
      </div>
    </div>
    <%= link_to "Volver", :back, class: "btn btn-outline-secondary btn-sm" %>
  </div>

  <% @stages.each do |stage| %>
    <div class="card dashboard-card mb-3">
      <div class="card-header d-flex justify-content-between flex-wrap">
        <strong>Etapa <%= [ stage.number, stage.total_stages ].compact.join(" de ") %></strong>
        <span><%= stage.legacy_status&.name %> · solicitada <%= legacy_date(stage.requested_on) %></span>
      </div>
      <div class="card-body small">
        <% if stage.title.present? && stage.title != @research_project.title %>
          <p><strong>Título en esta etapa:</strong> <%= stage.title %></p>
        <% end %>
        <% if stage.lead_person && stage.lead_person_id != @research_project.lead_person_id %>
          <p><strong>Responsable en esta etapa:</strong> <%= link_to stage.lead_person.display_name, person_path(stage.lead_person) %></p>
        <% end %>
        <div class="row">
          <div class="col-md-6">
            <dl class="row mb-0">
              <dt class="col-6">Solicitado</dt><dd class="col-6"><%= legacy_amount(stage.amount_requested, stage.currency) %></dd>
              <dt class="col-6">Aprobado</dt><dd class="col-6"><%= legacy_amount(stage.amount_approved, stage.currency) %> <%= flagged_amount_badge(stage) %></dd>
              <dt class="col-6">Fecha de aprobación</dt><dd class="col-6"><%= legacy_date(stage.approved_on) %></dd>
              <dt class="col-6">Fondo</dt><dd class="col-6"><%= stage.funding_source&.name || "—" %></dd>
              <dt class="col-6">Duración</dt><dd class="col-6"><%= stage.duration_months ? "#{stage.duration_months} meses" : "—" %></dd>
            </dl>
          </div>
          <div class="col-md-6">
            <dl class="row mb-0">
              <dt class="col-6">Equipos</dt><dd class="col-6"><%= legacy_amount(stage.amount_equipment, stage.currency) %></dd>
              <dt class="col-6">Materiales</dt><dd class="col-6"><%= legacy_amount(stage.amount_supplies, stage.currency) %></dd>
              <dt class="col-6">Viajes</dt><dd class="col-6"><%= legacy_amount(stage.amount_travel, stage.currency) %></dd>
              <dt class="col-6">Servicios</dt><dd class="col-6"><%= legacy_amount(stage.amount_services, stage.currency) %></dd>
              <dt class="col-6">Personal</dt><dd class="col-6"><%= legacy_amount(stage.amount_personnel, stage.currency) %></dd>
              <dt class="col-6">Otros</dt><dd class="col-6"><%= legacy_amount(stage.amount_other, stage.currency) %></dd>
            </dl>
          </div>
        </div>
        <p class="mt-2 mb-1">
          <strong>Informe parcial:</strong> <%= legacy_date(stage.partial_report_approved_on) %><%= " (conforme)" if stage.partial_report_ok %> ·
          <strong>Informe final:</strong> <%= legacy_date(stage.final_report_approved_on) %><%= " (conforme)" if stage.final_report_ok %>
        </p>
        <% if stage.co_investigators.any? %>
          <p class="mb-1"><strong>Coinvestigadores:</strong>
            <%= safe_join(stage.co_investigators.map { |co| link_to(co.person.display_name, person_path(co.person)) }, ", ") %>
          </p>
        <% end %>
        <% if stage.publications.any? %>
          <p class="mb-1"><strong>Publicaciones:</strong>
            <%= safe_join(stage.publications.map { |pub| [ pub.title, pub.venue ].compact_blank.join(" — ") }, "; ") %>
          </p>
        <% end %>
        <% if stage.extensions.any? %>
          <p class="mb-1"><strong>Prórrogas:</strong> <%= safe_join(stage.extensions.map { |ext| legacy_date(ext.granted_on) }, ", ") %></p>
        <% end %>
        <% if stage.work_title.present? %>
          <p class="mb-1"><strong>Trabajo:</strong> <%= stage.work_title %><%= " — #{stage.work_journal}" if stage.work_journal.present? %></p>
        <% end %>
        <% if stage.notes.present? %>
          <p class="mb-0 text-muted"><strong>Observaciones:</strong> <%= stage.notes %></p>
        <% end %>
        <% if (reviews = @reviews_by_stage&.fetch(stage.id, nil)) %>
          <h3 class="panel__subtitle mt-3">Arbitrajes <%= confidential_badge %></h3>
          <div class="table-responsive data-table">
            <table class="table table-sm align-middle mb-0">
              <thead><tr><th>Árbitro</th><th>Oficio</th><th>Respuesta</th><th>Resultado</th><th>Ratificado</th><th>Observaciones</th></tr></thead>
              <tbody>
                <% reviews.each do |review| %>
                  <tr>
                    <td><%= review.reviewer_person ? link_to(review.reviewer_display_name, person_path(review.reviewer_person)) : review.reviewer_display_name %></td>
                    <td class="text-nowrap"><%= legacy_date(review.sent_on) %></td>
                    <td class="text-nowrap"><%= legacy_date(review.answered_on) %></td>
                    <td><%= peer_review_outcome_badge(review) %></td>
                    <td><%= yes_no(review.ratified) %></td>
                    <td class="small text-muted"><%= multiline(review.notes) %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
