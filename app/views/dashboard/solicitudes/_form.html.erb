<%# Sin Turbo: así la vuelta al formulario conserva el ancla #mensaje y el aviso queda a la vista. %>
<%= form_with(model: solicitude, url: url, local: true, data: { turbo: false }) do |form| %>
  <% if solicitude.errors.any? %>
    <div style="color: red" class="mb-3">
      <h2><%= pluralize(solicitude.errors.count, "error") %> prohibited this solicitude from being saved:</h2>

      <ul>
        <% solicitude.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :full_name, "Nombre completo" %>
    <%= form.text_field :full_name, class: "form-control", required: true %>
  </div>

  <div class="mb-3">
    <%= form.label :email, "Correo electrónico" %>
    <%= form.email_field :email, class: "form-control", required: true %>
  </div>

  <div class="mb-3">
    <%= form.label :phone_number, "Número de teléfono" %>
    <%= form.text_field :phone_number, class: "form-control", required: true %>
  </div>

  <div class="mb-3">
    <%= form.label :matter, "Asunto de la solicitud" %>
    <%= form.select :matter, Department.publicly_visible.order(:id).map { |d| [d.name, d.id] }, { prompt: "Seleccione un departamento" }, { class: "form-control", required: true } %>
  </div>

  <div class="mb-3">
    <%= form.label :message, "Mensaje de la Solicitud" %>
    <%= form.text_area :message, class: "form-control", rows: 4, required: true %>
  </div>

  <%# Trampa para robots: una persona no lo ve ni lo llena. %>
  <div class="form-trap" aria-hidden="true">
    <label for="solicitude_website">Sitio web</label>
    <input type="text" name="solicitude[website]" id="solicitude_website" tabindex="-1" autocomplete="off">
  </div>

  <div class="mb-3 form-check">
    <%= form.check_box :policies, class: "form-check-input", required: true %>
    <%= form.label :policies, "Acepto las políticas de privacidad", class: "form-check-label" %>
  </div>

  <div>
    <%= form.submit "Enviar Solicitud", class: "btn btn-primary" %>
  </div>
<% end %>
