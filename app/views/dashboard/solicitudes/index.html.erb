<div class="container-fluid">
  <div class="row">
    <%= render "/layouts/header" %> <!-- Header -->
    <%= render "/layouts/sidebar" %> <!-- Sidebar para pantallas grandes -->

    <!-- Contenido principal -->
    <div class="col-md mt-3 ms-auto col-lg-10 px-md-0 text-center">
      <!-- Flash messages -->
      <div>
        <% if notice %>
          <h6 class="alert alert-success col-md m-5 px-md-0 text-center"><%= notice %></h6>
        <% end %>
      </div>

      <% content_for :title, "CDCH - Solicitudes" %>
      <p>
        <h1>Solicitudes Recibidas</h1>
      </p>
      <div class="container">
        <div id="solicitudes">
          <table class="table table-striped table-hover table-bordered">
            <thead>
              <tr>
                <th scope="col">N°</th>
                <th scope="col">Nombre</th>
                <th scope="col">Email</th>
                <th scope="col">Teléfono</th>
                <th scope="col">Mensaje</th>
                <th scope="col">Departamento</th>
                <th scope="col">Fecha</th>
                <th scope="col">Acciones</th>
              </tr>
            </thead>
            <tbody>
              <% @solicitudes.each do |solicitude| %>
                <tr>
                  <td><%= solicitude.id %></td>
                  <td><%= solicitude.full_name %></td>
                  <td><%= solicitude.email %></td>
                  <td><%= solicitude.phone_number %></td>
                  <td><%= solicitude.message %></td>
                  <td><%= Department.find_by(id: solicitude.matter)&.name || "Sin asunto" %></td>
                  <td><%= solicitude.created_at.strftime("%d/%m/%Y %H:%M") %></td>
                  <td>
                    <%= link_to 'Ver', solicitude_path(solicitude), class: "btn btn-sm btn-info" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Offcanvas Sidebar para pantallas pequeñas -->
<div class="offcanvas offcanvas-start bg-light" tabindex="-1" id="offcanvasSidebar" aria-labelledby="offcanvasSidebarLabel">
  <div class="offcanvas-header bg-dark text-white">
    <h5 class="offcanvas-title" id="offcanvasSidebarLabel"><strong>UCV - La casa que vence la sombra</strong></h5>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Close"></button>
  </div>
  <div class="offcanvas-body">
    <%= render "/layouts/sidebar" %>
  </div>
</div>
