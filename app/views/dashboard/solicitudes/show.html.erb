<div class="text-center">
  <!-- Flash messages -->
  <div>
    <% if notice %>
      <h6 class="alert alert-success col-md m-5 px-md-0 text-center"><%= notice %></h6>
    <% end %>
  </div>

  <% content_for :title, "CDCH - Solicitud" %>
  <p>
    <h1>Detalle de Solicitud  <%= link_to 'Volver', solicitudes_path, class: "btn btn-primary" %></h1>
  </p>
  <div class="container">
    <table class="table table-striped table-hover table-bordered">
    <thead>
      <tr>
        <th scope="col">ID</th>
        <th scope="col">Nombre completo</th>
        <th scope="col">Correo</th>
        <th scope="col">Teléfono</th>
        <th scope="col">Mensaje</th>
        <th scope="col">Asunto</th>
        <th scope="col">Fecha</th>
        <th scope="col">Políticas aceptadas</th>
      </tr>
    </thead>
    <tbody>
      <div id="solicitudes">
        <%= render @solicitude %>
      </div>
    </tbody>
  </table>
  </div>
</div>
