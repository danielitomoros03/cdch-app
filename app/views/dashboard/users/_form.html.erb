<%= form_with(model: user) do |form| %>
  <% if user.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(user.errors.count, "error") %> prohibited this user from being saved:</h2>
      <ul>
        <% user.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mt-3">
    <%= form.label :email, style: "display: block" %>
    <%= form.email_field :email, class: "form-control" %>
  </div>

  <div class="mt-3">
    <%= form.label :name, style: "display: block" %>
    <%= form.text_field :name, class: "form-control" %>
  </div>

  <div class="mt-3">
    <%= form.label :lastname, style: "display: block" %>
    <%= form.text_field :lastname, class: "form-control" %>
  </div>

  <div class="mt-3">
    <%= form.label :number_phone, style: "display: block" %>
    <%= form.telephone_field :number_phone, class: "form-control" %>
  </div>

  <div class="mt-3">
    <%= form.label :identification_number, style: "display: block" %>
    <%= form.text_field :identification_number, class: "form-control" %>
  </div>
  
  <div class="mt-3">
    <%= form.label :job_title_id, "Cargo laboral", style: "display: block" %>
    <%= form.collection_select :job_title_id, @job_titles, :id, :name, { include_blank: "Seleccione un cargo..." }, { class: "form-select shadow-sm" } %>
  </div>
  
  <div class="mt-3">
    <%= form.label :department_id, "Departamento correspondiente", style: "display: block" %>
    <%= form.collection_select :department_id, @departments, :id, :name, { include_blank: "Seleccione un departamento..." }, { class: "form-select shadow-sm" } %>
  </div>

  <% current_role_name = current_user.role.is_a?(Integer) ? JobTitle.roles.key(current_user.role) : current_user.role.to_s %>
  <% current_department_acronym = current_user.department&.acronym.to_s.strip.upcase %>
  <% show_advanced_permissions = current_role_name == "Superadmin" || (current_role_name == "JefeDepartamento" && current_department_acronym == "DTIC") %>

  <% if show_advanced_permissions %>
    <div class="mt-3">
      <%= form.label :resource_permissions, "Permisos de recursos", style: "display: block" %>
      <% selected_permissions = if defined?(@selected_resource_permissions) && !@selected_resource_permissions.nil?
                                  @selected_resource_permissions
                                else
                                  user.user_permissions.pluck(:resource)
                                end %>
      <% selected_permission_tokens = UserPermission.expand_tokens(selected_permissions) %>
      <%= hidden_field_tag "user[resource_permissions][]", "" %>

      <div class="border rounded p-3">
        <div class="table-responsive">
          <table class="table table-sm align-middle mb-0">
            <thead>
              <tr>
                <th>Recurso</th>
                <% @available_permission_actions.each do |action_name| %>
                  <th class="text-center"><%= UserPermission::ACTION_LABELS[action_name] %></th>
                <% end %>
              </tr>
            </thead>
            <tbody>
              <% @available_resources.each do |resource| %>
                <tr>
                  <td><%= UserPermission.resource_label(resource) %></td>
                  <% @available_permission_actions.each do |action_name| %>
                    <% permission_token = UserPermission.permission_token(resource, action_name) %>
                    <% checkbox_id = "user_resource_permissions_#{resource.downcase}_#{action_name}" %>
                    <td class="text-center">
                      <%= check_box_tag "user[resource_permissions][]", permission_token, selected_permission_tokens.include?(permission_token), id: checkbox_id, class: "form-check-input" %>
                    </td>
                  <% end %>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% end %>

  <div class="mt-3">
    <%= form.label :password, style: "display: block" %>
    <%= form.password_field :password, class: "form-control", autocomplete: "new-password" %>
  </div>

  <div class="mt-3">
    <%= form.label :password_confirmation, style: "display: block" %>
    <%= form.password_field :password_confirmation, class: "form-control", autocomplete: "new-password" %>
  </div>

  <div class="mt-3">
    <%= form.label :photoUser, "Foto del Usuario", style: "display: block" %>
    <%= form.file_field :photoUser, class: "form-control" %>
  </div>

  <div class="pt-3">
    <%= form.submit class: "btn btn-primary" %>
  </div>
<% end %>
