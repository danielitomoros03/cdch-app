<div id="<%= dom_id user %>">
  <tbody>
    <tr>
      <th scope="row"><%= user.id %></th>
      <td><%= user.email %></td>
      <td><%= user.name %></td>
      <td><%= user.lastname %></td>
      <td><%= user.number_phone %></td>
      <td>
        <%= link_to user_path(user), class: 'btn btn-info', title: 'Mostrar', data: { bs_toggle: 'tooltip' } do %>
          <i class="fa-solid fa-circle-info"></i>
        <% end %>
        <%= link_to edit_user_path(user), class: 'btn btn-warning', title: 'Editar', data: { bs_toggle: 'tooltip' } do %>
          <i class="fa-solid fa-pen"></i>
        <% end %>
        <%= button_to user_path(user), method: :delete, class: 'btn btn-danger', form: { data: { turbo_confirm: '¿Estás seguro que deseas eliminar este usuario?' } } do %>
            <i class="fa-solid fa-trash"></i>
        <% end %>
      </td>
    </tr>
  </tbody>
</div>
