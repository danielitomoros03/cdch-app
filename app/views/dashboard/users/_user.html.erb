<div id="<%= dom_id user %>">
  <tbody>
    <tr>
      <% if can? :read, user %>
        <th scope="row"><%= user.id %></th>
        <th scope="row"><%= user.department.acronym %></th>
        <td><%= user.email %></td>
        <td><%= user.name %></td>
        <td><%= user.lastname %></td>
        <td><%= user.number_phone %></td>
        <td>
          <% if can? :read, user %>
            <%= link_to user_path(user), class: 'btn btn-info', title: 'Mostrar', data: { bs_toggle: 'tooltip' } do %>
              <i class="fa-solid fa-circle-info"></i>
            <% end %>
          <% end %>
          <% if can? :edit, user %>
            <%= link_to edit_user_path(user), class: 'btn btn-warning', title: 'Editar', data: { bs_toggle: 'tooltip' } do %>
              <i class="fa-solid fa-pen"></i>
            <% end %>
          <% end %>
          <% if can? :destroy, user %>
            <%= button_to user_path(user), method: :delete, class: 'btn btn-danger', title: 'Eliminar', data: { bs_toggle: 'tooltip' },  form: { data: { turbo_confirm: '¿Estás seguro que deseas eliminar este usuario?' } } do %>
              <i class="fa-solid fa-trash"></i>
            <% end %>
          <% end %>
        </td>
      <% end %>
    </tr>
  </tbody>
</div>
