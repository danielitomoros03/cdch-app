<div class="text-center">
  <div>
    <% if notice %>
      <h6 class="alert alert-success col-md m-5 px-md-0 text-center"><%= notice %></h6>
    <% end %>
  </div>

  <% content_for :title, "Usuarios" %>
  <% if can? :create, User %>
    <p>
      <h1>Usuarios <%= link_to "Crear Usuario", new_user_path, class: "btn btn-primary" %></h1>
    </p>
  <% else %>
    <h1>Usuarios</h1>
  <% end %>
  <div class="container">
    <div id="users">
      <table class="table table-striped table-hover table-bordered">
        <thead>
          <tr>
            <th scope="col">ID</th>
            <th scope="col">Dpto</th>
            <th scope="col">Correo</th>
            <th scope="col">Nombre y Apellido</th>
            <th scope="col">Teléfono</th>
            <th scope="col">Acciones</th>
          </tr>
        </thead>
        <% @users.each do |user| %>
          <%= render user %>
        <% end %>
    </div>
  </div>
</div>
