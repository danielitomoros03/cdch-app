<div class="text-center">
  <div>
    <% if notice %>
      <h6 class="alert alert-success col-md m-5 px-md-0 text-center"><%= notice %></h6>
    <% end %>
  </div>

  <% content_for :title, "Usuario" %>
  <p>
    <h1>Usuario <%= @user.id %></h1>
  </p>
  <div class="container">

  <table class="table table-striped table-hover table-bordered">
    <thead>
      <tr>
        <th scope="col">ID</th>
        <th scope="col">Depto</th>
        <th scope="col">Nombre</th>
        <th scope="col">Apellido</th>
        <th scope="col">Teléfono</th>
        <th scope="col">Acciones</th>
      </tr>
    </thead>
    <tbody>
      <div id="users">
        <%= render @user %>
      </div>
    </tbody>
  </table>

  <div class="container-fluid">
    <% if can? :edit, @user %>
      <%= link_to "Editar usuario", edit_user_path(@user), class: "btn btn-primary m-2" %> 
    <% end %>
    <% if can? :read, User %>
      <%= link_to "Ver usuarios", users_path, class: "btn btn-dark m-2" %>
    <% end %>
    <% if can? :destroy, @user %>
      <%= button_to "Eliminar usuario", @user, method: :delete, class: "btn btn-danger m-2", form: { data: { turbo_confirm: '¿Estás seguro que deseas eliminar este usuario?' } } %>
    <% end %>
  </div>
</div>
</div>
