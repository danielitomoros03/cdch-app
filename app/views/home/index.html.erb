<!DOCTYPE html>
<html lang="es">
<style>
  .text-primary {
    --bs-text-opacity: 1;
    color: rgba(var(--bs-primary-rgb), var(--bs-text-opacity)) !important;
  }
</style>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CDCH-UCV</title>
  <!-- Bootstrap 5 CSS (puedes usar CDN o el asset pipeline de Rails) -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
</head>
<body>
  <!-- Header -->
  <header>
    <!-- Top Bar -->
    <div class="bg-blue text-white py-2">
      <div class="container d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center gap-4 small">
          <div class="d-flex align-items-center">
            <i class="bi bi-geo-alt me-1"></i>
            <span>Ciudad Universitaria, Caracas, Venezuela</span>
          </div>
          <div class="d-flex align-items-center">
            <i class="bi bi-telephone me-1"></i>
            <span>+58 212-555-5555</span>
          </div>
          <div class="d-flex align-items-center">
            <i class="bi bi-envelope me-1"></i>
            <span>info@cdch.ucv.ve</span>
          </div>
        </div>
        <div class="d-none d-md-flex align-items-center gap-2">
          <a href="#" class="text-white text-decoration-none">Español</a>
          <span>|</span>
          <a href="#" class="text-white text-decoration-none">English</a>
        </div>
      </div>
    </div>
    
    <!-- Main Header -->
    <div class="container py-3">
      <div class="d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center">
          <div class="me-4">
            <img src="https://via.placeholder.com/180x60" alt="CDCH-UCV Logo" class="img-fluid" style="height: 60px;">
          </div>
          <nav class="d-none d-lg-flex gap-4">
            <a href="#" class="text-dark text-decoration-none fw-medium">Inicio</a>
            <%= link_to "Nosotros", home_about_path, class: "text-dark text-decoration-none fw-medium" %>
            <a href="#" class="text-dark text-decoration-none fw-medium">Publicaciones</a>
            <a href="#" class="text-dark text-decoration-none fw-medium">Eventos</a>
            <a href="#" class="text-dark text-decoration-none fw-medium">Documentos</a>
            <a href="#" class="text-dark text-decoration-none fw-medium">Directorio</a>
            <a href="#" class="text-dark text-decoration-none fw-medium">Contacto</a>
          </nav>
        </div>
        <div class="d-flex align-items-center gap-3">
          <div class="d-none d-md-block position-relative">
            <input type="text" placeholder="Buscar..." class="form-control rounded-pill ps-4 pe-4" style="padding-left: 2.5rem;">
            <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
          </div>
          <button class="btn d-lg-none text-dark" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileMenu">
            <i class="bi bi-list fs-4"></i>
          </button>
        </div>
      </div>
    </div>
  </header>

  <!-- Mobile Menu Offcanvas -->
  <div class="offcanvas offcanvas-start" tabindex="-1" id="mobileMenu">
    <div class="offcanvas-header">
      <h5 class="offcanvas-title">CDCH-UCV</h5>
      <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
      <div class="mb-3">
        <div class="input-group">
          <span class="input-group-text"><i class="bi bi-search"></i></span>
          <input type="text" class="form-control" placeholder="Buscar...">
        </div>
      </div>
      <div class="d-flex flex-column gap-2">
        <a href="#" class="text-dark text-decoration-none py-2 border-bottom">Inicio</a>
        <a href="#" class="text-dark text-decoration-none py-2 border-bottom">Nosotros</a>
        <a href="#" class="text-dark text-decoration-none py-2 border-bottom">Publicaciones</a>
        <a href="#" class="text-dark text-decoration-none py-2 border-bottom">Eventos</a>
        <a href="#" class="text-dark text-decoration-none py-2 border-bottom">Documentos</a>
        <a href="#" class="text-dark text-decoration-none py-2 border-bottom">Directorio</a>
        <a href="#" class="text-dark text-decoration-none py-2 border-bottom">Contacto</a>
      </div>
    </div>
  </div>

  <main>
    <!-- Hero Section with Slider -->
    <section class="position-relative bg-primary text-white">
      <div class="position-absolute top-0 start-0 end-0 bottom-0 bg-primary opacity-75 z-index-1"></div>
      <div class="position-relative" style="height: 500px;">
        <img src="https://via.placeholder.com/1920x500" alt="CDCH-UCV Campus" class="w-100 h-100 object-fit-cover">
      </div>
      <div class="container position-absolute top-0 start-0 end-0 bottom-0 d-flex align-items-center" style="z-index: 2;">
        <div class="col-12 col-md-8 col-lg-6">
          <h1 class="display-4 fw-bold mb-4">Consejo de Desarrollo Científico y Humanístico</h1>
          <p class="fs-5 mb-4">Promoviendo la investigación y el desarrollo académico en la Universidad Central de Venezuela</p>
          <div class="d-flex flex-wrap gap-3">
            <a href="#" class="btn btn-danger px-4 py-2 fw-medium">Conocer más</a>
            <a href="#" class="btn btn-light text-primary px-4 py-2 fw-medium">Publicaciones</a>
          </div>
        </div>
      </div>
      <div class="position-absolute bottom-3 start-0 end-0 d-flex justify-content-center gap-2" style="z-index: 2;">
        <button class="btn p-0 opacity-50"><span class="bg-white d-inline-block rounded-circle" style="width: 10px; height: 10px;"></span></button>
        <button class="btn p-0"><span class="bg-white d-inline-block rounded-circle" style="width: 10px; height: 10px;"></span></button>
        <button class="btn p-0 opacity-50"><span class="bg-white d-inline-block rounded-circle" style="width: 10px; height: 10px;"></span></button>
      </div>
    </section>

    <!-- Announcement Bar -->
    <section class="bg-danger text-white py-3">
      <div class="container">
        <div class="d-flex align-items-center justify-content-center flex-wrap">
          <span class="fw-semibold me-2">ANUNCIO IMPORTANTE:</span>
          <span>Convocatoria abierta para proyectos de investigación 2025 - Fecha límite: 30 de abril</span>
          <a href="#" class="ms-3 text-white">Más información</a>
        </div>
      </div>
    </section>

    <!-- Latest News Section -->
    <section class="py-5 bg-light">
      <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
          <h2 class="fs-1 fw-bold text-dark">Noticias Recientes</h2>
          <a href="#" class="text-primary text-decoration-none d-flex align-items-center">
            Ver todas <i class="bi bi-chevron-right ms-1"></i>
          </a>
        </div>
        <div class="row g-4">
          <!-- News Card 1 -->
          <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
              <div style="height: 200px; overflow: hidden;">
                <img src="https://via.placeholder.com/400x200" alt="Día del Empleado Universitario" class="card-img-top h-100 object-fit-cover">
              </div>
              <div class="card-body">
                <div class="d-flex align-items-center text-muted small mb-2">
                  <i class="bi bi-calendar me-1"></i>
                  <span>10 de marzo, 2025</span>
                </div>
                <h3 class="card-title fs-4 fw-bold">Día del Empleado Universitario</h3>
                <p class="card-text text-muted">Felicitaciones a todos los empleados universitarios, pilar importante del funcionamiento de las casas de estudio...</p>
                <a href="#" class="text-primary text-decoration-none fw-medium d-flex align-items-center">
                  Leer más <i class="bi bi-chevron-right ms-1"></i>
                </a>
              </div>
            </div>
          </div>

          <!-- News Card 2 -->
          <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
              <div style="height: 200px; overflow: hidden;">
                <img src="https://via.placeholder.com/400x200" alt="Día del Médico en Venezuela" class="card-img-top h-100 object-fit-cover">
              </div>
              <div class="card-body">
                <div class="d-flex align-items-center text-muted small mb-2">
                  <i class="bi bi-calendar me-1"></i>
                  <span>10 de marzo, 2025</span>
                </div>
                <h3 class="card-title fs-4 fw-bold">Día del Médico en Venezuela</h3>
                <p class="card-text text-muted">Cada 10 de marzo en Venezuela, se celebra el Día del Médico, fecha que coincide con el Natalicio del Dr. José María Vargas...</p>
                <a href="#" class="text-primary text-decoration-none fw-medium d-flex align-items-center">
                  Leer más <i class="bi bi-chevron-right ms-1"></i>
                </a>
              </div>
            </div>
          </div>

          <!-- News Card 3 -->
          <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
              <div style="height: 200px; overflow: hidden;">
                <img src="https://via.placeholder.com/400x200" alt="Concursos de oposición" class="card-img-top h-100 object-fit-cover">
              </div>
              <div class="card-body">
                <div class="d-flex align-items-center text-muted small mb-2">
                  <i class="bi bi-calendar me-1"></i>
                  <span>28 de febrero, 2025</span>
                </div>
                <h3 class="card-title fs-4 fw-bold">Concursos de oposición: Directorio 28/2/2025</h3>
                <p class="card-text text-muted">El Consejo de Desarrollo Científico y Humanístico anuncia la apertura de concursos de oposición para diversas áreas...</p>
                <a href="#" class="text-primary text-decoration-none fw-medium d-flex align-items-center">
                  Leer más <i class="bi bi-chevron-right ms-1"></i>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Publications Section -->
    <section class="py-5">
      <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
          <h2 class="fs-1 fw-bold text-dark">Publicaciones Recientes</h2>
          <a href="#" class="text-primary text-decoration-none d-flex align-items-center">
            Ver todas <i class="bi bi-chevron-right ms-1"></i>
          </a>
        </div>
        <div class="row g-4">
          <!-- Publication 1 -->
          <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm">
              <div style="height: 320px; overflow: hidden;">
                <img src="https://via.placeholder.com/200x300" alt="El periodismo musical en Venezuela" class="card-img-top h-100 object-fit-cover">
              </div>
              <div class="card-body">
                <h3 class="card-title fs-5 fw-bold">El periodismo musical en Venezuela</h3>
                <p class="card-text small text-muted mb-2">Hugo J. Quintana M.</p>
                <a href="#" class="text-primary text-decoration-none small fw-medium d-flex align-items-center">
                  Ver detalles <i class="bi bi-chevron-right ms-1"></i>
                </a>
              </div>
            </div>
          </div>

          <!-- Publication 2 -->
          <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm">
              <div style="height: 320px; overflow: hidden;">
                <img src="https://via.placeholder.com/200x300" alt="Memoria para el futuro" class="card-img-top h-100 object-fit-cover">
              </div>
              <div class="card-body">
                <h3 class="card-title fs-5 fw-bold">Memoria para el futuro</h3>
                <p class="card-text small text-muted mb-2">Edith Hernández P.</p>
                <a href="#" class="text-primary text-decoration-none small fw-medium d-flex align-items-center">
                  Ver detalles <i class="bi bi-chevron-right ms-1"></i>
                </a>
              </div>
            </div>
          </div>

          <!-- Publication 3 -->
          <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm">
              <div style="height: 320px; overflow: hidden;">
                <img src="https://via.placeholder.com/200x300" alt="El Eterno Retrato" class="card-img-top h-100 object-fit-cover">
              </div>
              <div class="card-body">
                <h3 class="card-title fs-5 fw-bold">El Eterno Retrato</h3>
                <p class="card-text small text-muted mb-2">Adolfo E. Calvo A.</p>
                <a href="#" class="text-primary text-decoration-none small fw-medium d-flex align-items-center">
                  Ver detalles <i class="bi bi-chevron-right ms-1"></i>
                </a>
              </div>
            </div>
          </div>

          <!-- Publication 4 -->
          <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm">
              <div style="height: 320px; overflow: hidden;">
                <img src="https://via.placeholder.com/200x300" alt="Investigación y Desarrollo" class="card-img-top h-100 object-fit-cover">
              </div>
              <div class="card-body">
                <h3 class="card-title fs-5 fw-bold">Investigación y Desarrollo</h3>
                <p class="card-text small text-muted mb-2">Varios Autores</p>
                <a href="#" class="text-primary text-decoration-none small fw-medium d-flex align-items-center">
                  Ver detalles <i class="bi bi-chevron-right ms-1"></i>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Events Section -->
    <section class="py-5 bg-light">
      <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
          <h2 class="fs-1 fw-bold text-dark">Próximos Eventos</h2>
          <a href="#" class="text-primary text-decoration-none d-flex align-items-center">
            Ver todos <i class="bi bi-chevron-right ms-1"></i>
          </a>
        </div>
        <div class="row g-4">
          <!-- Event 1 -->
          <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
              <div class="d-flex">
                <div class="bg-primary text-white p-3 d-flex flex-column align-items-center justify-content-center" style="min-width: 100px;">
                  <span class="fs-3 fw-bold">15</span>
                  <span class="small text-uppercase">Abr</span>
                  <span class="small">2025</span>
                </div>
                <div class="p-3">
                  <h3 class="fs-5 fw-bold mb-2">Jornada de Investigación Científica</h3>
                  <div class="d-flex align-items-center text-muted mb-2">
                    <i class="bi bi-geo-alt me-1"></i>
                    <span class="small">Aula Magna, UCV</span>
                  </div>
                  <p class="text-muted small mb-3">Presentación de proyectos de investigación financiados por el CDCH.</p>
                  <a href="#" class="text-primary text-decoration-none small fw-medium d-flex align-items-center">
                    Más información <i class="bi bi-chevron-right ms-1"></i>
                  </a>
                </div>
              </div>
            </div>
          </div>

          <!-- Event 2 -->
          <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
              <div class="d-flex">
                <div class="bg-primary text-white p-3 d-flex flex-column align-items-center justify-content-center" style="min-width: 100px;">
                  <span class="fs-3 fw-bold">22</span>
                  <span class="small text-uppercase">Abr</span>
                  <span class="small">2025</span>
                </div>
                <div class="p-3">
                  <h3 class="fs-5 fw-bold mb-2">Taller de Metodología de la Investigación</h3>
                  <div class="d-flex align-items-center text-muted mb-2">
                    <i class="bi bi-geo-alt me-1"></i>
                    <span class="small">Sala E, Facultad de Humanidades</span>
                  </div>
                  <p class="text-muted small mb-3">Taller dirigido a investigadores noveles sobre metodologías actuales.</p>
                  <a href="#" class="text-primary text-decoration-none small fw-medium d-flex align-items-center">
                    Más información <i class="bi bi-chevron-right ms-1"></i>
                  </a>
                </div>
              </div>
            </div>
          </div>

          <!-- Event 3 -->
          <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
              <div class="d-flex">
                <div class="bg-primary text-white p-3 d-flex flex-column align-items-center justify-content-center" style="min-width: 100px;">
                  <span class="fs-3 fw-bold">30</span>
                  <span class="small text-uppercase">Abr</span>
                  <span class="small">2025</span>
                </div>
                <div class="p-3">
                  <h3 class="fs-5 fw-bold mb-2">Cierre de Convocatoria de Proyectos</h3>
                  <div class="d-flex align-items-center text-muted mb-2">
                    <i class="bi bi-geo-alt me-1"></i>
                    <span class="small">Sede CDCH-UCV</span>
                  </div>
                  <p class="text-muted small mb-3">Fecha límite para la presentación de proyectos de investigación 2025.</p>
                  <a href="#" class="text-primary text-decoration-none small fw-medium d-flex align-items-center">
                    Más información <i class="bi bi-chevron-right ms-1"></i>
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Quick Links Section -->
    <section class="py-5">
      <div class="container">
        <h2 class="fs-1 fw-bold text-dark mb-4 text-center">Enlaces de Interés</h2>
        <div class="row g-4">
          <div class="col-6 col-md-3">
            <a href="#" class="card h-100 shadow-sm text-center text-decoration-none hover-shadow-lg transition p-4">
              <div class="d-flex flex-column align-items-center">
                <div class="bg-primary bg-opacity-10 p-3 rounded-circle mb-3">
                  <i class="bi bi-file-text fs-3 text-primary"></i>
                </div>
                <h3 class="fs-5 fw-bold text-dark">Documentos</h3>
                <p class="small text-muted mt-2">Accede a documentos oficiales</p>
              </div>
            </a>
          </div>
          
          <div class="col-6 col-md-3">
            <a href="#" class="card h-100 shadow-sm text-center text-decoration-none hover-shadow-lg transition p-4">
              <div class="d-flex flex-column align-items-center">
                <div class="bg-primary bg-opacity-10 p-3 rounded-circle mb-3">
                  <i class="bi bi-book fs-3 text-primary"></i>
                </div>
                <h3 class="fs-5 fw-bold text-dark">Publicaciones</h3>
                <p class="small text-muted mt-2">Explora nuestro catálogo</p>
              </div>
            </a>
          </div>
          
          <div class="col-6 col-md-3">
            <a href="#" class="card h-100 shadow-sm text-center text-decoration-none hover-shadow-lg transition p-4">
              <div class="d-flex flex-column align-items-center">
                <div class="bg-primary bg-opacity-10 p-3 rounded-circle mb-3">
                  <i class="bi bi-people fs-3 text-primary"></i>
                </div>
                <h3 class="fs-5 fw-bold text-dark">Directorio</h3>
                <p class="small text-muted mt-2">Conoce nuestro equipo</p>
              </div>
            </a>
          </div>
          
          <div class="col-6 col-md-3">
            <a href="#" class="card h-100 shadow-sm text-center text-decoration-none hover-shadow-lg transition p-4">
              <div class="d-flex flex-column align-items-center">
                <div class="bg-primary bg-opacity-10 p-3 rounded-circle mb-3">
                  <i class="bi bi-calendar-event fs-3 text-primary"></i>
                </div>
                <h3 class="fs-5 fw-bold text-dark">Calendario</h3>
                <p class="small text-muted mt-2">Eventos y actividades</p>
              </div>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Call to Action -->
    <section class="py-5 bg-primary text-white">
      <div class="container text-center">
        <h2 class="fs-1 fw-bold mb-3">¿Interesado en nuestros programas de investigación?</h2>
        <p class="fs-5 mb-4 mx-auto" style="max-width: 800px;">Descubre cómo el CDCH-UCV puede apoyar tus proyectos de investigación y desarrollo académico.</p>
        <div class="d-flex justify-content-center flex-wrap gap-3">
          <a href="#" class="btn btn-danger px-4 py-2 fw-medium">Solicitar información</a>
          <a href="#" class="btn btn-outline-light px-4 py-2 fw-medium">Ver convocatorias</a>
        </div>
      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer class="bg-dark text-white">
    <!-- Main Footer -->
    <div class="container py-5">
      <div class="row g-4">
        <!-- Column 1 - About -->
        <div class="col-lg-3 col-md-6">
          <img src="https://via.placeholder.com/180x60" alt="CDCH-UCV Logo" class="img-fluid mb-3" style="height: 50px;">
          <p class="text-muted mb-3">
            El Consejo de Desarrollo Científico y Humanístico de la Universidad Central de Venezuela promueve la investigación y el desarrollo académico.
          </p>
          <div class="d-flex gap-3">
            <a href="#" class="text-muted">
              <i class="bi bi-facebook"></i>
            </a>
            <a href="#" class="text-muted">
              <i class="bi bi-twitter"></i>
            </a>
            <a href="#" class="text-muted">
              <i class="bi bi-instagram"></i>
            </a>
            <a href="#" class="text-muted">
              <i class="bi bi-youtube"></i>
            </a>
          </div>
        </div>
        
        <!-- Column 2 - Quick Links -->
        <div class="col-lg-3 col-md-6">
          <h3 class="fs-5 fw-semibold mb-3">Enlaces Rápidos</h3>
          <ul class="list-unstyled">
            <li class="mb-2"><a href="#" class="text-muted text-decoration-none">Inicio</a></li>
            <li class="mb-2"><a href="#" class="text-muted text-decoration-none">Nosotros</a></li>
            <li class="mb-2"><a href="#" class="text-muted text-decoration-none">Publicaciones</a></li>
            <li class="mb-2"><a href="#" class="text-muted text-decoration-none">Eventos</a></li>
            <li class="mb-2"><a href="#" class="text-muted text-decoration-none">Documentos</a></li>
            <li class="mb-2"><a href="#" class="text-muted text-decoration-none">Directorio</a></li>
            <li class="mb-2"><a href="#" class="text-muted text-decoration-none">Contacto</a></li>
          </ul>
        </div>
        
        <!-- Column 3 - Services -->
        <div class="col-lg-3 col-md-6">
          <h3 class="fs-5 fw-semibold mb-3">Servicios</h3>
          <ul class="list-unstyled">
            <li class="mb-2"><a href="#" class="text-muted text-decoration-none">Financiamiento de Proyectos</a></li>
            <li class="mb-2"><a href="#" class="text-muted text-decoration-none">Publicación de Investigaciones</a></li>
            <li class="mb-2"><a href="#" class="text-muted text-decoration-none">Becas Académicas</a></li>
            <li class="mb-2"><a href="#" class="text-muted text-decoration-none">Apoyo a Eventos Científicos</a></li>
