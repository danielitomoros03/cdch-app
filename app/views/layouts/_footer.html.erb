<footer class="main-footer">
  <div class="container">
    <div class="row g-4 mb-4">
      <!-- Column 1 - About -->
      <div class="col-md-6 col-lg-3">
        <div class="footer-brand mb-3">
          <div class="footer-logo-circle">
            <span>
              <%= image_tag("Logo-CDCH.png") %>
            </span>
          </div>
          <div class="footer-logo-text">
            <div class="footer-logo-title">CDCH - UCV</div>
            <div class="footer-logo-subtitle">Vicerectorado académico</div>
            <div class="footer-logo-subtitle">Universidad Central de Venezuela</div>
          </div>
        </div>
        <p class="footer-description">
          Promoviendo la excelencia en investigación científica y humanística desde 1958.
        </p>
        <div class="footer-social">
          <%= link_to "#{Institution.first.facebook_url}", class: "social-link" do %>
            <i class="fab fa-facebook-f"></i>
          <% end %>
          <%= link_to "#{Institution.first.twitter_url}", class: "social-link" do %>
            <i class="fab fa-twitter"></i>
          <% end %>
          <%= link_to "#{Institution.first.instagram_url}", class: "social-link" do %>
            <i class="fab fa-instagram"></i>
          <% end %>
          <%= link_to "#{Institution.first.linkedin_url}", class: "social-link" do %>
            <i class="fab fa-linkedin-in"></i>
          <% end %>
        </div>
      </div>

      <!-- Column 2 - Quick Links -->
      <div class="col-md-6 col-lg-3">
        <h5 class="footer-title">Enlaces Rápidos</h5>
        <ul class="footer-list">
        <li><%= link_to "Convocatorias", convocatorias_path %></li>
        <li><%= link_to "Actas del Directorio", actas_path %></li>
        <li><%= link_to "Saber UCV", "https://saber.ucv.ve/" %></li>
        <li><%= link_to "Nosotros", nosotros_path %></li>
        <li><%= link_to "Contacto", contacto_path %></li>
        </ul>
      </div>

      <!-- Column 3 - Services -->
      <div class="col-md-6 col-lg-3">
        <h5 class="footer-title">Servicios</h5>
        <ul class="footer-list">
          <li><%= link_to "Editorial CDCH", "#" %></li>
          <li><%= link_to "Apoyo Académico", "#" %></li>
          <li><%= link_to "Apoyo a la Investigación", "#" %></li>
          <li><%= link_to "Saber UCV", "#" %></li>
        </ul>
      </div>

      <!-- Column 4 - Contact -->
      <div class="col-md-6 col-lg-3">
        <h5 class="footer-title">Contacto</h5>
        <ul class="footer-contact">
          <li>
            <span>
              <i class="fas fa-map-marker-alt"></i>
              <%= Institution.first.address %>
            </span>
          </li>
          <li>
            <i class="fas fa-phone"></i>
            <span><%= Institution.first.primary_phone %></span>
          </li>
          <li>
            <i class="fas fa-envelope"></i>
            <span><%= Institution.first.primary_email %></span>
          </li>
        </ul>
        <div class="footer-hours">
          <div class="footer-hours-title">Horario de Atención</div>
          <div class="footer-hours-text">
            <%= Institution.first.business_hours %>
          </div>
        </div>
      </div>
    </div>

    <!-- Footer Bottom -->
    <div class="footer-bottom">
      <div class="row align-items-center">
        <div class="col-md-6 text-center text-md-start mb-3 mb-md-0">
          <p class="footer-copyright mb-0">
            © <%= Date.today.year %> CDCH - UCV. Todos los derechos reservados.
          </p>
        </div>
      </div>
    </div>
  </div>
</footer>
