<!-- Header/Navbar -->
<% if !signed_in? %>
    <header class="main-header sticky-top bg-white shadow-sm">
        <div class="container">
            <nav class="navbar navbar-expand-lg navbar-light py-3">
            <%= link_to root_path, class: "navbar-brand d-flex align-items-center gap-3" do %>
                <div class="logo-circle">
                <span>C</span>
                </div>
                <div class="logo-text">
                <div class="logo-title">CDCH</div>
                <div class="logo-subtitle">Universidad Central de Venezuela</div>
                </div>
            <% end %>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-lg-center">
                <li class="nav-item">
                    <%= link_to "Inicio", root_path, class: "nav-link" %>
                </li>
                <li class="nav-item">
                    <%= link_to "Nosotros", nosotros_path, class: "nav-link" %>
                </li>
                <li class="nav-item">
                    <%= link_to "Investigación", investigacion_path, class: "nav-link" %>
                </li>
                <li class="nav-item">
                    <%= link_to "Publicaciones", publicaciones_path, class: "nav-link" %>
                </li>
                <li class="nav-item">
                    <%= link_to "Convocatorias", convocatorias_path, class: "nav-link" %>
                </li>
                <li class="nav-item">
                    <%= link_to "Contacto", contacto_path, class: "nav-link" %>
                </li>
                <li class="nav-item ms-lg-2">
                    <button class="btn btn-link nav-link p-2" data-bs-toggle="modal" data-bs-target="#searchModal">
                    <i class="fas fa-search"></i>
                    </button>
                </li>
                </ul>
            </div>
            </nav>
        </div>
    </header>
<% else %>

<% end %>