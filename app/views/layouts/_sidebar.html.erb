<nav class="dashboard-nav" aria-label="Menú del panel">
  <ul class="dashboard-nav__list">
    <%= sidebar_link "Inicio", dashboard_index_path, icon: "fa-tachometer-alt", sections: "dashboard" %>
  </ul>

  <% if can?(:read, Call) || can?(:read, Minute) || can?(:read, Publication) || can?(:read, Event) %>
    <div class="dashboard-nav__heading">Contenidos</div>
    <ul class="dashboard-nav__list">
      <%= sidebar_link "Convocatorias", calls_path, icon: "fa-bell", sections: "calls" if can? :read, Call %>
      <%= sidebar_link "Actas del Directorio", minutes_path, icon: "fa-box-open", sections: "minutes" if can? :read, Minute %>
      <%= sidebar_link "Publicaciones", publications_path, icon: "fa-book", sections: "publications" if can? :read, Publication %>
      <%= sidebar_link "Eventos y Noticias", events_path, icon: "fa-newspaper", sections: "events" if can? :read, Event %>
    </ul>
  <% end %>

  <% if can? :read, Person %>
    <div class="dashboard-nav__heading">Investigación</div>
    <ul class="dashboard-nav__list">
      <%= sidebar_link "Docentes e investigadores", people_path, icon: "fa-user-graduate", sections: %w[people research_projects] %>
    </ul>
  <% end %>

  <div class="dashboard-nav__heading">General</div>
  <ul class="dashboard-nav__list">
    <%= sidebar_link "Solicitudes", solicitudes_path, icon: "fa-envelope", sections: "solicitudes" %>
    <%= sidebar_link "Usuarios", users_path, icon: "fa-user", sections: "users" %>
    <%= sidebar_link "Departamentos", departments_path, icon: "fa-building", sections: "departments" %>
    <%= sidebar_link "General CDCH", institutions_path, icon: "fa-address-book", sections: "institutions" %>
    <%= sidebar_link "Autoridades CDCH", institution_leaderships_path, icon: "fa-user-tie", sections: "institution_leaderships" if can? :read, InstitutionLeadership %>
    <%= sidebar_link "Configuración general", general_setup_path, icon: "fa-sliders-h", sections: "general_setups" if can? :read, GeneralSetup %>
  </ul>
</nav>

<button type="button" class="dashboard-nav__toggle d-none d-lg-flex" data-action="sidebar#toggle"
        data-sidebar-target="toggle" aria-expanded="<%= !sidebar_collapsed? %>" aria-controls="dashboardSidebar">
  <i class="fas fa-fw fa-angle-double-left" aria-hidden="true"></i>
  <span class="dashboard-nav__label">Contraer menú</span>
</button>
