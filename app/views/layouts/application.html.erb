<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "CDCH - UCV" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="https://firebasestorage.googleapis.com/v0/b/morosphotography-26b5a.appspot.com/o/Logo%20CDCH%20sin%20fondo.png?alt=media&token=d87cb207-0847-4621-bcec-760895058c6d" type="image/Logo-CDCH-sin-fondo.png">
    <link rel="icon" href="https://firebasestorage.googleapis.com/v0/b/morosphotography-26b5a.appspot.com/o/Logo%20CDCH%20sin%20fondo.png?alt=media&token=d87cb207-0847-4621-bcec-760895058c6d" type="image/svg+xml">
    <link rel="apple-touch-icon" href="https://firebasestorage.googleapis.com/v0/b/morosphotography-26b5a.appspot.com/o/Logo%20CDCH%20sin%20fondo.png?alt=media&token=d87cb207-0847-4621-bcec-760895058c6d">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <%= javascript_importmap_tags %>
  </head>

  <body>
  <!--
    <div>
      <% if signed_in? %>
        <%= link_to "Salir", destroy_user_session_path, method: :delete %>
      <% else %>
        <%= link_to "Ingresar", new_user_session_path %>
      <% end %>
    </div>
  -->
    <%= yield %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
