<!-- CONTACTO - LANDING PAGE -->
<%= render "layouts/header" %>

<!-- Page Header -->
<div class="page-header">
  <div class="container">
    <h1 class="page-title">Contacto</h1>
    <p class="page-subtitle">
      Estamos aquí para ayudarte. Contáctanos por cualquiera de estos medios
    </p>
  </div>
</div>

<!-- Contact Section -->
<section class="section">
  <div class="container">
    <div class="row g-5">
      <!-- Contact Info -->
      <div class="col-lg-4">
        <div class="contact-info-section">
          <h3 class="mb-4">Información de Contacto</h3>
          
          <div class="contact-item">
            <div class="contact-icon">
              <i class="fas fa-map-marker-alt"></i>
            </div>
            <div class="contact-details">
              <h4>Dirección</h4>
              <p>
                <%= Institution.first.address %>
              </p>
            </div>
          </div>

          <div class="contact-item">
            <div class="contact-icon">
              <i class="fas fa-phone"></i>
            </div>
            <div class="contact-details">
              <h4>Teléfono</h4>
              <p><%= Institution.first.primary_phone %><br><%= Institution.first.secondary_phone %></p>
            </div>
          </div>

          <div class="contact-item">
            <div class="contact-icon">
              <i class="fas fa-envelope"></i>
            </div>
            <div class="contact-details">
              <h4>Correos</h4>
              <p>
                <%= Institution.first.primary_email %><br>
                <%= Institution.first.secondary_email %>
              </p>
            </div>
          </div>

          <div class="contact-item">
            <div class="contact-icon">
              <i class="fas fa-clock"></i>
            </div>
            <div class="contact-details">
              <h4>Horario de Atención</h4>
              <p>
                <%= Institution.first.business_hours %>
              </p>
            </div>
          </div>

          <div class="social-links mt-4">
            <h4 class="mb-3">Síguenos</h4>
            <div class="d-flex gap-3">
              <%= link_to "#{Institution.first.facebook_url}", class: "social-icon" do %>
                <i class="fab fa-facebook-f"></i>
              <% end %>
              <%= link_to "#{Institution.first.twitter_url}", class: "social-icon" do %>
                <i class="fab fa-twitter"></i>
              <% end %>
              <%= link_to "#{Institution.first.instagram_url}", class: "social-icon" do %>
                <i class="fab fa-instagram"></i>
              <% end %>
              <%= link_to "#{Institution.first.linkedin_url}", class: "social-icon" do %>
                <i class="fab fa-linkedin-in"></i>
              <% end %>
            </div>
          </div>
        </div>
      </div>


      <!-- Contact Form -->
      <div class="col-lg-8">
        <!-- Flash messages -->
        <% if notice %>
          <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i><%= notice %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
          </div>
        <% end %>
        <div class="contact-form-section">
          <h3 class="mb-4">Envíanos un Mensaje</h3>
          <%= render "dashboard/solicitudes/form", solicitude: Solicitude.new, url: solicitudes_path %>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Map Section -->
<section class="map-section">
  <div class="container py-5">
    <div class="map-placeholder">
      <iframe 
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3923.086901746221!2d-66.84784372636905!3d10.493815564345823!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8c2a59e58fec289b%3A0x9de7788d118a3a90!2sCDCH%20-%20UCV%20Consejo%20de%20Desarrollo%20Cient%C3%ADfico%20y%20Humanistico!5e0!3m2!1ses!2sve!4v1761060687814!5m2!1ses!2sve"
        allowfullscreen="" 
        loading="lazy">
      </iframe>
    </div>
  </div>
</section>


<%#= render "layouts/counter" %>
<%= render "layouts/CTA_section" %>
<%= render "layouts/footer" %>