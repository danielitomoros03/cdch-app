<!-- CONVOCATORIAS - LANDING PAGE -->
<%= render "layouts/top_bar" %>
<%= render "layouts/header" %>

<!-- Page Header -->
<div class="page-header">
  <div class="container">
    <h1 class="page-title">Convocatorias</h1>
    <p class="page-subtitle">
      Oportunidades de financiamiento para proyectos de investigación
    </p>
  </div>
</div>

<!-- Active Calls -->
<section class="section">
  <div class="container">
    <div class="mb-5">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="section-title mb-0">Convocatorias Activas</h2>
        <span class="badge bg-success fs-6">3 Abiertas</span>
      </div>
    </div>

    <div class="row g-4">
      <!-- Call Card 1 -->
      <div class="col-lg-12">
        <div class="call-card call-card-active">
          <div class="call-status">
            <span class="badge bg-success">Abierta</span>
          </div>
          <div class="row">
            <div class="col-lg-8">
              <h3 class="call-title">Convocatoria 2025 - Proyectos Individuales</h3>
              <p class="call-description">
                Financiamiento para proyectos de investigación individuales en todas las áreas 
                del conocimiento. Monto máximo: Bs. 50.000
              </p>
              <div class="call-meta">
                <span><i class="fas fa-calendar"></i> Apertura: 1 de Marzo, 2025</span>
                <span><i class="fas fa-clock"></i> Cierre: 30 de Abril, 2025</span>
                <span><i class="fas fa-users"></i> Investigadores UCV</span>
              </div>
            </div>
            <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
              <div class="call-countdown mb-3">
                <div class="countdown-label">Tiempo restante</div>
                <div class="countdown-value">45 días</div>
              </div>
              <%= link_to "#", class: "btn btn-primary-custom d-block d-lg-inline-block" do %>
                Ver detalles
              <% end %>
            </div>
          </div>
        </div>
      </div>

      <!-- Call Card 2 -->
      <div class="col-lg-12">
        <div class="call-card call-card-active">
          <div class="call-status">
            <span class="badge bg-success">Abierta</span>
          </div>
          <div class="row">
            <div class="col-lg-8">
              <h3 class="call-title">Convocatoria 2025 - Proyectos Grupales</h3>
              <p class="call-description">
                Financiamiento para proyectos de investigación grupales con impacto interdisciplinario. 
                Monto máximo: Bs. 150.000
              </p>
              <div class="call-meta">
                <span><i class="fas fa-calendar"></i> Apertura: 1 de Marzo, 2025</span>
                <span><i class="fas fa-clock"></i> Cierre: 30 de Abril, 2025</span>
                <span><i class="fas fa-users"></i> Grupos de investigación</span>
              </div>
            </div>
            <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
              <div class="call-countdown mb-3">
                <div class="countdown-label">Tiempo restante</div>
                <div class="countdown-value">45 días</div>
              </div>
              <%= link_to "#", class: "btn btn-primary-custom d-block d-lg-inline-block" do %>
                Ver detalles
              <% end %>
            </div>
          </div>
        </div>
      </div>

      <!-- Call Card 3 -->
      <div class="col-lg-12">
        <div class="call-card call-card-active">
          <div class="call-status">
            <span class="badge bg-success">Abierta</span>
          </div>
          <div class="row">
            <div class="col-lg-8">
              <h3 class="call-title">Apoyo a Publicaciones Científicas</h3>
              <p class="call-description">
                Financiamiento para la publicación de libros y artículos en revistas indexadas. 
                Monto máximo: Bs. 30.000
              </p>
              <div class="call-meta">
                <span><i class="fas fa-calendar"></i> Apertura: 15 de Febrero, 2025</span>
                <span><i class="fas fa-clock"></i> Cierre: 15 de Mayo, 2025</span>
                <span><i class="fas fa-users"></i> Investigadores y docentes</span>
              </div>
            </div>
            <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
              <div class="call-countdown mb-3">
                <div class="countdown-label">Tiempo restante</div>
                <div class="countdown-value">68 días</div>
              </div>
              <%= link_to "#", class: "btn btn-primary-custom d-block d-lg-inline-block" do %>
                Ver detalles
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Closed Calls -->
<section class="section section-light">
  <div class="container">
    <h2 class="section-title mb-4">Convocatorias Cerradas</h2>
    
    <div class="row g-4">
      <!-- Closed Call 1 -->
      <div class="col-lg-6">
        <div class="call-card call-card-closed">
          <div class="call-status">
            <span class="badge bg-secondary">Cerrada</span>
          </div>
          <h3 class="call-title">Convocatoria 2024 - Proyectos Emergentes</h3>
          <p class="call-description">
            Proyectos de investigación sobre temas de relevancia nacional e internacional.
          </p>
          <div class="call-meta">
            <span><i class="fas fa-calendar"></i> Cerró: 31 de Diciembre, 2024</span>
          </div>
        </div>
      </div>

      <!-- Closed Call 2 -->
      <div class="col-lg-6">
        <div class="call-card call-card-closed">
          <div class="call-status">
            <span class="badge bg-secondary">Cerrada</span>
          </div>
          <h3 class="call-title">Becas de Investigación 2024</h3>
          <p class="call-description">
            Apoyo económico para estudiantes de postgrado realizando investigación.
          </p>
          <div class="call-meta">
            <span><i class="fas fa-calendar"></i> Cerró: 15 de Noviembre, 2024</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<%= render "layouts/counter" %>
<%= render "layouts/CTA_section" %>
<%= render "layouts/footer" %>