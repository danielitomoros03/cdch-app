<!-- DEPARTAMENTO - LANDING PAGE -->
<%= render "layouts/header" %>

<!-- Page Header -->
<div class="page-header">
  <div class="container">
    <h1 class="page-title"><%= @department.name %></h1>
    <p class="page-subtitle">
      <%= @department.acronym %>
    </p>
  </div>
</div>

<!-- Department Description Section -->
<section class="section">
  <div class="container">
    <div class="row align-items-center g-5">
      <div class="col-lg-6">
        <h2 class="section-title mb-2">Descripción General de <%= @department.acronym %></h2>
        <%= @department.description %>
      </div>
      <div class="col-lg-6 mt-3">
        <% if @department.logoDepartment.attached? %>
          <%= image_tag @department.logoDepartment, class: "about-image-placeholder rounded", alt: "Logo de #{@department.acronym}" %>
        <% else %>
          <%= image_tag "#{@department.acronym}.png", class: "about-image-placeholder rounded", alt: "Logo por defecto CDCH" %>
        <% end %>
      </div>
    </div>
  </div>
</section>

<!-- Department Members Section -->
<section class="updates-section">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">Integrantes de <%= @department.acronym %></h2>
    </div>

    <div class="row g-4">
      <!-- Member Card 1 -->
      <div class="col-md-6 col-lg-3">
        <article class="update-card">
          <div class="update-image update-image-white">
            <% if @department.logoDepartment.attached? %>
              <%= image_tag @department.logoDepartment, class: "about-image-placeholder rounded", alt: "Logo de #{@department.acronym}" %>
            <% else %>
              <%= image_tag "#{@department.acronym}.png", class: "about-image-placeholder rounded", style: "transform: scale(1.2);", alt: "Logo por defecto CDCH" %>
            <% end %>
          </div>
          <div class="update-content">
            <div class="update-date">Jefe de Departamento</div>
            <h3 class="update-title"><%= @jefe&.full_name || "Sin jefe asignado" %></h3>
            <!--<p class="update-excerpt"></p>-->
          </div>
        </article>
      </div>

      <!-- Members Cards -->
      <% @others.each do |u| %>
        <div class="col-md-6 col-lg-3">
          <article class="update-card">
            <div class="update-image update-image-blue"></div>
            <div class="update-content">
              <div class="update-date"><%= u.job_title.name  %></div>
              <h3 class="update-title"><%= u.full_name %></h3>
              <!-- <p class="update-excerpt"></p> -->
            </div>
          </article>
        </div>
      <% end %>
    </div>
  </div>
</section>

<%#= render "layouts/counter" %>
<%= render "layouts/CTA_section" %>
<%= render "layouts/footer" %>