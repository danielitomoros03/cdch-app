<!-- DEPARTAMENTOS - LANDING PAGE -->
<%= render "layouts/header" %>

<!-- Page Header -->
<div class="page-header">
  <div class="container">
    <h1 class="page-title">Departamentos</h1>
    <p class="page-subtitle">
      Conoce los departamentos del CDCH y sus funciones
    </p>
  </div>
</div>

<!-- Departments Section -->
<section class="updates-section">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">Noticias y Eventos</h2>
      <%= link_to "#", class: "section-link" do %>
        Ver todas <i class="fas fa-chevron-right ms-1"></i>
      <% end %>
    </div>

    <div class="row g-4">
      <!-- Update Card 1 -->
      <div class="col-md-6 col-lg-3">
        <article class="update-card">
          <div class="update-image update-image-blue"></div>
          <div class="update-content">
            <div class="update-date">15 de Marzo, 2025</div>
            <h3 class="update-title">Convocatoria 2025: Proyectos de Investigación</h3>
            <p class="update-excerpt">
              Abierta la convocatoria para financiamiento de proyectos de investigación individuales y grupales.
            </p>
          </div>
        </article>
      </div>

      <!-- Update Card 2 -->
      <div class="col-md-6 col-lg-3">
        <article class="update-card">
          <div class="update-image update-image-green"></div>
