<!-- DIRECTION - LANDING PAGE -->
<%= render "layouts/header" %>

<!-- Page Header -->
<!--  -->
<div class="page-header">
  <div class="container">
    <h1 class="page-title">Dirección del CDCH<h1>
    <p class="page-subtitle">
    </p>
  </div>
</div>

<!-- Direction Description Section -->
<section class="section">
  <div class="container">
    <div class="row align-items-center g-5">
      <div class="col-lg-6">
        <h2 class="section-title mb-2">Descripción General de la Dirección</h2>
        <%= @direction.description %>
      </div>
      <div class="col-lg-6 mt-3">
        <%= image_tag "Logo-CDCH-Vitral.png", class: "about-image-placeholder rounded", alt: "Logo de Dirección CDCH" %>
      </div>
    </div>
  </div>
</section>

<!-- Direction Members Section -->
<section class="updates-section">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">Integrantes de la Dirección</h2>
    </div>

    <div class="row g-4">
      <!-- Member Card 1 - Only Director -->
      <div class="col-md-6 col-lg-3">
        <article class="update-card update-card-photo-bg">
          <div class="update-image update-image-blue">
            <% if @direction.send_director&.photoUser&.attached? %>
              <%= image_tag @direction.send_director.photoUser, alt: @direction.send_director.full_name %>
            <% else %>
              <%= image_tag "Logo-CDCH-Vitral.png", alt: "Imagen por defecto" %>
            <% end %>
          </div>
          <div class="update-content">
            <div class="update-date">Director(a)</div>
            <h3 class="update-title"><%= @direction.send_director&.full_name || "Sin director(a) asignado" %></h3>
            <!-- <p class="update-excerpt"></p> -->
          </div>
        </article>
      </div>

      <!-- Members Cards -->
      <% @other_users.each do |u| %>
        <div class="col-md-6 col-lg-3">
          <article class="update-card update-card-photo-bg">
            <div class="update-image update-image-blue">
              <% if u.photoUser.attached? %>
                <%= image_tag u.photoUser, alt: u.full_name %>
              <% else %>
                <%= image_tag "Logo-CDCH-Vitral.png", alt: "Imagen por defecto" %>
              <% end %>
            </div>
            <div class="update-content">
              <div class="update-date"><%= u.job_title.name  %></div>
              <h3 class="update-title"><%= u.full_name %></h3>
              <!-- <p class="update-excerpt"></p> -->
            </div>
          </article>
        </div>
      <% end %>

      <!-- Support Staff Card -->
      <div class="col-md-6 col-lg-3">
        <article
          class="update-card h-100"
          role="button"
          tabindex="0"
          data-bs-toggle="modal"
          data-bs-target="#supportStaffModal"
          aria-controls="supportStaffModal"
          style="cursor: pointer;"
        >
          <div class="update-image update-image-green d-flex align-items-center justify-content-center">
            <span class="text-white fw-bold text-center px-3">Personal de apoyo adscrito a la Dirección del CDCH</span>
          </div>
          <div class="update-content">
            <!--<div class="update-date">Subdivisión de Dirección</div>-->
            <h3 class="update-title">Seguridad y Mantenimiento</h3>
            <p class="update-excerpt mb-0">Haz clic para ver sus integrantes.</p>
          </div>
        </article>
      </div>
    </div>
  </div>
</section>

<!-- Support Staff Modal -->
<div class="modal fade" id="supportStaffModal" tabindex="-1" aria-labelledby="supportStaffModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="supportStaffModalLabel">Seguridad y Mantenimiento</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
      </div>
      <div class="modal-body">
        <% if @support_staff.any? %>
          <p class="text-muted mb-3">Integrantes adscritos a la subdivisión de la Dirección del CDCH.</p>
          <div class="updates-section p-0 support-staff-modal-section" style="background: none; color: inherit;">
            <div class="row g-3 support-staff-grid">
              <% @support_staff.each do |staff| %>
                <div class="col-6 col-md-4 col-lg-3">
                  <article class="update-card update-card-photo-bg support-staff-mini-card">
                    <div class="update-image update-image-blue">
                      <% if staff.photoUser.attached? %>
                        <%= image_tag staff.photoUser, alt: staff.full_name, style: "width: 100%; height: 100%; object-fit: cover;" %>
                      <% else %>
                        <%= image_tag "Logo-CDCH-Vitral.png", alt: "Logo CDCH", style: "width: 100%; height: 100%; object-fit: cover;" %>
                      <% end %>
                    </div>
                    <div class="update-content">
                      <div class="update-date"><%= staff.job_title.name %></div>
                      <h3 class="update-title mb-0"><%= staff.full_name %></h3>
                    </div>
                  </article>
                </div>
              <% end %>
            </div>
          </div>
        <% else %>
          <p class="mb-0">No hay personal de vigilancia o limpieza registrado actualmente.</p>
        <% end %>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Cerrar</button>
      </div>
    </div>
  </div>
</div>

<%#= render "layouts/counter" %>
<%= render "layouts/CTA_section" %>
<%= render "layouts/footer" %>