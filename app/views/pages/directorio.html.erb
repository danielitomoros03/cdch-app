<!-- Actas Grid -->
<section class="section">
  <div class="container">
    <div class="row g-4">
      <% @minutes.each do |minute| %>
        <div class="col-md-6 col-lg-3">
          <article class="publication-card">
            <div class="publication-cover publication-cover-blue">
              <% if minute.attachment_minute.attached? && minute.attachment_minute.content_type == "application/pdf" %>
                <div class="publication-preview-frame" aria-hidden="true">
                  <object
                    class="publication-preview"
                    data="<%= rails_blob_path(minute.attachment_minute, disposition: "inline") %>"
                    type="application/pdf"
                    aria-label="Previsualizacion del acta">
                    <span class="publication-preview-fallback">
                      Previsualizacion no disponible
                    </span>
                  </object>
                </div>
              <% end %>
              <div class="publication-type">Acta</div>
            </div>
            <div class="publication-content">
              <h3 class="publication-title"><%= minute.title %></h3>
              <p class="publication-author">CDCH - UCV</p>
              <p class="publication-year"><%= l(minute.day.to_date, format: :long) %></p>
              <p class="publication-excerpt">
                <%= minute.content.to_plain_text.truncate(100) if minute.content.present? %>
              </p>
              <%= link_to acta_path(minute), class: "btn btn-sm btn-primary" do %>
                Ver acta completa
              <% end %>
            </div>
          </article>
        </div>
      <% end %>
    </div>

    <!-- Pagination -->
    <div class="mt-4 d-flex justify-content-center">
      <nav aria-label="Page navigation">
        <%= will_paginate @minutes, class: "pagination" %>
      </nav>
    </div>
  </div>
</section>

<%#= render "layouts/counter" %>
<%= render "layouts/CTA_section" %>
<%= render "layouts/footer" %>
