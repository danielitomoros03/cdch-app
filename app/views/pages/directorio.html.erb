<!-- ACTAS DEL DIRECTORIO - LANDING PAGE -->
<%= render "layouts/header" %>

<!-- Page Header -->
<div class="page-header">
  <div class="container">
    <h1 class="page-title">Actas de Directorio</h1>
    <p class="page-subtitle">
      Consulta las actas de las reuniones de directorio del CDCH
    </p>
  </div>
</div>

<!-- Filters -->
<section class="py-4 bg-light">
  <div class="container">
    <div class="row align-items-center">
      <div class="col-md-8">
        <div class="input-group">
          <span class="input-group-text">
            <i class="fas fa-search"></i>
          </span>
          <input type="text" class="form-control" placeholder="Buscar actas...">
        </div>
      </div>
      <div class="col-md-4 mt-3 mt-md-0">
        <select class="form-select">
          <option>Todas las actas</option>
          <option>2024</option>
          <option>2023</option>
          <option>2022</option>
        </select>
      </div>
    </div>
  </div>
</section>

<!-- Actas Grid -->
<section class="section">
  <div class="container">
    <div class="row g-4">
      <!-- Acta Card 1 -->
      <div class="col-md-6 col-lg-3">
        <article class="publication-card">
          <div class="publication-cover publication-cover-blue">
            <div class="publication-type">Acta</div>
          </div>
          <div class="publication-content">
            <h3 class="publication-title">Acta de Directorio - Reunión Ordinaria</h3>
            <p class="publication-author">CDCH - UCV</p>
            <p class="publication-year">15 de enero, 2024</p>
            <p class="publication-excerpt">
              Acta correspondiente a la reunión ordinaria del directorio celebrada el 15 de enero de 2024.
            </p>
            <%= link_to "#", class: "btn btn-sm btn-primary-custom" do %>
              Ver acta completa
            <% end %>
          </div>
        </article>
      </div>

      <!-- Acta Card 2 -->
