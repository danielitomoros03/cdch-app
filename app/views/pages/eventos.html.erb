<!-- Upcoming Events -->
<section class="section py-5">
  <div class="container">
    <h2 class="section-title mb-4">Próximos Eventos</h2>
    
    <div class="row g-4">
      <% if @eventsActive.present? %>
        <% @eventsActive.each do |event| %>
          <div class="col-lg-6">
            <div class="event-card h-100">
              <div class="event-date-badge">
                <div class="event-day"><%= event.day&.strftime("%d/%m/%Y") || "No definida" %></div>
              </div>
              <div class="event-content">
                <%# Usamos .titleize o .humanize para que el enum se vea bien %>
                <span class="event-kind"><%= event.kind&.titleize || "Sin categoría" %></span>
                <h3 class="event-title"><%= event.title %></h3>
                <p class="event-description">
                  <%= event.description %>
                </p>
                <div class="event-info">
                  <span><i class="far fa-clock"></i>Inicio: <%= event.start_time&.strftime("%H:%M") || "No definida" %> </span>
                  <span><i class="fas fa-clock"></i>Cierre: <%= event.end_time&.strftime("%H:%M") || "No definida" %></span>
                  <span><i class="fas fa-map-marker-alt"></i> <%= event.location %></span>
                </div>
                <div class="mt-3">
                  <%= link_to "Ver detalles", event_path(event), class: "btn btn-sm btn-outline-primary" %>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      <% else %>
        <%# Sección de Placeholder / Datos de ejemplo %>
        <div class="col-lg-6">
          <div class="event-card h-100">
            <div class="event-date-badge">
              <div class="event-day">25</div>
              <div class="event-month">MAR</div>
            </div>
            <div class="event-content">
              <span class="event-category">Conferencia</span>
              <h3 class="event-title">Inteligencia Artificial en la Investigación Científica</h3>
              <p class="event-description">Conferencia magistral sobre las aplicaciones de IA en metodología de investigación.</p>
              <div class="event-info">
                <span><i class="fas fa-clock"></i> 10:00 AM - 12:00 PM</span>
                <span><i class="fas fa-map-marker-alt"></i> Auditorio Principal</span>
              </div>
              <div class="mt-3">
                <%= link_to "Registrarse", "#", class: "btn btn-sm btn-primary-custom me-2" %>
                <%= link_to "Ver detalles", "#", class: "btn btn-sm btn-outline-custom" %>
              </div>
            </div>
          </div>
        </div>

        <div class="col-lg-6">
          <div class="event-card h-100">
            <div class="event-date-badge event-date-badge-green">
              <div class="event-day">28</div>
              <div class="event-month">MAR</div>
            </div>
            <div class="event-content">
              <span class="event-category">Taller</span>
              <h3 class="event-title">Metodología de la Investigación Cualitativa</h3>
              <p class="event-description">Taller práctico sobre técnicas y herramientas para investigación cualitativa.</p>
              <div class="event-info">
                <span><i class="fas fa-clock"></i> 2:00 PM - 5:00 PM</span>
                <span><i class="fas fa-map-marker-alt"></i> Sala de Conferencias</span>
              </div>
              <div class="mt-3">
                <%= link_to "Registrarse", "#", class: "btn btn-sm btn-primary-custom me-2" %>
                <%= link_to "Ver detalles", "#", class: "btn btn-sm btn-outline-custom" %>
              </div>
            </div>
          </div>
        </div>
        <%# Agrega más placeholders si lo deseas aquí, siempre dentro de un col-lg-6 %>
      <% end %>
    </div>
  </div>
</section>

<!-- Past Events -->
<section class="section section-light">
  <div class="container">
    <h2 class="section-title mb-4">Eventos Pasados</h2>
    
    <div class="row g-4">
      <% if @eventsInactive.present? %>
        <% @eventsInactive.each do |event| %>
          <div class="col-md-6 col-lg-3">
            <div class="past-event-card">
              <div class="past-event-date">
                <%= event.day&.strftime("%d/%m/%Y") || "No definida" %>
              </div>
              <h4 class="past-event-title">
                <%= event.title %>
              </h4>
              <%= link_to "Ver resumen", evento_path(event), class: "text-primary" %>
            </div>
          </div>
        <% end %>
      <% else %>
        <!-- Placeholder Past Events -->
        <div class="col-md-6 col-lg-3">
          <div class="past-event-card">
            <div class="past-event-date">15 Feb 2025</div>
            <h4 class="past-event-title">Taller de Redacción Científica</h4>
            <%= link_to "Ver resumen", "#", class: "text-primary" %>
          </div>
        </div>
        <div class="col-md-6 col-lg-3">
          <div class="past-event-card">
            <div class="past-event-date">8 Feb 2025</div>
            <h4 class="past-event-title">Conferencia: Cambio Climático</h4>
            <%= link_to "Ver resumen", "#", class: "text-primary" %>
          </div>
        </div>
        <div class="col-md-6 col-lg-3">
          <div class="past-event-card">
            <div class="past-event-date">1 Feb 2025</div>
            <h4 class="past-event-title">Seminario de Estadística</h4>
            <%= link_to "Ver resumen", "#", class: "text-primary" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>


