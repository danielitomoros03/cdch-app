<!-- LEADERSHIP GALLERY - LANDING PAGE -->
<%= render "layouts/header" %>

<div class="page-header">
  <div class="container">
    <h1 class="page-title">Galería de Autoridades</h1>
    <p class="page-subtitle">
      Recorrido histórico de Directores y Subdirectores del CDCH
    </p>
  </div>
</div>

<section class="section">
  <div class="container">
    <div class="leadership-gallery-header d-flex flex-wrap gap-3 align-items-center justify-content-between mb-4">
      <h2 class="section-title mb-0">Histórico de Autoridades</h2>
      <%= link_to nosotros_path, class: "btn btn-outline-primary" do %>
        <i class="fas fa-arrow-left me-2"></i>Volver a Nosotros
      <% end %>
    </div>

    <% if @institution.blank? %>
      <div class="card border-0 shadow-sm">
        <div class="card-body p-4 text-center">
          <p class="text-muted mb-0">No hay información institucional registrada.</p>
        </div>
      </div>
    <% end %>

    <div class="leadership-gallery-block mb-5">
      <h3 class="leadership-gallery-block__title">Directores</h3>
      <% if @directors.any? %>
        <div class="row g-4">
          <% @directors.each do |authority| %>
            <div class="col-6 col-md-4 col-lg-3">
              <article class="leadership-card">
                <div class="leadership-card__image">
                  <% if authority.photo.attached? %>
                    <%= image_tag authority.photo, alt: authority.full_name %>
                  <% else %>
                    <%= image_tag "Logo-CDCH-Vitral.png", alt: "Imagen por defecto" %>
                  <% end %>
                </div>
                <div class="leadership-card__body">
                  <div class="leadership-card__period"><%= authority.period_label %></div>
                  <h4 class="leadership-card__name"><%= authority.full_name %></h4>
                  <% if authority.rich_text_bio&.body&.to_plain_text.present? %>
                    <p class="leadership-card__bio"><%= truncate(authority.rich_text_bio.body.to_plain_text, length: 110) %></p>
                  <% end %>
                </div>
              </article>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="card border-0 shadow-sm">
          <div class="card-body p-3">
            <p class="text-muted mb-0">No hay directores registrados en la galería.</p>
          </div>
        </div>
      <% end %>
    </div>

    <div class="leadership-gallery-block mb-2">
      <h3 class="leadership-gallery-block__title">Subdirectores</h3>
      <% if @subdirectors.any? %>
        <div class="row g-4">
          <% @subdirectors.each do |authority| %>
            <div class="col-6 col-md-4 col-lg-3">
              <article class="leadership-card">
                <div class="leadership-card__image">
                  <% if authority.photo.attached? %>
                    <%= image_tag authority.photo, alt: authority.full_name %>
                  <% else %>
                    <%= image_tag "Logo-CDCH-Vitral.png", alt: "Imagen por defecto" %>
                  <% end %>
                </div>
                <div class="leadership-card__body">
                  <div class="leadership-card__period"><%= authority.period_label %></div>
                  <h4 class="leadership-card__name"><%= authority.full_name %></h4>
                  <% if authority.rich_text_bio&.body&.to_plain_text.present? %>
                    <p class="leadership-card__bio"><%= truncate(authority.rich_text_bio.body.to_plain_text, length: 110) %></p>
                  <% end %>
                </div>
              </article>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="card border-0 shadow-sm">
          <div class="card-body p-3">
            <p class="text-muted mb-0">No hay subdirectores registrados en la galería.</p>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>

<%= render "layouts/CTA_section" %>
<%= render "layouts/footer" %>
