<!-- LEADERSHIP GALLERY - LANDING PAGE -->
<%= render "layouts/header" %>

<div class="page-header">
  <div class="container">
    <h1 class="page-title">Galería de Autoridades</h1>
    <p class="page-subtitle">
      Recorrido histórico de Directores y Subdirectores del CDCH
    </p>
  </div>
</div>

<section class="section">
  <div class="container">
    <div class="leadership-gallery-header d-flex flex-wrap gap-3 align-items-center justify-content-between mb-4">
      <h2 class="section-title mb-0">Histórico de Autoridades</h2>
      <%= link_to nosotros_path, class: "btn btn-outline-primary" do %>
        <i class="fas fa-arrow-left me-2"></i>Volver a Nosotros
      <% end %>
    </div>

    <% if @institution.blank? %>
      <div class="card border-0 shadow-sm">
        <div class="card-body p-4 text-center">
          <p class="text-muted mb-0">No hay información institucional registrada.</p>
        </div>
      </div>
    <% else %>
      <% [["Directores", @directors, "director"], ["Subdirectores", @subdirectors, "subdirector"]].each do |section_title, authorities, role_key| %>
        <div class="leadership-timeline-section mb-5">
          <h3 class="leadership-gallery-block__title"><%= section_title %></h3>

          <% if authorities.any? %>
            <div class="leadership-timeline leadership-timeline--<%= role_key %>">
              <% authorities.each do |authority| %>
                <% detail_panel_id = "authorityDetail#{authority.id}" %>
                <% detail_label_id = "#{detail_panel_id}Label" %>

                <article class="timeline-authority-item">
                  <div class="timeline-authority-item__marker" aria-hidden="true"></div>

                  <div class="timeline-authority-item__content">
                    <button
                      type="button"
                      class="timeline-authority-card"
                      data-bs-toggle="offcanvas"
                      data-bs-target="#<%= detail_panel_id %>"
                      aria-controls="<%= detail_panel_id %>"
                    >
                      <div class="timeline-authority-card__period">
                        <i class="far fa-calendar-alt me-2"></i><%= authority.period_label %>
                      </div>
                      <div class="timeline-authority-card__main">
                        <div class="timeline-authority-card__image">
                          <% if authority.photo.attached? %>
                            <%= image_tag authority.photo, alt: authority.full_name %>
                          <% else %>
                            <%= image_tag "Logo-CDCH-Vitral.png", alt: "Imagen por defecto" %>
                          <% end %>
                        </div>
                        <div class="timeline-authority-card__text">
                          <h4 class="timeline-authority-card__name"><%= authority.full_name %></h4>
                          <p class="timeline-authority-card__role mb-1"><%= authority.role_label %></p>
                          <span class="timeline-authority-card__cta">Ver reseña completa</span>
                        </div>
                      </div>
                    </button>
                  </div>

                  <div class="offcanvas offcanvas-end leadership-offcanvas" tabindex="-1" id="<%= detail_panel_id %>" aria-labelledby="<%= detail_label_id %>">
                    <div class="offcanvas-header">
                      <h5 class="offcanvas-title" id="<%= detail_label_id %>"><%= authority.full_name %></h5>
                      <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Cerrar"></button>
                    </div>

                    <div class="offcanvas-body">
                      <div class="leadership-offcanvas__hero">
                        <div class="leadership-offcanvas__photo">
                          <% if authority.photo.attached? %>
                            <%= image_tag authority.photo, alt: authority.full_name %>
                          <% else %>
                            <%= image_tag "Logo-CDCH-Vitral.png", alt: "Imagen por defecto" %>
                          <% end %>
                        </div>
                        <div class="leadership-offcanvas__meta">
                          <div class="leadership-offcanvas__period"><%= authority.period_label %></div>
                          <p class="leadership-offcanvas__role mb-2"><%= authority.role_label %> del CDCH-UCV</p>
                          <% if authority.active? %>
                            <span class="badge text-bg-success">Autoridad actual</span>
                          <% else %>
                            <span class="badge text-bg-secondary">Período histórico</span>
                          <% end %>
                        </div>
                      </div>

                      <div class="leadership-offcanvas__bio mt-4">
                        <h6 class="leadership-offcanvas__section-title">
                          <i class="fas fa-book-reader me-2"></i>Reseña
                        </h6>

                        <% if authority.bio.body.present? %>
                          <div class="leadership-offcanvas__bio-content">
                            <%= authority.bio %>
                          </div>
                        <% else %>
                          <p class="text-muted mb-0">No hay reseña registrada para esta autoridad.</p>
                        <% end %>
                      </div>
                    </div>
                  </div>
                </article>
              <% end %>
            </div>
          <% else %>
            <div class="card border-0 shadow-sm">
              <div class="card-body p-3">
                <p class="text-muted mb-0">No hay <%= section_title.downcase %> registrados en la galería.</p>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>
</section>

<%= render "layouts/CTA_section" %>
<%= render "layouts/footer" %>
