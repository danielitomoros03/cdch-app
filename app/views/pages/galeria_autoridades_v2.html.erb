<% content_for :head do %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,400&display=swap" rel="stylesheet">
  <style>
    /* ── Design tokens ──────────────────────────────────────────── */
    :root {
      --dir:         #1d4ed8;
      --dir-dark:    #1e3a8a;
      --dir-light:   rgba(29,78,216,0.06);
      --dir-border:  rgba(29,78,216,0.3);
      --dir-glow:    rgba(29,78,216,0.16);
      --sub:         #0d9488;
      --sub-dark:    #0f766e;
      --sub-light:   rgba(13,148,136,0.06);
      --sub-border:  rgba(13,148,136,0.3);
      --sub-glow:    rgba(13,148,136,0.16);
      --amber:       #92400e;
      --text:        #1e293b;
      --muted:       #64748b;
      --bg:          #faf9f6;
      --card:        #ffffff;
      --radius:      1rem;
      --ff-display:  'Playfair Display', Georgia, 'Times New Roman', serif;
    }

    /* ── Section background ─────────────────────────────────────── */
    .ga-section { background: var(--bg); }

    /* ── Entrance animation ─────────────────────────────────────── */
    @keyframes gaFadeUp {
      from { opacity: 0; transform: translateY(12px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    /* ── Column headers (desktop only) ─────────────────────────── */
    .col-headers { display: none; }
    @media (min-width: 992px) {
      .col-headers {
        display: grid;
        grid-template-columns: minmax(0,1fr) 64px minmax(0,1fr);
        margin-bottom: 0.75rem;
      }
    }
    .col-label {
      font-family: var(--ff-display);
      font-style: italic;
      font-size: 1.1rem;
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 0.55rem;
      padding-bottom: 0.85rem;
      border-bottom: 2px solid;
      color: var(--muted);
    }
    .col-label--director    { color: var(--dir);  border-color: var(--dir-border); }
    .col-label--subdirector { color: var(--sub);  border-color: var(--sub-border); }
    .col-label--right       { justify-content: flex-end; text-align: right; }
    .label-pip {
      width: 8px; height: 8px;
      border-radius: 50%;
      flex-shrink: 0;
    }
    .label-pip--dir { background: var(--dir); }
    .label-pip--sub { background: var(--sub); }

    /* ── Dual timeline ──────────────────────────────────────────── */
    .dual-timeline { position: relative; }

    @media (min-width: 992px) {
      .dual-timeline::before {
        content: '';
        position: absolute;
        left: 50%; transform: translateX(-50%);
        top: 1.9rem; bottom: 0.8rem;
        width: 1px;
        background: linear-gradient(
          180deg,
          rgba(29,78,216,0.85) 0%,
          rgba(29,78,216,0.5)  38%,
          rgba(13,148,136,0.5) 62%,
          rgba(13,148,136,0.1) 100%
        );
        z-index: 0;
      }
    }

    /* ── Group row ──────────────────────────────────────────────── */
    .dt-group { margin-bottom: 1.5rem; }

    @media (max-width: 991px) {
      .dt-group { display: none; }
      .mob-list { display: block; }
    }
    @media (min-width: 992px) {
      .mob-list { display: none; }
      .dt-group {
        display: grid;
        grid-template-columns: minmax(0,1fr) 64px minmax(0,1fr);
        align-items: start;
        gap: 0;
        animation: gaFadeUp 0.5s ease both;
      }
    }

    .dt-left  { padding-right: 1.25rem; display: flex; flex-direction: column; gap: 0.8rem; }
    .dt-right { padding-left:  1.25rem; display: flex; flex-direction: column; gap: 0.8rem; }

    /* ── Spine ──────────────────────────────────────────────────── */
    .dt-spine {
      display: flex;
      flex-direction: column;
      align-items: center;
      padding-top: 1.45rem;
      position: relative;
      z-index: 1;
    }
    .dt-dot {
      width: 20px; height: 20px;
      border-radius: 50%;
      background: var(--bg);
      border: 2.5px solid;
      flex-shrink: 0;
    }
    .dt-dot--director    {
      border-color: var(--dir);
      box-shadow: 0 0 0 5px rgba(29,78,216,0.08);
    }
    .dt-dot--subdirector {
      border-color: var(--sub);
      box-shadow: 0 0 0 5px rgba(13,148,136,0.08);
    }
    .dt-dot--both {
      border-color: var(--dir);
      background: linear-gradient(135deg, #dbeafe 0%, #ccfbf1 100%);
      box-shadow: 0 0 0 5px rgba(29,78,216,0.07);
    }
    /* Horizontal connectors */
    .dt-spine::before, .dt-spine::after {
      content: '';
      position: absolute;
      top: calc(1.45rem + 9px);
      height: 1px;
      width: calc(50% - 10px);
    }
    .dt-spine::before { right: calc(50% + 10px); background: rgba(29,78,216,0.18); }
    .dt-spine::after  { left:  calc(50% + 10px); background: rgba(13,148,136,0.18); }
    .dt-group--no-left  .dt-spine::before { display: none; }
    .dt-group--no-right .dt-spine::after  { display: none; }

    /* Year label on spine */
    .dt-year {
      margin-top: 5px;
      font-size: 0.58rem;
      font-weight: 800;
      letter-spacing: 0.05em;
      text-align: center;
      line-height: 1;
      color: var(--muted);
      opacity: 0.75;
    }

    .dt-empty { min-height: 3rem; }

    /* ── Authority card ─────────────────────────────────────────── */
    .auth-card {
      background: var(--card);
      border: 1px solid rgba(15,23,42,0.07);
      border-radius: var(--radius);
      padding: 1rem 1.2rem;
      box-shadow:
        0 1px 2px rgba(15,23,42,0.04),
        0 4px 16px rgba(15,23,42,0.06);
      cursor: pointer;
      width: 100%;
      text-align: left;
      font: inherit;
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .auth-card:hover, .auth-card:focus-visible {
      outline: none;
      transform: translateY(-3px);
    }
    .auth-card--director {
      border-left: 4px solid var(--dir);
    }
    .auth-card--director:hover {
      box-shadow:
        0 2px 8px rgba(15,23,42,0.05),
        0 12px 32px var(--dir-glow);
    }
    .auth-card--subdirector {
      border-right: 4px solid var(--sub);
    }
    .auth-card--subdirector:hover {
      box-shadow:
        0 2px 8px rgba(15,23,42,0.05),
        0 12px 32px var(--sub-glow);
    }
    /* Mobile: flip subdirector to left border */
    @media (max-width: 991px) {
      .auth-card--subdirector {
        border-right: 1px solid rgba(15,23,42,0.07);
        border-left: 4px solid var(--sub);
      }
    }

    /* Period row */
    .auth-card__period {
      display: flex;
      align-items: center;
      gap: 0.35rem;
      font-size: 0.66rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--amber);
      margin-bottom: 0.65rem;
    }
    .auth-card__active-pip {
      width: 6px; height: 6px;
      border-radius: 50%;
      background: #22c55e;
      flex-shrink: 0;
      animation: pipPulse 2.4s ease-in-out infinite;
    }
    @keyframes pipPulse {
      0%,100% { box-shadow: 0 0 0 0 rgba(34,197,94,0.4); }
      50%      { box-shadow: 0 0 0 4px rgba(34,197,94,0); }
    }

    /* Card body */
    .auth-card__body {
      display: grid;
      grid-template-columns: 52px minmax(0,1fr);
      gap: 0.9rem;
      align-items: center;
    }

    /* Avatar */
    .auth-card__photo {
      width: 52px; height: 52px;
      border-radius: 50%;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .auth-card__photo img {
      width: 100%; height: 100%;
      object-fit: cover;
      display: block;
    }
    .auth-card__photo--director    { background: var(--dir-dark); }
    .auth-card__photo--subdirector { background: var(--sub-dark); }

    /* Monogram initials */
    .auth-card__monogram {
      font-family: var(--ff-display);
      font-size: 1.1rem;
      font-weight: 700;
      color: rgba(255,255,255,0.92);
      letter-spacing: -0.02em;
      line-height: 1;
      user-select: none;
    }

    /* Name */
    .auth-card__name {
      font-family: var(--ff-display);
      font-size: 0.93rem;
      font-weight: 700;
      color: var(--text);
      line-height: 1.3;
      margin-bottom: 0.12rem;
    }

    /* Role */
    .auth-card__role {
      font-size: 0.64rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.07em;
      color: var(--muted);
      margin-bottom: 0.45rem;
    }

    /* CTA pill */
    .auth-card__cta {
      display: inline-flex;
      align-items: center;
      gap: 0.28rem;
      font-size: 0.68rem;
      font-weight: 700;
      padding: 0.2rem 0.65rem;
      border-radius: 99px;
      border: 1px solid;
      line-height: 1.5;
      transition: background 0.15s ease;
    }
    .cta--director {
      color: var(--dir);
      border-color: var(--dir-border);
      background: var(--dir-light);
    }
    .cta--director:hover  { background: rgba(29,78,216,0.1); }
    .cta--subdirector {
      color: var(--sub);
      border-color: var(--sub-border);
      background: var(--sub-light);
    }
    .cta--subdirector:hover { background: rgba(13,148,136,0.1); }

    /* ── Mobile section titles ──────────────────────────────────── */
    @media (max-width: 991px) {
      .mob-section-title {
        font-family: var(--ff-display);
        font-style: italic;
        font-size: 1.1rem;
        font-weight: 600;
        padding: 0.35rem 0 0.35rem 1rem;
        border-left: 3px solid;
        margin-bottom: 1rem;
      }
      .mob-section-title--dir { color: var(--dir); border-color: var(--dir); }
      .mob-section-title--sub { color: var(--sub); border-color: var(--sub); }
    }

    /* ── Mobile timeline ────────────────────────────────────────── */
    .mob-timeline {
      position: relative;
      padding-left: 1.5rem;
    }
    .mob-timeline--dir::before {
      content: '';
      position: absolute;
      left: 0.45rem; top: 0.35rem; bottom: 0.5rem;
      width: 1px;
      background: linear-gradient(180deg, rgba(29,78,216,0.7) 0%, rgba(29,78,216,0.1) 100%);
    }
    .mob-timeline--sub::before {
      content: '';
      position: absolute;
      left: 0.45rem; top: 0.35rem; bottom: 0.5rem;
      width: 1px;
      background: linear-gradient(180deg, rgba(13,148,136,0.7) 0%, rgba(13,148,136,0.1) 100%);
    }
    .mob-item {
      position: relative;
      padding-bottom: 1rem;
    }
    .mob-item::before {
      content: '';
      position: absolute;
      left: -1.08rem; top: 1.2rem;
      width: 0.6rem; height: 0.6rem;
      border-radius: 50%;
      border: 2px solid;
      background: var(--bg);
    }
    .mob-timeline--dir .mob-item::before { border-color: var(--dir); }
    .mob-timeline--sub .mob-item::before { border-color: var(--sub); }

    /* ── Offcanvas placeholder ──────────────────────────────────── */
    .leadership-offcanvas__photo--default {
      background: #e2e8f0;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #64748b;
      font-family: var(--ff-display);
      font-size: 2.8rem;
      font-weight: 700;
      letter-spacing: -0.02em;
    }
  </style>
<% end %>

<%= render "layouts/header" %>

<div class="page-header">
  <div class="container">
    <h1 class="page-title">Galería de Autoridades</h1>
    <p class="page-subtitle">Recorrido histórico de Directores y Subdirectores del CDCH</p>
  </div>
</div>

<section class="section ga-section">
  <div class="container">

    <div class="d-flex flex-wrap gap-3 align-items-center justify-content-between mb-4 pb-3"
         style="border-bottom:1px solid rgba(15,23,42,0.08)">
      <h2 class="section-title mb-0">Histórico de Autoridades</h2>
      <%= link_to nosotros_path, class: "btn btn-outline-primary btn-sm" do %>
        <i class="fas fa-arrow-left me-2"></i>Volver a Nosotros
      <% end %>
    </div>

    <% if @groups.empty? %>
      <div class="card border-0 shadow-sm">
        <div class="card-body p-4 text-center">
          <p class="text-muted mb-0">No hay autoridades registradas.</p>
        </div>
      </div>
    <% else %>

      <%# ── Column headers (desktop only) ── %>
      <div class="col-headers">
        <div class="col-label col-label--director">
          <span class="label-pip label-pip--dir"></span>
          <i class="fas fa-user-tie fa-sm"></i> Directores
        </div>
        <div></div>
        <div class="col-label col-label--subdirector col-label--right">
          Subdirectores <i class="fas fa-user-tie fa-sm"></i>
          <span class="label-pip label-pip--sub"></span>
        </div>
      </div>

      <%# ══════ DESKTOP: dual butterfly timeline ══════ %>
      <div class="dual-timeline mt-3">
        <% @groups.each_with_index do |group, idx| %>
          <% director   = group[:director] %>
          <% subs       = group[:subdirectors] %>
          <% spine_year = (director || subs.first)&.start_date&.strftime("%Y") %>
          <% group_css  = if director && subs.any? then "dt-group--both"
                          elsif director             then "dt-group--no-right"
                          else                            "dt-group--no-left"
                          end %>
          <% dot_css    = if director && subs.any? then "dt-dot--both"
                          elsif director             then "dt-dot--director"
                          else                            "dt-dot--subdirector"
                          end %>

          <div class="dt-group <%= group_css %>" style="animation-delay:<%= (idx * 0.055).round(3) %>s">

            <%# Left — director %>
            <div class="dt-left">
              <% if director %>
                <%# Extract initials: strip title prefix, take first letter of first + last word %>
                <% dir_words = director.full_name.split.reject { |w| w =~ /\A(prof|profa|dr|dra)\.?\z/i }
                   dir_init  = [dir_words.first&.chr, dir_words.last&.chr].compact.join.upcase %>
                <button type="button"
                        class="auth-card auth-card--director"
                        data-bs-toggle="offcanvas"
                        data-bs-target="#authorityDetail<%= director.id %>"
                        aria-controls="authorityDetail<%= director.id %>">
                  <div class="auth-card__period">
                    <% if director.active? %><span class="auth-card__active-pip"></span><% end %>
                    <i class="far fa-calendar-alt"></i><%= director.period_label %>
                  </div>
                  <div class="auth-card__body">
                    <div class="auth-card__photo auth-card__photo--director">
                      <% if director.photo.attached? %>
                        <%= image_tag director.photo, alt: director.full_name %>
                      <% else %>
                        <span class="auth-card__monogram"><%= dir_init %></span>
                      <% end %>
                    </div>
                    <div>
                      <div class="auth-card__name"><%= director.full_name %></div>
                      <div class="auth-card__role"><%= director.role_label %> del CDCH-UCV</div>
                      <span class="auth-card__cta cta--director">
                        Ver reseña <i class="fas fa-arrow-right fa-xs"></i>
                      </span>
                    </div>
                  </div>
                </button>
              <% else %>
                <div class="dt-empty"></div>
              <% end %>
            </div>

            <%# Spine %>
            <div class="dt-spine">
              <div class="dt-dot <%= dot_css %>"></div>
              <% if spine_year %>
                <span class="dt-year"><%= spine_year %></span>
              <% end %>
            </div>

            <%# Right — subdirector(s) %>
            <div class="dt-right">
              <% if subs.any? %>
                <% subs.each do |sub| %>
                  <% sub_words = sub.full_name.split.reject { |w| w =~ /\A(prof|profa|dr|dra)\.?\z/i }
                     sub_init  = [sub_words.first&.chr, sub_words.last&.chr].compact.join.upcase %>
                  <button type="button"
                          class="auth-card auth-card--subdirector"
                          data-bs-toggle="offcanvas"
                          data-bs-target="#authorityDetail<%= sub.id %>"
                          aria-controls="authorityDetail<%= sub.id %>">
                    <div class="auth-card__period">
                      <% if sub.active? %><span class="auth-card__active-pip"></span><% end %>
                      <i class="far fa-calendar-alt"></i><%= sub.period_label %>
                    </div>
                    <div class="auth-card__body">
                      <div class="auth-card__photo auth-card__photo--subdirector">
                        <% if sub.photo.attached? %>
                          <%= image_tag sub.photo, alt: sub.full_name %>
                        <% else %>
                          <span class="auth-card__monogram"><%= sub_init %></span>
                        <% end %>
                      </div>
                      <div>
                        <div class="auth-card__name"><%= sub.full_name %></div>
                        <div class="auth-card__role"><%= sub.role_label %> del CDCH-UCV</div>
                        <span class="auth-card__cta cta--subdirector">
                          Ver reseña <i class="fas fa-arrow-right fa-xs"></i>
                        </span>
                      </div>
                    </div>
                  </button>
                <% end %>
              <% else %>
                <div class="dt-empty"></div>
              <% end %>
            </div>

          </div><%# /dt-group %>
        <% end %>
      </div><%# /dual-timeline %>

      <%# ══════ MOBILE: two stacked lists ══════ %>
      <div class="mob-list mt-2">
        <div class="mob-section-title mob-section-title--dir">
          <i class="fas fa-user-tie me-2"></i>Directores
        </div>
        <div class="mob-timeline mob-timeline--dir mb-4">
          <% @groups.each do |group| %>
            <% next unless group[:director] %>
            <% director = group[:director] %>
            <% dir_words = director.full_name.split.reject { |w| w =~ /\A(prof|profa|dr|dra)\.?\z/i }
               dir_init  = [dir_words.first&.chr, dir_words.last&.chr].compact.join.upcase %>
            <div class="mob-item">
              <button type="button"
                      class="auth-card auth-card--director"
                      data-bs-toggle="offcanvas"
                      data-bs-target="#authorityDetail<%= director.id %>"
                      aria-controls="authorityDetail<%= director.id %>">
                <div class="auth-card__period">
                  <% if director.active? %><span class="auth-card__active-pip"></span><% end %>
                  <i class="far fa-calendar-alt"></i><%= director.period_label %>
                </div>
                <div class="auth-card__body">
                  <div class="auth-card__photo auth-card__photo--director">
                    <% if director.photo.attached? %>
                      <%= image_tag director.photo, alt: director.full_name %>
                    <% else %>
                      <span class="auth-card__monogram"><%= dir_init %></span>
                    <% end %>
                  </div>
                  <div>
                    <div class="auth-card__name"><%= director.full_name %></div>
                    <div class="auth-card__role"><%= director.role_label %></div>
                    <span class="auth-card__cta cta--director">
                      Ver reseña <i class="fas fa-arrow-right fa-xs"></i>
                    </span>
                  </div>
                </div>
              </button>
            </div>
          <% end %>
        </div>

        <div class="mob-section-title mob-section-title--sub">
          <i class="fas fa-user-tie me-2"></i>Subdirectores
        </div>
        <div class="mob-timeline mob-timeline--sub">
          <% @groups.each do |group| %>
            <% group[:subdirectors].each do |sub| %>
              <% sub_words = sub.full_name.split.reject { |w| w =~ /\A(prof|profa|dr|dra)\.?\z/i }
                 sub_init  = [sub_words.first&.chr, sub_words.last&.chr].compact.join.upcase %>
              <div class="mob-item">
                <button type="button"
                        class="auth-card auth-card--subdirector"
                        data-bs-toggle="offcanvas"
                        data-bs-target="#authorityDetail<%= sub.id %>"
                        aria-controls="authorityDetail<%= sub.id %>">
                  <div class="auth-card__period">
                    <% if sub.active? %><span class="auth-card__active-pip"></span><% end %>
                    <i class="far fa-calendar-alt"></i><%= sub.period_label %>
                  </div>
                  <div class="auth-card__body">
                    <div class="auth-card__photo auth-card__photo--subdirector">
                      <% if sub.photo.attached? %>
                        <%= image_tag sub.photo, alt: sub.full_name %>
                      <% else %>
                        <span class="auth-card__monogram"><%= sub_init %></span>
                      <% end %>
                    </div>
                    <div>
                      <div class="auth-card__name"><%= sub.full_name %></div>
                      <div class="auth-card__role"><%= sub.role_label %></div>
                      <span class="auth-card__cta cta--subdirector">
                        Ver reseña <i class="fas fa-arrow-right fa-xs"></i>
                      </span>
                    </div>
                  </div>
                </button>
              </div>
            <% end %>
          <% end %>
        </div>
      </div><%# /mob-list %>

      <%# ══════ Offcanvas detail panels (shared by desktop + mobile) ══════ %>
      <% @groups.each do |group| %>
        <% ([group[:director]] + group[:subdirectors]).compact.uniq(&:id).each do |authority| %>
          <% panel_id    = "authorityDetail#{authority.id}" %>
          <% panel_label = "#{panel_id}Label" %>
          <% oc_words    = authority.full_name.split.reject { |w| w =~ /\A(prof|profa|dr|dra)\.?\z/i }
             oc_init     = [oc_words.first&.chr, oc_words.last&.chr].compact.join.upcase %>

          <div class="offcanvas offcanvas-end leadership-offcanvas"
               tabindex="-1"
               id="<%= panel_id %>"
               aria-labelledby="<%= panel_label %>">
            <div class="offcanvas-header">
              <h5 class="offcanvas-title" id="<%= panel_label %>"><%= authority.full_name %></h5>
              <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Cerrar"></button>
            </div>
            <div class="offcanvas-body">
              <div class="leadership-offcanvas__hero">
                <div class="leadership-offcanvas__photo<%= ' leadership-offcanvas__photo--default' unless authority.photo.attached? %>">
                  <% if authority.photo.attached? %>
                    <%= image_tag authority.photo, alt: authority.full_name %>
                  <% else %>
                    <%= oc_init %>
                  <% end %>
                </div>
                <div class="leadership-offcanvas__meta">
                  <div class="leadership-offcanvas__period"><%= authority.period_label %></div>
                  <p class="leadership-offcanvas__role mb-2"><%= authority.role_label %> del CDCH-UCV</p>
                  <% if authority.active? %>
                    <span class="badge text-bg-success">Autoridad actual</span>
                  <% else %>
                    <span class="badge text-bg-secondary">Período histórico</span>
                  <% end %>
                </div>
              </div>

              <div class="leadership-offcanvas__bio mt-4">
                <h6 class="leadership-offcanvas__section-title">
                  <i class="fas fa-book-reader me-2"></i>Reseña
                </h6>
                <% if authority.bio.body.present? %>
                  <div class="leadership-offcanvas__bio-content">
                    <%= authority.bio %>
                  </div>
                <% else %>
                  <p class="text-muted mb-0">No hay reseña registrada para esta autoridad.</p>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      <% end %>

    <% end %><%# /if @groups.empty? %>
  </div><%# /container %>
</section>

