<!-- MAIN - LANDING PAGE -->
<%= render "layouts/header" %>

<!-- Hero Section -->
<section class="hero-section">
  <div class="container">
    <div class="row">
      <div class="col-lg-10 col-xl-8">
        <h1 class="hero-title reveal animate__fadeInDown">
          <% if @eventsHero.present? %>
            <%= @eventsHero.first.title %>
          <% else %>
            <%= Institution.first.name %>
          <% end %>
        </h1>
        <p class="hero-subtitle reveal animate__fadeIn animate_delay-1s">
          <% if @eventsHero.present? %>
            <%= truncate(@eventsHero.first.description, length: 200) %>
          <% else %>
            <%= Institution.first.description %>
          <% end %>
        </p>
        <div class="hero-buttons reveal animate__fadeIn animate_delay-2s">
          <% if @eventsHero.present? %>
            <%= link_to "Ver Noticia", evento_path(@eventsHero.first), class: "btn-white-custom" %>
          <% else %>
            <%= link_to "Ver Eventos", eventos_path, class: "btn-white-custom" %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Featured Links Section -->
<section class="featured-links-section">
  <div class="container">
    <div class="row g-4">
      <div class="col-md-6 col-lg-3 animate__fadeInLeft">
        <%= link_to "#", class: "featured-card reveal" do %>
          <div class="featured-icon featured-icon-blue">
            <i class="fas fa-users"></i>
          </div>
          <h3 class="featured-title">DADA</h3>
          <p class="featured-description">Departamentos de Apoyo al Desarrollo Académico</p>
          <span class="featured-link">
            Ver más <i class="fas fa-chevron-right ms-1"></i>
          </span>
        <% end %>
      </div>

      <div class="col-md-6 col-lg-3 animate__fadeInUp animate__delay-1s">
        <%= link_to "#", class: "featured-card reveal" do %>
          <div class="featured-icon featured-icon-green">
            <i class="fas fa-book"></i>
          </div>
          <h3 class="featured-title">DADI</h3>
          <p class="featured-description">Departamentos de Apoyo al Desarrollo de la Investigación</p>
          <span class="featured-link">
            Ver más <i class="fas fa-chevron-right ms-1"></i>
          </span>
        <% end %>
      </div>

      <div class="col-md-6 col-lg-3 animate__fadeInDown animate__delay-2s">
        <%= link_to publicaciones_path, class: "featured-card reveal" do %>
          <div class="featured-icon featured-icon-amber">
            <i class="fas fa-file-alt"></i>
          </div>
          <h3 class="featured-title">Publicaciones</h3>
          <p class="featured-description">Relaciones y Publicaciones</p>
          <span class="featured-link">
            Ver más <i class="fas fa-chevron-right ms-1"></i>
          </span>
        <% end %>
      </div>

      <div class="col-md-6 col-lg-3 animate__fadeInRight animate__delay-3s">
        <%= link_to "https://saber.ucv.ve/", class: "featured-card reveal" do %>
          <div class="featured-icon featured-icon-purple">
            <i class="fas fa-calendar"></i>
          </div>
          <h3 class="featured-title">Saber UCV</h3>
          <p class="featured-description">Departamento de Comunicación de la Tecnología e Innovación</p>
          <span class="featured-link">
            Ver más <i class="fas fa-chevron-right ms-1"></i>
          </span>
        <% end %>
      </div>
    </div>
  </div>
</section>

<!-- Latest Updates Section -->
<section class="updates-section">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title reveal animate__slideInLeft">Noticias y Eventos</h2>
      <%= link_to eventos_path, class: "section-title-link" do %>
        Ver todas <i class="fas fa-chevron-right ms-1"></i>
      <% end %>
    </div>

    <div class="row g-4">
      <% if @events.present? %>
        <% @events.each_with_index do |event, index| %>
          <div class="col-md-6 col-lg-3">
            <article class="update-card reveal animate__zoomIn <%= "animate__delay-#{index}s" if index > 0 %>">
              <% if event.image.attached? %>
                <div class="update-image" style="background-image: url('<%= url_for(event.image) %>');"></div>
              <% else %>
                <div class="update-image update-image-blue"></div>
              <% end %>
              <div class="update-content">
                <div class="update-date"><%= event.day %></div>
                <h3 class="update-title"><%= event.title %></h3>
                <p class="update-excerpt">
                  <%= truncate(event.description, length: 100) %>
                </p>
                <%= link_to evento_path(event), class: "update-link" do %>
                  Leer más <i class="fas fa-chevron-right ms-1"></i>
                <% end %>
              </div>
            </article>
          </div>
        <% end %>
      <% else %>
        <!-- Update Card 1 -->
        <div class="col-md-6 col-lg-3">
          <article class="update-card reveal animate__zoomIn">
            <div class="update-image update-image-blue"></div>
            <div class="update-content">
              <div class="update-date">15 de Marzo, 2025</div>
              <h3 class="update-title">Convocatoria 2025: Proyectos de Investigación</h3>
              <p class="update-excerpt">
                Abierta la convocatoria para financiamiento de proyectos de investigación individuales y grupales.
              </p>
              <%= link_to "#", class: "update-link" do %>
                Leer más <i class="fas fa-chevron-right ms-1"></i>
              <% end %>
            </div>
          </article>
        </div>

        <!-- Update Card 2 -->
        <div class="col-md-6 col-lg-3">
          <article class="update-card reveal animate__zoomIn animate__delay-1s">
            <div class="update-image update-image-green"></div>
            <div class="update-content">
              <div class="update-date">10 de Marzo, 2025</div>
              <h3 class="update-title">Nuevas Publicaciones Disponibles</h3>
              <p class="update-excerpt">
                Accede al catálogo actualizado de publicaciones científicas y humanísticas del CDCH.
              </p>
              <%= link_to "#", class: "update-link" do %>
                Leer más <i class="fas fa-chevron-right ms-1"></i>
              <% end %>
            </div>
          </article>
        </div>

        <!-- Update Card 3 -->
        <div class="col-md-6 col-lg-3">
          <article class="update-card reveal animate__zoomIn animate__delay-2s">
            <div class="update-image update-image-purple"></div>
            <div class="update-content">
              <div class="update-date">5 de Marzo, 2025</div>
              <h3 class="update-title">Taller: Metodología de la Investigación</h3>
              <p class="update-excerpt">
                Inscripciones abiertas para el taller dirigido a investigadores noveles de la UCV.
              </p>
              <%= link_to "#", class: "update-link" do %>
                Leer más <i class="fas fa-chevron-right ms-1"></i>
              <% end %>
            </div>
          </article>
        </div>

        <!-- Update Card 4 -->
        <div class="col-md-6 col-lg-3">
          <article class="update-card reveal animate__zoomIn animate__delay-3s">
            <div class="update-image update-image-orange"></div>
            <div class="update-content">
              <div class="update-date">5 de Marzo, 2025</div>
              <h3 class="update-title">Metodología Corporativa</h3>
              <p class="update-excerpt">
                Inscripciones abiertas para el taller dirigido a investigadores noveles de la UCV.
              </p>
              <%= link_to "#", class: "update-link" do %>
                Leer más <i class="fas fa-chevron-right ms-1"></i>
              <% end %>
            </div>
          </article>
        </div>
      <% end %>
    </div>
  </div>
</section>

<%#= render "layouts/counter" %>
<%= render "layouts/CTA_section" %>
<%= render "layouts/footer" %>

<!-- Search Modal -->
<div class="modal fade" id="searchModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header border-0">
        <h5 class="modal-title">Buscar</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <form>
          <div class="input-group input-group-lg">
            <input type="text" class="form-control" placeholder="¿Qué estás buscando?">
            <button class="btn btn-primary" type="submit">
              <i class="fas fa-search"></i>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>