<!-- MAIN - LANDING PAGE -->
<%= render "layouts/header" %>

<!-- Hero Carousel Section -->
<section class="hero-section" id="heroCarousel">
  <div class="hero-carousel">
    <!-- Slides Container -->
    <div class="hero-carousel__slides" id="carouselSlides">
      <% if @eventsHero.present? %>
        <% @eventsHero.each do |event| %>
          <div class="hero-carousel__slide">
            <div class="container">
              <div class="row">
                <div class="col-lg-10 col-xl-8">
                  <h1 class="hero-title reveal animate__fadeInDown">
                    <%= event.title %>
                  </h1>
                  <p class="hero-subtitle reveal animate__fadeIn animate_delay-1s">
                    <%= truncate(event.description, length: 200) %>
                  </p>
                  <div class="hero-buttons reveal animate__fadeIn animate_delay-2s">
                    <%= link_to "Ver Noticia", evento_path(event), class: "btn-white-custom" %>
                  </div>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      <% else %>
        <div class="hero-carousel__slide">
          <div class="container">
            <div class="row">
              <div class="col-lg-10 col-xl-8 mx-auto">
                <h1 class="hero-title reveal animate__fadeInDown">
                  <%= Institution.first.name %>
                </h1>
                <p class="hero-subtitle reveal animate__fadeIn animate_delay-1s">
                  <%= Institution.first.description %>
                </p>
                <div class="hero-buttons reveal animate__fadeIn animate_delay-2s">
                  <%= link_to "Ver Eventos", eventos_path, class: "btn-white-custom" %>
                </div>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Navigation Buttons -->
    <% if @eventsHero.present? && @eventsHero.length > 1 %>
      <!-- Prev/Next Buttons
        <button class="hero-carousel__button hero-carousel__button--prev" id="prevBtn" aria-label="Slide anterior">
          <i class="fas fa-chevron-left"></i>
        </button>
        <button class="hero-carousel__button hero-carousel__button--next" id="nextBtn" aria-label="Siguiente slide">
          <i class="fas fa-chevron-right"></i>
        </button>
      -->

      <!-- Dots Indicators -->
      <div class="hero-carousel__controls">
        <% @eventsHero.each_with_index do |_, index| %>
          <button 
            class="hero-carousel__dot <%= 'active' if index == 0 %>"
            data-slide="<%= index %>"
            aria-label="Ir al slide <%= index + 1 %>"
          ></button>
        <% end %>
      </div>

      <!-- Autoplay Indicator 
        <div class="hero-carousel__autoplay">
          <i class="fas fa-redo-alt"></i> Auto (5s)
        </div>
      -->
    <% end %>
  </div>
</section>

<!-- Featured Links Section -->
<section class="featured-links-section py-5">
  <div class="container">
    <div class="section-header text-center mb-5">
      <h2 class="section-title">Somos CDCH</h2>
      <p class="section-subtitle"><%= link_to "Más sobre nosotros", nosotros_path, class: "btn btn-outline-primary" %> </p>
    </div>

    <div class="profile-cards-grid">
      <% @fourDepartments.each do |dept| %>
        <div class="profile-card profile-card--<%= dept.acronym.downcase %> reveal animate__zoomIn <%= "animate__delay-#{dept.organize}s" if dept.organize > 0 %>">
          <div class="profile-card__image-container">
            <% if dept.logoDepartment.attached? %>
              <%= image_tag dept.logoDepartment, class: "profile-card__img" %>
            <% else %>
              <div class="image-placeholder">
                <!--<i class="fas fa-image"></i>-->
                <%= image_tag "Foto-Emblema-CDCH.jpg", class: "profile-card__img" %>
              </div>
            <% end %>
            <div class="profile-card__badge"><%= dept.acronym %></div>
          </div>

          <div class="profile-card__body">
            <h3 class="profile-card__name text-dark"><%= dept.name %></h3>
            <p class="profile-card__description">
              <%# truncate(strip_tags(dept.description.to_s), lenght: 100) %>
            </p>
            <div class="profile-card__footer">
              <%= link_to departamento_path(dept.acronym), class: "btn btn-outline-primary" do %>
                Leer más <i class="fas fa-chevron-right ms-1"></i>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>

<!-- Latest Updates Section -->
<section class="updates-section">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title reveal animate__slideInLeft">Noticias y Eventos</h2>
      <%= link_to eventos_path, class: "section-title-link" do %>
        Ver todas <i class="fas fa-chevron-right ms-1"></i>
      <% end %>
    </div>

    <div class="row g-4">
      <% if @events.present? %>
        <% @events.each_with_index do |event, index| %>
          <div class="col-md-6 col-lg-3">
            <article class="update-card reveal animate__zoomIn <%= "animate__delay-#{index}s" if index > 0 %>">
              <% if event.image.present? %>
                <div class="update-image">
                  <%= image_tag event.image, alt: "Imagen del evento #{event.title}", style: "width: 100%; height: 100%; object-fit: cover;" %>
                </div>
              <% else %>
                <div class="update-image update-image-blue">
                  <%= image_tag "Detalle_vitral_CDCH.JPG", alt: "Imagen por defecto de eventos", style: "width: 100%; height: 100%; object-fit: cover;" %>
                </div>
              <% end %>
              <div class="update-content">
                <div class="update-date"><%= event.day %></div>
                <h3 class="update-title"><%= event.title %></h3>
                <p class="update-excerpt">
                  <%= truncate(event.description, length: 100) %>
                </p>
                <%= link_to evento_path(event), class: "update-link" do %>
                  Leer más <i class="fas fa-chevron-right ms-1"></i>
                <% end %>
              </div>
            </article>
          </div>
        <% end %>
      <% else %>
        <!-- Update Card 1 -->
        <div class="col-md-6 col-lg-3">
          <article class="update-card reveal animate__zoomIn">
            <div class="update-image update-image-blue"></div>
            <div class="update-content">
              <div class="update-date">15 de Marzo, 2025</div>
              <h3 class="update-title">Convocatoria 2025: Proyectos de Investigación</h3>
              <p class="update-excerpt">
                Abierta la convocatoria para financiamiento de proyectos de investigación individuales y grupales.
              </p>
              <%= link_to "#", class: "update-link" do %>
                Leer más <i class="fas fa-chevron-right ms-1"></i>
              <% end %>
            </div>
          </article>
        </div>

        <!-- Update Card 2 -->
        <div class="col-md-6 col-lg-3">
          <article class="update-card reveal animate__zoomIn animate__delay-1s">
            <div class="update-image update-image-green"></div>
            <div class="update-content">
              <div class="update-date">10 de Marzo, 2025</div>
              <h3 class="update-title">Nuevas Publicaciones Disponibles</h3>
              <p class="update-excerpt">
                Accede al catálogo actualizado de publicaciones científicas y humanísticas del CDCH.
              </p>
              <%= link_to "#", class: "update-link" do %>
                Leer más <i class="fas fa-chevron-right ms-1"></i>
              <% end %>
            </div>
          </article>
        </div>

        <!-- Update Card 3 -->
        <div class="col-md-6 col-lg-3">
          <article class="update-card reveal animate__zoomIn animate__delay-2s">
            <div class="update-image update-image-purple"></div>
            <div class="update-content">
              <div class="update-date">5 de Marzo, 2025</div>
              <h3 class="update-title">Taller: Metodología de la Investigación</h3>
              <p class="update-excerpt">
                Inscripciones abiertas para el taller dirigido a investigadores noveles de la UCV.
              </p>
              <%= link_to "#", class: "update-link" do %>
                Leer más <i class="fas fa-chevron-right ms-1"></i>
              <% end %>
            </div>
          </article>
        </div>

        <!-- Update Card 4 -->
        <div class="col-md-6 col-lg-3">
          <article class="update-card reveal animate__zoomIn animate__delay-3s">
            <div class="update-image update-image-orange"></div>
            <div class="update-content">
              <div class="update-date">5 de Marzo, 2025</div>
              <h3 class="update-title">Metodología Corporativa</h3>
              <p class="update-excerpt">
                Inscripciones abiertas para el taller dirigido a investigadores noveles de la UCV.
              </p>
              <%= link_to "#", class: "update-link" do %>
                Leer más <i class="fas fa-chevron-right ms-1"></i>
              <% end %>
            </div>
          </article>
        </div>
      <% end %>
    </div>
  </div>
</section>

<%#= render "layouts/counter" %>
<%= render "layouts/CTA_section" %>
<%= render "layouts/footer" %>

<!-- Search Modal -->
<div class="modal fade" id="searchModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header border-0">
        <h5 class="modal-title">Buscar</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <form>
          <div class="input-group input-group-lg">
            <input type="text" class="form-control" placeholder="¿Qué estás buscando?">
            <button class="btn btn-primary" type="submit">
              <i class="fas fa-search"></i>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<style>
  .featured-icon-large {
    font-size: 48px;
    color: rgba(255, 255, 255, 0.9);
    margin-bottom: 12px;
    display: inline-block;
  }

  .btn-primary { background-color: #3b82f6; color: white; }
  .btn-success { background-color: #10b981; color: white; }
  .btn-warning { background-color: #f59e0b; color: white; }
  .btn-secondary { background: linear-gradient(135deg, #d946ef 0%, #6366f1 100%); color: white; }
</style>


<script>
  document.addEventListener('DOMContentLoaded', function() {
    const carousel = document.getElementById('heroCarousel');
    if (!carousel) return;

    const slidesContainer = document.getElementById('carouselSlides');
    const slides = document.querySelectorAll('.hero-carousel__slide');
    const dots = document.querySelectorAll('.hero-carousel__dot');
    const prevBtn = document.getElementById('prevBtn');
    const nextBtn = document.getElementById('nextBtn');

    // Si hay menos de 2 slides, no inicializar carrusel
    if (slides.length < 2) return;

    let currentIndex = 0;
    let autoplayInterval;
    const SLIDE_DURATION = 5000; // 5 segundos

    // Función para actualizar slide
    function goToSlide(index) {
      currentIndex = (index + slides.length) % slides.length;
      const offset = -currentIndex * 100;
      slidesContainer.style.transform = `translateX(${offset}%)`;
      
      // Actualizar dots
      dots.forEach((dot, i) => {
        dot.classList.toggle('active', i === currentIndex);
      });
      
      // Reiniciar autoplay
      clearInterval(autoplayInterval);
      startAutoplay();
    }

    // Función para siguiente slide
    function nextSlide() {
      goToSlide(currentIndex + 1);
    }

    // Función para slide anterior
    function prevSlide() {
      goToSlide(currentIndex - 1);
    }

    // Autoplay
    function startAutoplay() {
      autoplayInterval = setInterval(nextSlide, SLIDE_DURATION);
    }

    // Event listeners
    if (prevBtn) prevBtn.addEventListener('click', prevSlide);
    if (nextBtn) nextBtn.addEventListener('click', nextSlide);

    dots.forEach((dot, index) => {
      dot.addEventListener('click', () => goToSlide(index));
    });

    // Pausar autoplay cuando interactúa el usuario
    carousel.addEventListener('mouseenter', () => clearInterval(autoplayInterval));
    carousel.addEventListener('mouseleave', startAutoplay);

    // Iniciar autoplay
    startAutoplay();

    // Soporte para teclado
    document.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') prevSlide();
      if (e.key === 'ArrowRight') nextSlide();
    });
  });
</script>
