<!-- INVESTIGACIÓN - LANDING PAGE -->
<%= render "layouts/top_bar" %>
<%= render "layouts/header" %>

<!-- Page Header -->
<div class="page-header">
  <div class="container">
    <h1 class="page-title">Investigación</h1>
    <p class="page-subtitle">
      Proyectos y líneas de investigación activas en la UCV
    </p>
  </div>
</div>

<!-- Research Areas -->
<section class="section">
  <div class="container">
    <h2 class="section-title text-center mb-5">Áreas de Investigación</h2>
    
    <div class="row g-4">
      <div class="col-md-6 col-lg-3">
        <div class="research-area-card">
          <div class="research-area-icon">
            <i class="fas fa-flask"></i>
          </div>
          <h3 class="research-area-title">Ciencias Exactas y Naturales</h3>
          <p class="research-area-count">120+ Proyectos</p>
        </div>
      </div>

      <div class="col-md-6 col-lg-3">
        <div class="research-area-card">
          <div class="research-area-icon research-area-icon-green">
            <i class="fas fa-heartbeat"></i>
          </div>
          <h3 class="research-area-title">Ciencias de la Salud</h3>
          <p class="research-area-count">95+ Proyectos</p>
        </div>
      </div>

      <div class="col-md-6 col-lg-3">
        <div class="research-area-card">
          <div class="research-area-icon research-area-icon-purple">
            <i class="fas fa-users"></i>
          </div>
          <h3 class="research-area-title">Ciencias Sociales</h3>
          <p class="research-area-count">85+ Proyectos</p>
        </div>
      </div>

      <div class="col-md-6 col-lg-3">
        <div class="research-area-card">
          <div class="research-area-icon research-area-icon-amber">
            <i class="fas fa-book"></i>
          </div>
          <h3 class="research-area-title">Humanidades</h3>
          <p class="research-area-count">70+ Proyectos</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Featured Projects -->
<section class="section section-light">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">Proyectos Destacados</h2>
      <%= link_to "#", class: "section-link" do %>
        Ver todos <i class="fas fa-chevron-right ms-1"></i>
      <% end %>
    </div>

    <div class="row g-4">
      <!-- Project Card 1 -->
      <div class="col-lg-4">
        <div class="research-project-card">
          <div class="project-status">
            <span class="badge bg-success">En Curso</span>
          </div>
          <h3 class="project-title">
            Desarrollo de Vacunas contra Enfermedades Tropicales
          </h3>
          <p class="project-investigator">
            <i class="fas fa-user"></i> Dr. Pedro Martínez
          </p>
          <p class="project-faculty">
            <i class="fas fa-building"></i> Facultad de Ciencias
          </p>
          <p class="project-description">
            Investigación sobre el desarrollo de vacunas efectivas contra enfermedades 
            endémicas en regiones tropicales.
          </p>
          <div class="project-meta">
            <span><i class="fas fa-calendar"></i> 2024-2026</span>
            <span><i class="fas fa-tag"></i> Biomedicina</span>
          </div>
        </div>
      </div>

      <!-- Project Card 2 -->
      <div class="col-lg-4">
        <div class="research-project-card">
          <div class="project-status">
            <span class="badge bg-success">En Curso</span>
          </div>
          <h3 class="project-title">
            Análisis Socioeconómico de Comunidades Urbanas
          </h3>
          <p class="project-investigator">
            <i class="fas fa-user"></i> Dra. Carmen Silva
          </p>
          <p class="project-faculty">
            <i class="fas fa-building"></i> Facultad de Ciencias Económicas y Sociales
          </p>
          <p class="project-description">
            Estudio sobre las dinámicas socioeconómicas en comunidades urbanas venezolanas.
          </p>
          <div class="project-meta">
            <span><i class="fas fa-calendar"></i> 2023-2025</span>
            <span><i class="fas fa-tag"></i> Sociología</span>
          </div>
        </div>
      </div>

      <!-- Project Card 3 -->
      <div class="col-lg-4">
        <div class="research-project-card">
          <div class="project-status">
            <span class="badge bg-warning text-dark">Finalizado</span>
          </div>
          <h3 class="project-title">
            Preservación del Patrimonio Cultural Venezolano
          </h3>
          <p class="project-investigator">
            <i class="fas fa-user"></i> Prof. Luis Hernández
          </p>
          <p class="project-faculty">
            <i class="fas fa-building"></i> Facultad de Humanidades y Educación
          </p>
          <p class="project-description">
            Documentación y preservación de manifestaciones culturales tradicionales.
          </p>
          <div class="project-meta">
            <span><i class="fas fa-calendar"></i> 2022-2024</span>
            <span><i class="fas fa-tag"></i> Antropología</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Research Statistics -->
<section class="section">
  <div class="container">
    <div class="research-stats">
      <div class="row text-center g-4">
        <div class="col-6 col-md-3">
          <div class="stat-box">
            <i class="fas fa-project-diagram stat-icon"></i>
            <div class="stat-number">370+</div>
            <div class="stat-label">Proyectos Activos</div>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="stat-box">
            <i class="fas fa-users stat-icon"></i>
            <div class="stat-number">1,200+</div>
            <div class="stat-label">Investigadores</div>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="stat-box">
            <i class="fas fa-file-alt stat-icon"></i>
            <div class="stat-number">850+</div>
            <div class="stat-label">Publicaciones</div>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="stat-box">
            <i class="fas fa-award stat-icon"></i>
            <div class="stat-number">50+</div>
            <div class="stat-label">Premios</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>


<%= render "layouts/counter" %>
<%= render "layouts/CTA_section" %>
<%= render "layouts/footer" %>