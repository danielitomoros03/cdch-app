<!-- ABOUT - LANDING PAGE -->
<%= render "layouts/header" %>

<!-- Page Header -->
<div class="page-header">
  <div class="container">
    <h1 class="page-title">Nosotros</h1>
    <p class="page-subtitle">
      Conoce nuestra historia, misión y compromiso con la excelencia académica
    </p>
  </div>
</div>

<!-- History Section -->
<section class="section">
  <div class="container">
    <div class="row align-items-center g-5">
      <div class="col-lg-6">
        <h2 class="section-title">Nuestra Trayectoria</h2>
        <p class="text-gray mb-4">
          <% if Institution.first.history.empty? %>
            <p class="text-gray mb-4">
              El Consejo de Desarrollo Científico y Humanístico (CDCH) de la Universidad Central de Venezuela 
              fue creado en 1958 con el propósito de promover, coordinar y fomentar la investigación científica 
              y humanística en nuestra institución.
            </p>
            <p class="text-gray mb-4">
              Durante más de 60 años, hemos sido el principal ente financiador de proyectos de investigación 
              en la UCV, apoyando a miles de investigadores y contribuyendo significativamente al desarrollo 
              científico y tecnológico del país.
            </p>
            <p class="text-gray mb-4">
              Nuestro compromiso es fortalecer la investigación de calidad, fomentar la publicación científica 
              y promover la formación de nuevos investigadores en todas las áreas del conocimiento.
            </p>
          <% else %>
            <%= Institution.first.history %>
          <% end %>
        </p>
        <div class="about-quick-links mt-4" aria-label="Accesos rápidos de información del CDCH">
          <a href="#" class="about-quick-link" data-bs-toggle="modal" data-bs-target="#misionVisionModal">
            <span class="about-quick-link__label">
              <i class="fas fa-bullseye" aria-hidden="true"></i>
              Misión y Visión
            </span>
            <i class="fas fa-chevron-right" aria-hidden="true"></i>
          </a>

          <a href="#" class="about-quick-link" data-bs-toggle="modal" data-bs-target="#basicInformationModal">
            <span class="about-quick-link__label">
              <i class="fas fa-info-circle" aria-hidden="true"></i>
              Información Básica
            </span>
            <i class="fas fa-chevron-right" aria-hidden="true"></i>
          </a>

          <a href="#" class="about-quick-link" data-bs-toggle="modal" data-bs-target="#otherInformationModal">
            <span class="about-quick-link__label">
              <i class="fas fa-layer-group" aria-hidden="true"></i>
              Información Adicional
            </span>
            <i class="fas fa-chevron-right" aria-hidden="true"></i>
          </a>

          <%= link_to galeria_autoridades_path, class: "about-quick-link" do %>
              <span class="about-quick-link__label">
                <i class="fas fa-images" aria-hidden="true"></i>
                Galería de Autoridades
              </span>
              <i class="fas fa-chevron-right" aria-hidden="true"></i>
          <% end %>
        </div>
      </div>
      <div class="col-lg-6">
        <% if Institution.first.logoInstitution.present? %>
          <%= image_tag Institution.first.logoInstitution, class: "about-image-placeholder rounded", alt: "Imagen sobre nosotros" %>
        <% else %>
          <%= image_tag "Foto-Emblema-CDCH.jpg", class: "about-image-placeholder rounded", alt: "Imagen sobre nosotros" %>
        <% end %>
      </div>
    </div>
  </div>
</section>

<!-- Leadership Section -->
<section class="section bg-light py-5">
  <div class="container">
    <h2 class="text-center mb-5 reveal animate__animate__backInDown"><strong>Directiva del CDCH</strong></h2>
    
    <div class="row justify-content-center g-4">
      <!-- Director Card -->
      <div class="col-lg-4 col-md-6 d-flex justify-content-center reveal animate__slideInLeft">
        <div class="profile-card profile-card--blue w-100">
          <div class="profile-card__header profile-card__header--blue">
            <!--
              <div class="profile-card__image-wrapper">
                <img 
                  src="https://via.placeholder.com/150?text=Director" 
                  alt="Director CDCH" 
                  class="profile-card__image"
                >
              </div>
            -->
            <h3 class="profile-card__name"><%= Institution.first.director_name || "Dra. María Rodríguez" %> </h3>
            <p class="profile-card__title">Director(a) del CDCH</p>
            <div class="profile-card__socials">
              <div class="dropup">
                <button class="profile-card__social-link dropdown-toggle" 
                        type="button" 
                        id="dropdownEmailsDirector" 
                        data-bs-toggle="dropdown" 
                        aria-expanded="false"
                        title="Listar correos del Director(a)">
                  <i class="fas fa-envelope"></i>
                </button>
                
                <ul class="dropdown-menu shadow border-0 animate__animated animate__fadeIn animate__faster" aria-labelledby="dropdownEmailsDirector">
                  <li><h6 class="dropdown-header">Correos del Director(a)</h6></li>
                  <li><hr class="dropdown-divider"></li>
                  
                  <li>
                    <% email = Institution.first.director_primary_email %>
                    <a class="dropdown-item text-dark" href="javascript:void(0);"
                      class="profile-card__social-link" 
                      title="Copiar: <%= email %>"
                      data-bs-toggle="tooltip" 
                      onclick="navigator.clipboard.writeText('<%= email %>'); alert('Correo copiado: <%= email %>');">

                    Email principal: <%= Institution.first.director_primary_email %>
                    </a>
                  </li>
                  <li>
                    <% email2 = Institution.first.director_secondary_email %>
                    <a class="dropdown-item text-dark" href="javascript:void(0);" 
                      class="profile-card__social-link" 
                      title="Copiar: <%= email2 %>"
                      data-bs-toggle="tooltip" 
                      onclick="navigator.clipboard.writeText('<%= email2 %>'); alert('Correo copiado: <%= email2 %>');">

                    Email secundario: <%= Institution.first.director_secondary_email %>
                  </a></li>
                </ul>
              </div>

              <a href="/direccion" class="profile-card__social-link profile-card__social-link--button">
                <span>Ver más</span>
                <i class="fas fa-chevron ms-1"></i>
              </a>

              <div class="dropup">
                <button class="profile-card__social-link dropdown-toggle"
                        type="button" 
                        id="dropdownSecretarias" 
                        data-bs-toggle="dropdown" 
                        aria-expanded="false"
                        title="Listar Secretarias">
                  <i class="fas fa-users"></i>
                </button>
                
                <ul class="dropdown-menu shadow border-0 animate__animated animate__fadeIn animate__faster" aria-labelledby="dropdownSecretarias">
                  <li><h6 class="dropdown-header">Secretaria(s) del Director(a)</h6></li>
                  <li><hr class="dropdown-divider"></li>

                  <% @secretariesDir.each do |sec| %>
                    <li><a class="dropdown-item text-dark" href="#"><%= sec.full_name %></a></li> 
                  <% end %>
                </ul>
              </div>
            </div>
          </div>
          <!--
            <div class="profile-card__body">
              <p class="profile-card__description">
                Responsable de la dirección estratégica y coordinación de todas las actividades de investigación científica y humanística de la institución.
              </p>
            </div>
          -->
        </div>
      </div>

      <!-- Image Direction -->
      <div class="col-lg-4 col-md-6 d-flex justify-content-center reveal animate__backInDown">
        <div class="image-direction-wrapper rounded">
          <% if Institution.first.logoDirection.present? %>
            <%= image_tag Institution.first.logoDirection, alt: "Logo", class: "img-fluid-fit" %>
          <% else %>
            <%= image_tag "Logo-CDCH-Vitral.png", alt: "Logo", class: "img-fluid-fit" %>
          <% end %>
        </div>
      </div>

      <!-- Subdirector Card -->
      <div class="col-lg-4 col-md-6 d-flex justify-content-center reveal animate__slideInRight">
        <div class="profile-card profile-card--green w-100">
          <div class="profile-card__header profile-card__header--green">
            <!--
              <div class="profile-card__image-wrapper">
                <img 
                  src="https://via.placeholder.com/150?text=SubDirector" 
                  alt="SubDirector CDCH" 
                  class="profile-card__image"
                >
              </div>
            -->
            <h3 class="profile-card__name"><%= Institution.first.subdirector_name || "MSc. Carlos A. Saavedra A." %> </h3>
            <p class="profile-card__title">Subdirector del CDCH</p>
            <div class="profile-card__socials">
              <div class="dropup">
                <button class="profile-card__social-link dropdown-toggle" 
                        type="button" 
                        id="dropdownEmailsDirector" 
                        data-bs-toggle="dropdown" 
                        aria-expanded="false"
                        title="Listar correos del Subdirector(a)">
                  <i class="fas fa-envelope"></i>
                </button>
                
                <ul class="dropdown-menu shadow border-0 animate__animated animate__fadeIn animate__faster" aria-labelledby="dropdownEmailsDirector">
                  <li><h6 class="dropdown-header">Correos del Subdirector(a)</h6></li>
                  <li><hr class="dropdown-divider"></li>
                  
                  <li>
                    <% email3 = Institution.first.subdirector_primary_email %>
                    <a class="dropdown-item text-dark" href="javascript:void(0);"
                      class="profile-card__social-link" 
                      title="Copiar: <%= email3 %>"
                      data-bs-toggle="tooltip" 
                      onclick="navigator.clipboard.writeText('<%= email3 %>'); alert('Correo copiado: <%= email3 %>');">

                    Email principal: <%= Institution.first.subdirector_primary_email %>
                    </a>
                  </li>
                  <li>
                    <% email4 = Institution.first.subdirector_secondary_email %>
                    <a class="dropdown-item text-dark" href="javascript:void(0);" 
                      class="profile-card__social-link" 
                      title="Copiar: <%= email4 %>"
                      data-bs-toggle="tooltip" 
                      onclick="navigator.clipboard.writeText('<%= email4 %>'); alert('Correo copiado: <%= email4 %>');">

                    Email secundario: <%= Institution.first.subdirector_secondary_email %>
                  </a></li>
                </ul>
              </div>
              <a href="/subdireccion" class="profile-card__social-link profile-card__social-link--button">
                <span>Ver más</span>
                <i class="fas fa-chevron ms-1"></i>
              </a>
              <div class="dropup">
                <button class="profile-card__social-link dropdown-toggle" 
                        type="button" 
                        id="dropdownSecretarias" 
                        data-bs-toggle="dropdown" 
                        aria-expanded="false"
                        title="Listar Secretarias">
                  <i class="fas fa-users"></i>
                </button>
                
                <ul class="dropdown-menu shadow border-0 animate__animated animate__fadeIn animate__faster" aria-labelledby="dropdownSecretarias">
                  <li><h6 class="dropdown-header">Secretaria(s) del Subdirector</h6></li>
                  <li><hr class="dropdown-divider"></li>

                  <% @secretariesSubdir.each do |secSub| %>
                    <li><a class="dropdown-item text-dark" href="#"><%= secSub.full_name %></a></li> 
                  <% end %>
                </ul>
              </div>
            </div>
          </div>
          <!--
            <div class="profile-card__body">
              <p class="profile-card__description">
                Apoya la gestión administrativa y coordina los programas de fomento a la investigación en todas las áreas del conocimiento.
              </p>
            </div>
          -->
        </div>
      </div>
    </div>
  </div>
</section>

<!-- CDCH Family -->
<section class="updates-section">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">Conozca la familia del CDCH</h2>
    </div>

    <div class="row g-4">
      <% @departments.each do |department| %>
        <div class="col-md-6 col-lg-3">
          <article class="update-card">
            <div class="update-image update-image-white">
              <% if department.logoDepartment.attached? %>
                <%= image_tag department.logoDepartment, alt: "Logo #{department.name}", class: "department-logo" %>
              <% else %>
                <%= image_tag department_logo_asset(department), alt: "Default Department Image", class: "department-logo", style: "transform: scale(1.2);" %>
              <% end %>
            </div>
            <div class="update-content">
              <div class="update-date"><%= department.acronym %></div>
              <h3 class="update-title"><%= department.name %></h3>
              <%= link_to departamento_path(department.acronym), class: "update-link ms-1" do %>
                Leer más <i class="fas fa-chevron-right ms-1"></i>
              <% end %>
            </div>
          </article>
        </div>
      <% end %>
    </div>
  </div>
</section>

<%#= <%= render "layouts/counter" %>
<%= render "layouts/CTA_section" %>
<%= render "layouts/footer" %>

<!-- Vission & Mission Modal -->
<div class="modal fade" id="misionVisionModal" tabindex="-1" aria-labelledby="misionVisionModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="misionVisionModalLabel">Misión y Visión del CDCH</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="mb-4">
          <h4 class="text-primary mb-3">Misión</h4>
          <p class="text-gray">
            <%= Institution.first.mission %>
          </p>
        </div>
        
        <div>
          <h4 class="text-primary mb-3">Visión</h4>
          <p class="text-gray">
              <%= Institution.first.vission %>
          </p>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Cerrar</button>
      </div>
    </div>
  </div>
</div>

<!-- Basic Information Modal -->
<div class="modal fade" id="basicInformationModal" tabindex="-1" aria-labelledby="basicInformationModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="basicInformationModalLabel">Información Básica del CDCH</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="mb-4">
          <h4 class="text-primary mb-3">Fundado en <%= Institution.first.founded_year %></h4>
        </div>
        <div class="mb-4">
          <h4 class="text-primary mb-3">Director(a)</h4>
          <p class="text-gray">
            <%= Institution.first.director_name %> - <%= Institution.first.director_primary_email %> - <%= Institution.first.director_secondary_email %>
          </p>
        </div>
        <div class="mb-4">
          <h4 class="text-primary mb-3">Sub-Director(a)</h4>
          <p class="text-gray">
            <%= Institution.first.subdirector_name %> - <%= Institution.first.subdirector_primary_email %> - <%= Institution.first.subdirector_secondary_email %>
          </p>
        </div>
        <div>
          <h4 class="text-primary mb-3">Descripción</h4>
          <p class="text-gray">
              <%= Institution.first.description %>
          </p>
        </div>
        <div class="mb-4">
          <h4 class="text-primary mb-3">Contactos CDCH</h4>
          <p class="text-gray">
            <%= Institution.first.emails %>
            <%= Institution.first.phone_numbers %>
          </p>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Cerrar</button>
      </div>
    </div>
  </div>
</div>

<!-- Other Information Modal -->
<div class="modal fade" id="otherInformationModal" tabindex="-1" aria-labelledby="otherInformationModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="otherInformationModalLabel">Información adicional del CDCH</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <% if Institution.first.information.present? %>
          <div class="text-gray"><%= Institution.first.information %></div>
        <% else %>
          <p class="text-gray mb-0">Próximamente agregaremos aquí el contenido de esta sección.</p>
        <% end %>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Cerrar</button>
      </div>
    </div>
  </div>
</div>

