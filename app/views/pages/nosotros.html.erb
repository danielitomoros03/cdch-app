<!-- ABOUT - LANDING PAGE -->
<%= render "layouts/top_bar" %>
<%= render "layouts/header" %>

<!-- Page Header -->
<div class="page-header">
  <div class="container">
    <h1 class="page-title">Nosotros</h1>
    <p class="page-subtitle">
      Conoce nuestra historia, misión y compromiso con la excelencia académica
    </p>
  </div>
</div>

<!-- Historia Section -->
<section class="section">
  <div class="container">
    <div class="row align-items-center g-5">
      <div class="col-lg-6">
        <h2 class="section-title">Nuestra Historia</h2>
        <p class="text-gray mb-4">
          El Consejo de Desarrollo Científico y Humanístico (CDCH) de la Universidad Central de Venezuela 
          fue creado en 1958 con el propósito de promover, coordinar y fomentar la investigación científica 
          y humanística en nuestra institución.
        </p>
        <p class="text-gray mb-4">
          Durante más de 60 años, hemos sido el principal ente financiador de proyectos de investigación 
          en la UCV, apoyando a miles de investigadores y contribuyendo significativamente al desarrollo 
          científico y tecnológico del país.
        </p>
        <p class="text-gray">
          Nuestro compromiso es fortalecer la investigación de calidad, fomentar la publicación científica 
          y promover la formación de nuevos investigadores en todas las áreas del conocimiento.
        </p>
      </div>
      <div class="col-lg-6">
        <div class="about-image-placeholder" style="height: 400px; background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 100%); border-radius: 1rem;"></div>
      </div>
    </div>
  </div>
</section>

<!-- Misión y Visión -->
<section class="section section-light">
  <div class="container">
    <div class="row g-4">
      <div class="col-md-6">
        <div class="mission-card">
          <div class="mission-icon">
            <i class="fas fa-bullseye"></i>
          </div>
          <h3 class="mission-title">Misión</h3>
          <p class="mission-text">
            Promover, coordinar y financiar la investigación científica y humanística en la Universidad 
            Central de Venezuela, contribuyendo al desarrollo del conocimiento y la formación de 
            investigadores de excelencia.
          </p>
        </div>
      </div>
      <div class="col-md-6">
        <div class="mission-card">
          <div class="mission-icon">
            <i class="fas fa-eye"></i>
          </div>
          <h3 class="mission-title">Visión</h3>
          <p class="mission-text">
            Ser reconocidos como el principal referente en el fomento y desarrollo de la investigación 
            científica y humanística en Venezuela, consolidando a la UCV como centro de excelencia 
            académica en América Latina.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Valores -->
<section class="section">
  <div class="container">
    <div class="text-center mb-5">
      <h2 class="section-title">Nuestros Valores</h2>
      <p class="text-gray">Principios que guían nuestro trabajo diario</p>
    </div>
    <div class="row g-4">
      <div class="col-md-3 col-sm-6">
        <div class="value-card">
          <i class="fas fa-graduation-cap"></i>
          <h4>Excelencia</h4>
        </div>
      </div>
      <div class="col-md-3 col-sm-6">
        <div class="value-card">
          <i class="fas fa-handshake"></i>
          <h4>Integridad</h4>
        </div>
      </div>
      <div class="col-md-3 col-sm-6">
        <div class="value-card">
          <i class="fas fa-users"></i>
          <h4>Colaboración</h4>
        </div>
      </div>
      <div class="col-md-3 col-sm-6">
        <div class="value-card">
          <i class="fas fa-lightbulb"></i>
          <h4>Innovación</h4>
        </div>
      </div>
    </div>
  </div>
</section>


<%= render "layouts/counter" %>
<%= render "layouts/CTA_section" %>
<%= render "layouts/footer" %>