<!-- PUBLICACION DETALLE - LANDING PAGE -->
<%= render "layouts/header" %>

<!-- Page Header -->
<div class="page-header">
  <div class="container">
    <h1 class="page-title"><%= @publication.title %></h1>
    <p class="page-subtitle">
      <%= @publication.author_name %>
      <% if @publication.date_publication.present? %>
        | <%= @publication.date_publication.strftime("%d/%m/%Y") %>
      <% end %>
    </p>
  </div>
</div>

<section class="section">
  <div class="container">
    <div class="publication-detail-card">
      <div class="row g-4">
        <div class="col-lg-4">
          <div class="publication-detail-cover">
            <% if @publication.portrait.attached? %>
              <%= image_tag @publication.portrait, alt: "Portada de #{@publication.title}", class: "img-fluid rounded-3 w-100" %>
            <% else %>
              <div class="publication-detail-cover-fallback rounded-3">
                <i class="fas fa-book-open fa-2x" aria-hidden="true"></i>
              </div>
            <% end %>
          </div>

          <div class="d-flex flex-wrap gap-2 mt-3">
            <span class="badge bg-primary"><%= @publication.kind %></span>
            <% if @publication.date_publication.present? %>
              <span class="badge bg-light text-dark"><%= @publication.date_publication.strftime("%d/%m/%Y") %></span>
            <% end %>
          </div>
        </div>

        <div class="col-lg-8">
          <h2 class="h3 mb-2"><%= @publication.title %></h2>
          <p class="text-muted mb-3">Autor(a): <%= @publication.author_name %></p>

          <% if @publication.description.present? %>
            <div class="publication-detail-description">
              <%= simple_format(@publication.description) %>
            </div>
          <% end %>

          <div class="d-flex flex-wrap gap-2 mt-3">
            <% if @publication.external_url.present? %>
              <%= link_to @publication.external_url, class: "btn btn-primary", target: "_blank", rel: "noopener noreferrer" do %>
                <i class="fas fa-external-link-alt"></i> Ver libro completo
              <% end %>
            <% end %>

            <% if @publication.publication_field.attached? %>
              <%= link_to url_for(@publication.publication_field), class: "btn btn-outline-primary", target: "_blank", rel: "noopener noreferrer" do %>
                <i class="fas fa-book"></i> Abrir archivo adjunto
              <% end %>
            <% end %>
          </div>
        </div>
      </div>

      <% if @publication.publication_field.attached? %>
        <div class="publication-detail-viewer mt-4">
          <h3 class="h5 mb-3">Vista de la publicacion</h3>
          <% content_type = @publication.publication_field.blob.content_type %>

          <% if content_type == "application/pdf" %>
            <iframe
              src="<%= url_for(@publication.publication_field) %>"
              class="publication-detail-frame"
              title="Vista previa de #{@publication.title}">
            </iframe>
          <% elsif content_type.to_s.start_with?("image/") %>
            <%= image_tag @publication.publication_field, alt: "Archivo de #{@publication.title}", class: "img-fluid rounded-3 border" %>
          <% else %>
            <div class="alert alert-info mb-0" role="alert">
              El tipo de archivo no permite vista previa integrada.
            </div>
          <% end %>
        </div>
      <% end %>

      <div class="mt-4">
        <%= link_to publicaciones_path, class: "btn btn-outline-secondary" do %>
          <i class="fas fa-arrow-left"></i> Volver a Publicaciones
        <% end %>
      </div>
    </div>
  </div>
</section>

<%= render "layouts/CTA_section" %>
<%= render "layouts/footer" %>
