<!-- SUBDIRECTION - LANDING PAGE -->
<%= render "layouts/header" %>

<!-- Page Header -->
<!-- -->
<div class="page-header">
  <div class="container">
    <h1 class="page-title">Subdirección del CDCH<h1>
    <p class="page-subtitle">

    </p>
  </div>
</div>

<!-- Subdirection Description Section -->
<section class="section">
  <div class="container">
    <div class="row align-items-center g-5">
      <div class="col-lg-6">
        <h2 class="section-title mb-2">Descripción General de la Subdirección</h2>
        <%= @subdirection.description %>
      </div>
      <div class="col-lg-6 mt-3">
        <%= image_tag "Logo-CDCH-Vitral.png", class: "about-image-placeholder rounded", alt: "Logo de la Dirección CDCH" %>
      </div>
    </div>
  </div>
</section>

<!-- Direction Members Section -->
<section class="updates-section">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">Integrantes de la Subdirección</h2>
    </div>

    <div class="row g-4">
      <!-- Member Card 1 - Only Director -->
      <div class="col-md-6 col-lg-3">
        <article class="update-card">
          <div class="update-image update-image-blue">
            <% if @subdirection.send_subdirector.photoUser.attached? %>
              <%= image_tag @subdirection.send_subdirector.photoUser %>
            <% else %>
              <%= image_tag "Logo-CDCH-Vitral.png" %>
            <% end %>
          </div>
          <div class="update-content">
            <div class="update-date">Subdirector(a)</div>
            <h3 class="update-title"><%= @subdirection.send_subdirector.full_name %></h3>
            <!-- <p class="update-excerpt"></p> -->
          </div>
        </article>
      </div>

      <!-- Members Cards -->
      <% @other_users.each do |u| %>
        <div class="col-md-6 col-lg-3">
          <article class="update-card">
            <div class="update-image update-image-blue"></div>
            <div class="update-content">
              <div class="update-date"><%= u.job_title.name  %></div>
              <h3 class="update-title"><%= u.full_name %></h3>
              <!-- <p class="update-excerpt"></p> -->
            </div>
          </article>
        </div>
      <% end %>
    </div>
  </div>
</section>

<%#= render "layouts/counter" %>
<%= render "layouts/CTA_section" %>
<%= render "layouts/footer" %>